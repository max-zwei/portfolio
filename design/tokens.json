{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "W3C DTCG-shaped token export. This is the exchange format between Figma Variables and src/styles/tokens.css. Collection names here map 1:1 to Figma Variable collections; token paths map to Figma variable names (e.g. color/lemon/500 -> `color/lemon/500`). One tier only — there is no role/semantic layer, by decision. Keep this file and src/styles/tokens.css in step — the CSS is what ships, this is what Figma reads.",
  "color": {
    "$type": "color",
    "lemon": {
      "100": {
        "$value": "#faf9c8"
      },
      "200": {
        "$value": "#fdfab3"
      },
      "300": {
        "$value": "#faf587"
      },
      "400": {
        "$value": "#fdf56b"
      },
      "500": {
        "$value": "#f0e511"
      }
    },
    "pickled": {
      "100": {
        "$value": "#fee8e9"
      },
      "200": {
        "$value": "#fdc5c8"
      },
      "300": {
        "$value": "#ff99a2"
      },
      "400": {
        "$value": "#ee687a"
      },
      "500": {
        "$value": "#d73457"
      }
    },
    "herbs": {
      "100": {
        "$value": "#d2e5d0"
      },
      "200": {
        "$value": "#a0ce9c"
      },
      "300": {
        "$value": "#69b764"
      },
      "400": {
        "$value": "#41993d"
      },
      "500": {
        "$value": "#1a8d1a"
      },
      "600": {
        "$value": "#006c00"
      }
    },
    "tomato": {
      "100": {
        "$value": "#f2d6d0"
      },
      "200": {
        "$value": "#eba99b"
      },
      "300": {
        "$value": "#e57663"
      },
      "400": {
        "$value": "#ca4f3d"
      },
      "500": {
        "$value": "#c22e1c"
      },
      "600": {
        "$value": "#9b0a00"
      }
    },
    "neutral": {
      "$description": "The ends are named, not numbered — neither is a pure white or black.",
      "white": {
        "$value": "#fdfcf8"
      },
      "100": {
        "$value": "#efeeea"
      },
      "200": {
        "$value": "#dfdeda"
      },
      "300": {
        "$value": "#cfceca"
      },
      "400": {
        "$value": "#bfbeba"
      },
      "500": {
        "$value": "#9f9e9b"
      },
      "600": {
        "$value": "#81807d"
      },
      "700": {
        "$value": "#484844"
      },
      "800": {
        "$value": "#171613"
      },
      "black": {
        "$value": "#040302"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$description": "JetBrains Mono is vendored (note the family name: the variable build registers as 'JetBrains Mono Variable'). Satoshi and Erode are the designed faces but are not vendored — those two stacks fall through to system faces until the licensed files land.",
      "sans": {
        "$value": [
          "Satoshi Variable",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      },
      "serif": {
        "$value": ["Erode Variable", "ui-serif", "Georgia", "serif"]
      },
      "mono": {
        "$value": [
          "JetBrains Mono Variable",
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Max value of the fluid clamp() in the CSS. Figma is a fixed-size medium, so it carries the desktop end of the scale. xs/sm/base are fixed in CSS rather than fluid.",
      "xs": {
        "$value": "8px"
      },
      "sm": {
        "$value": "12px"
      },
      "base": {
        "$value": "16px"
      },
      "lg": {
        "$value": "24px"
      },
      "xl": {
        "$value": "32px"
      },
      "2xl": {
        "$value": "48px"
      },
      "3xl": {
        "$value": "72px"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "lineHeight": {
      "$type": "number",
      "none": {
        "$value": 1,
        "$description": "Set solid. The Figma heading styles H1–H5 all bind it."
      },
      "tight": {
        "$value": 1.1
      },
      "snug": {
        "$value": 1.3
      },
      "relaxed": {
        "$value": 1.4
      },
      "normal": {
        "$value": 1.6
      },
      "loose": {
        "$value": 2,
        "$description": "Airy enough for wide-tracked mono. The chat bubbles on /home."
      }
    },
    "letterSpacing": {
      "$type": "dimension",
      "$description": "Figma applies FLOAT letter-spacing in px and cannot hold an em value. These are the em equivalents that ship.",
      "tight": {
        "$value": "-0.02em"
      },
      "normal": {
        "$value": "0"
      },
      "wide": {
        "$value": "0.08em"
      },
      "extra-wide": {
        "$value": "0.19em"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base grid.",
    "3xs": {
      "$value": "4px"
    },
    "2xs": {
      "$value": "8px"
    },
    "xs": {
      "$value": "12px"
    },
    "sm": {
      "$value": "16px"
    },
    "md": {
      "$value": "24px"
    },
    "lg": {
      "$value": "40px"
    },
    "xl": {
      "$value": "64px"
    },
    "2xl": {
      "$value": "96px"
    },
    "3xl": {
      "$value": "144px"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$value": "8px"
    },
    "lg": {
      "$value": "16px"
    },
    "full": {
      "$value": "9999px"
    }
  },
  "size": {
    "$type": "dimension",
    "$description": "Layout widths read off the /home chat frames. Not a scale \u2014 each names the thing it sizes.",
    "chat-column": {
      "$value": "866px",
      "$description": "The message column."
    },
    "chat-bubble": {
      "$value": "531px",
      "$description": "A message bubble from Max."
    },
    "chat-choice": {
      "$value": "400px",
      "$description": "Maximum width of a reply chip before its text wraps."
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms"
      },
      "base": {
        "$value": "240ms"
      },
      "slow": {
        "$value": "480ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [0.2, 0, 0, 1]
      },
      "entrance": {
        "$value": [0, 0, 0, 1]
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Figma variables have no shadow type, so these are STRING variables paired with matching `Elevation / sm|md|lg` effect styles. Change one, change both.",
    "sm": {
      "$value": "0 1px 2px rgb(20 17 15 / 0.06)"
    },
    "md": {
      "$value": "0 4px 16px rgb(20 17 15 / 0.08)"
    },
    "lg": {
      "$value": "0 12px 40px rgb(20 17 15 / 0.12)"
    }
  }
}
