{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "W3C DTCG-shaped token export, generated from DESIGN.md by scripts/build-tokens.mjs — do not hand-edit. This is the exchange format between Figma Variables and the design system. Collection names here map 1:1 to Figma Variable collections; token paths map to Figma variable names (e.g. color/lemon/500 -> `color/lemon/500`). One tier only — there is no role/semantic layer, by decision. src/styles/tokens.css is generated from the same source and is what ships.",
  "color": {
    "$type": "color",
    "lemon": {
      "100": {
        "$value": "#faf9c8"
      },
      "200": {
        "$value": "#fdfab3"
      },
      "300": {
        "$value": "#faf587"
      },
      "400": {
        "$value": "#fdf56b"
      },
      "500": {
        "$value": "#f0e511"
      }
    },
    "pickled": {
      "100": {
        "$value": "#fee8e9"
      },
      "200": {
        "$value": "#fdc5c8"
      },
      "300": {
        "$value": "#ff99a2"
      },
      "400": {
        "$value": "#ee687a"
      },
      "500": {
        "$value": "#d73457"
      }
    },
    "herbs": {
      "100": {
        "$value": "#d2e5d0"
      },
      "200": {
        "$value": "#a0ce9c"
      },
      "300": {
        "$value": "#69b764"
      },
      "400": {
        "$value": "#41993d"
      },
      "500": {
        "$value": "#1a8d1a"
      },
      "600": {
        "$value": "#006c00"
      }
    },
    "tomato": {
      "100": {
        "$value": "#f2d6d0"
      },
      "200": {
        "$value": "#eba99b"
      },
      "300": {
        "$value": "#e57663"
      },
      "400": {
        "$value": "#ca4f3d"
      },
      "500": {
        "$value": "#c22e1c"
      },
      "600": {
        "$value": "#9b0a00"
      }
    },
    "neutral": {
      "$description": "The ends are named, not numbered — neither is a pure white or black.",
      "white": {
        "$value": "#fdfcf8"
      },
      "100": {
        "$value": "#efeeea"
      },
      "200": {
        "$value": "#dfdeda"
      },
      "300": {
        "$value": "#cfceca"
      },
      "400": {
        "$value": "#bfbeba"
      },
      "500": {
        "$value": "#9f9e9b"
      },
      "600": {
        "$value": "#81807d"
      },
      "700": {
        "$value": "#484844"
      },
      "800": {
        "$value": "#171613"
      },
      "black": {
        "$value": "#040302"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$description": "Satoshi and Erode are self-hosted in public/fonts/ and declared in src/styles/fonts.css; JetBrains Mono comes from @fontsource-variable/jetbrains-mono. The family names carry the 'Variable' suffix the woff2 files register — drop it and every visitor silently gets a system face, with no error anywhere.",
      "sans": {
        "$value": ["Satoshi Variable", "system-ui", "sans-serif"]
      },
      "serif": {
        "$value": ["Erode Variable", "serif"]
      },
      "mono": {
        "$value": ["JetBrains Mono Variable", "monospace"]
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Max value of the fluid clamp() in the CSS. Figma is a fixed-size medium, so it carries the desktop end of the scale. xs/sm/base are fixed in CSS rather than fluid.",
      "xs": {
        "$value": "8px"
      },
      "sm": {
        "$value": "12px"
      },
      "base": {
        "$value": "16px"
      },
      "lg": {
        "$value": "24px"
      },
      "xl": {
        "$value": "32px"
      },
      "2xl": {
        "$value": "48px"
      },
      "3xl": {
        "$value": "72px"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "lineHeight": {
      "$type": "number",
      "none": {
        "$value": 1,
        "$description": "Set solid. The Figma heading styles H1–H5 all bind it."
      },
      "tight": {
        "$value": 1.1
      },
      "snug": {
        "$value": 1.3
      },
      "relaxed": {
        "$value": 1.4
      },
      "normal": {
        "$value": 1.6
      },
      "loose": {
        "$value": 2,
        "$description": "Airy enough for wide-tracked mono. The chat bubbles on /home."
      }
    },
    "letterSpacing": {
      "$type": "dimension",
      "$description": "Figma applies FLOAT letter-spacing in px and cannot hold an em value. These are the em equivalents that ship.",
      "tight": {
        "$value": "-0.02em"
      },
      "normal": {
        "$value": "0"
      },
      "wide": {
        "$value": "0.08em"
      },
      "extra-wide": {
        "$value": "0.19em"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base grid.",
    "3xs": {
      "$value": "4px"
    },
    "2xs": {
      "$value": "8px"
    },
    "xs": {
      "$value": "12px"
    },
    "sm": {
      "$value": "16px"
    },
    "md": {
      "$value": "24px"
    },
    "lg": {
      "$value": "40px"
    },
    "xl": {
      "$value": "64px"
    },
    "2xl": {
      "$value": "96px"
    },
    "3xl": {
      "$value": "144px"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$value": "8px"
    },
    "lg": {
      "$value": "16px"
    },
    "full": {
      "$value": "9999px"
    }
  },
  "size": {
    "$type": "dimension",
    "$description": "Widths read off the /home chat frames. chat-choice is the only one the site ships as a token: the message column and bubble are computed as 8- and 5-column spans of the page grid. size/chat-column and size/chat-bubble remain in the Figma Size collection pending deletion (design/components.json outstanding.variableWrites).",
    "chat-choice": {
      "$value": "400px",
      "$description": "Maximum width of a reply chip before its text wraps."
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms"
      },
      "base": {
        "$value": "240ms"
      },
      "slow": {
        "$value": "480ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [0.2, 0, 0, 1]
      },
      "entrance": {
        "$value": [0, 0, 0, 1]
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Figma variables have no shadow type, so these are STRING variables paired with matching `Elevation / sm|md|lg` effect styles. Change one, change both.",
    "sm": {
      "$value": "0 1px 2px rgb(20 17 15 / 0.06)"
    },
    "md": {
      "$value": "0 4px 16px rgb(20 17 15 / 0.08)"
    },
    "md-lemon": {
      "$value": "0 4px 16px #f0e511"
    },
    "lg": {
      "$value": "0 12px 40px rgb(20 17 15 / 0.12)"
    }
  },
  "text": {
    "$description": "The twelve named Figma text styles. Each leg holds a CSS custom property name — text styles are Figma *styles*, not variables, so there is nothing here for a variable importer to read.",
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "--font-serif",
        "fontSize": "--font-size-3xl",
        "fontWeight": "--font-weight-semibold",
        "lineHeight": "--line-height-none",
        "letterSpacing": "--letter-spacing-normal"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "--font-serif",
        "fontSize": "--font-size-2xl",
        "fontWeight": "--font-weight-semibold",
        "lineHeight": "--line-height-none",
        "letterSpacing": "--letter-spacing-normal"
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "--font-serif",
        "fontSize": "--font-size-xl",
        "fontWeight": "--font-weight-semibold",
        "lineHeight": "--line-height-none",
        "letterSpacing": "--letter-spacing-normal"
      }
    },
    "h4": {
      "$type": "typography",
      "$value": {
        "fontFamily": "--font-serif",
        "fontSize": "--font-size-lg",
        "fontWeight": "--font-weight-semibold",
        "lineHeight": "--line-height-none",
        "letterSpacing": "--letter-spacing-normal"
      }
    },
    "h5": {
      "$type": "typography",
      "$value": {
        "fontFamily": "--font-serif",
        "fontSize": "--font-size-base",
        "fontWeight": "--font-weight-semibold",
        "lineHeight": "--line-height-none",
        "letterSpacing": "--letter-spacing-normal"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "--font-sans",
        "fontSize": "--font-size-base",
        "fontWeight": "--font-weight-regular",
        "lineHeight": "--line-height-normal",
        "letterSpacing": "--letter-spacing-normal"
      }
    },
    "body-small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "--font-sans",
        "fontSize": "--font-size-sm",
        "fontWeight": "--font-weight-regular",
        "lineHeight": "--line-height-relaxed",
        "letterSpacing": "--letter-spacing-normal"
      }
    },
    "body-large": {
      "$type": "typography",
      "$value": {
        "fontFamily": "--font-sans",
        "fontSize": "--font-size-lg",
        "fontWeight": "--font-weight-regular",
        "lineHeight": "--line-height-normal",
        "letterSpacing": "--letter-spacing-normal"
      }
    },
    "body-bold": {
      "$type": "typography",
      "$value": {
        "fontFamily": "--font-sans",
        "fontSize": "--font-size-base",
        "fontWeight": "--font-weight-bold",
        "lineHeight": "--line-height-normal",
        "letterSpacing": "--letter-spacing-normal"
      }
    },
    "mono": {
      "$type": "typography",
      "$value": {
        "fontFamily": "--font-mono",
        "fontSize": "--font-size-base",
        "fontWeight": "--font-weight-regular",
        "lineHeight": "--line-height-loose",
        "letterSpacing": "--letter-spacing-extra-wide"
      }
    },
    "mono-small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "--font-mono",
        "fontSize": "--font-size-sm",
        "fontWeight": "--font-weight-regular",
        "lineHeight": "--line-height-loose",
        "letterSpacing": "--letter-spacing-extra-wide"
      }
    },
    "captions": {
      "$type": "typography",
      "$value": {
        "fontFamily": "--font-sans",
        "fontSize": "--font-size-xs",
        "fontWeight": "--font-weight-regular",
        "lineHeight": "--line-height-relaxed",
        "letterSpacing": "--letter-spacing-normal"
      }
    }
  }
}
