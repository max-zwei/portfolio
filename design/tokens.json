{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "W3C DTCG-shaped token export. This is the exchange format between Figma Variables and src/styles/tokens.css. Collection names here map 1:1 to Figma Variable collections; token paths map to Figma variable names (e.g. color/yuzu/500 -> `color/yuzu/500`). Keep this file and src/styles/tokens.css in step — the CSS is what ships, this is what Figma reads.",
  "color": {
    "$type": "color",
    "yuzu": {
      "100": { "$value": "#fdf6dd" },
      "200": { "$value": "#f9e9a8" },
      "300": { "$value": "#f4d968" },
      "400": { "$value": "#edc734" },
      "500": { "$value": "#e0b21a" },
      "600": { "$value": "#b78d10" }
    },
    "rote-beete": {
      "100": { "$value": "#f7e8ee" },
      "200": { "$value": "#e7bccd" },
      "300": { "$value": "#cd82a3" },
      "400": { "$value": "#a44a75" },
      "500": { "$value": "#7d2b52" },
      "600": { "$value": "#551a37" }
    },
    "tomaten": {
      "100": { "$value": "#fdeae4" },
      "200": { "$value": "#f9c2b1" },
      "300": { "$value": "#f29075" },
      "400": { "$value": "#e5624a" },
      "500": { "$value": "#cf4429" },
      "600": { "$value": "#a3311c" }
    },
    "lieblingsort": {
      "100": { "$value": "#e9f0e8" },
      "200": { "$value": "#c3d8c0" },
      "300": { "$value": "#93b78f" },
      "400": { "$value": "#5f8f5c" },
      "500": { "$value": "#3f6d3f" },
      "600": { "$value": "#2b4b2c" }
    },
    "neutral": {
      "000": { "$value": "#ffffff" },
      "050": { "$value": "#faf8f4" },
      "100": { "$value": "#f1eee7" },
      "200": { "$value": "#e2ddd3" },
      "300": { "$value": "#c5bdae" },
      "400": { "$value": "#9a9084" },
      "500": { "$value": "#6f665c" },
      "600": { "$value": "#4d463f" },
      "700": { "$value": "#332e29" },
      "800": { "$value": "#211d1a" },
      "900": { "$value": "#14110f" }
    }
  },
  "semantic": {
    "$type": "color",
    "$description": "Role-based aliases. Single set — no light/dark modes, by decision. Components consume only these.",
    "surface": {
      "default": { "$value": "{color.neutral.050}" },
      "raised": { "$value": "{color.neutral.000}" },
      "sunken": { "$value": "{color.neutral.100}" },
      "inverse": { "$value": "{color.neutral.900}" },
      "accent": { "$value": "{color.yuzu.300}" }
    },
    "text": {
      "primary": { "$value": "{color.neutral.900}" },
      "secondary": { "$value": "{color.neutral.500}" },
      "inverse": { "$value": "{color.neutral.050}" },
      "accent": { "$value": "{color.rote-beete.500}" },
      "on-accent": { "$value": "{color.neutral.900}" }
    },
    "border": {
      "subtle": { "$value": "{color.neutral.200}" },
      "strong": { "$value": "{color.neutral.300}" },
      "focus": { "$value": "{color.rote-beete.400}" }
    },
    "brand": {
      "primary": { "$value": "{color.yuzu.400}" },
      "secondary": { "$value": "{color.rote-beete.500}" },
      "highlight": { "$value": "{color.tomaten.400}" },
      "calm": { "$value": "{color.lieblingsort.400}" }
    },
    "status": {
      "in-progress": { "$value": "{color.tomaten.400}" },
      "completed": { "$value": "{color.lieblingsort.400}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] },
      "serif": { "$value": ["Instrument Serif", "ui-serif", "Georgia", "serif"] },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "JetBrains Mono", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "$description": "Max value of the fluid clamp() in the CSS. Figma is a fixed-size medium, so it carries the desktop end of the scale.",
      "xs": { "$value": "12.8px" },
      "sm": { "$value": "15.2px" },
      "base": { "$value": "18px" },
      "lg": { "$value": "23.2px" },
      "xl": { "$value": "32px" },
      "2xl": { "$value": "48px" },
      "3xl": { "$value": "72px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.1 },
      "snug": { "$value": 1.3 },
      "normal": { "$value": 1.6 }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base grid.",
    "3xs": { "$value": "4px" },
    "2xs": { "$value": "8px" },
    "xs": { "$value": "12px" },
    "sm": { "$value": "16px" },
    "md": { "$value": "24px" },
    "lg": { "$value": "40px" },
    "xl": { "$value": "64px" },
    "2xl": { "$value": "96px" },
    "3xl": { "$value": "144px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "16px" },
    "full": { "$value": "9999px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "240ms" },
      "slow": { "$value": "480ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "entrance": { "$value": [0, 0, 0, 1] }
    }
  }
}
