{
  "name": "portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "cv": "npm run build && node scripts/render-cv.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:html": "html-validate \"dist/**/*.html\"",
