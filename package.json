{
  "name": "portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev --base /",
    "build": "astro build",
    "postbuild": "node scripts/render-pdf.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "pdf": "npm run build",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:html": "html-validate \"dist/**/*.html\"",
    "verify": "npm run tokens:check && npm run check && npm run build && npm run lint:html && npm run format:check"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "html-validate": "^11.16.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.3",
    "yaml": "^2.9.1"
  }
}
