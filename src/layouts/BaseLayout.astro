---
import '../styles/global.css';
import tokens from '../../design/tokens.json';
import { SITE, withBase } from '../config/site';

// The browser chrome colour has to be a literal, so read it from the token
// file rather than retyping the hex.
const themeColor = tokens.color.neutral['100'].$value;
const lemonShadowLayers = tokens.shadow['md-lemon'].$value
  .split(',')
  .map((layer) => {
    const [x, y, blur] = layer.trim().split(/\s+/).map(Number.parseFloat);
    return { x, y, blur };
  });
// All md-lemon layers share the same blur; only their offsets differ.
const lemonShadowSigma = lemonShadowLayers[0].blur / 2;

interface Props {
  title?: string;
  description?: string;
  /** Path to an OG image inside public/, e.g. "/og/home.png" */
  image?: string;
}

const {
  title,
  description = SITE.description,
  image = SITE.defaultImage,
} = Astro.props;

const pageTitle = title
  ? `${title} — ${SITE.name}`
  : `${SITE.name} — ${SITE.role}`;
const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? 'http://localhost:4321',
);
const ogImage = new URL(withBase(image), Astro.site ?? 'http://localhost:4321');
---

<!doctype html>
<html
  lang={SITE.lang}
  style={`--cursor-url: url('${withBase('/cursor-pointer.svg')}')`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter falls back to the og:* tags above; only the card type is extra. -->
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content={themeColor} />

    <slot name="head" />
  </head>
  <body>
    <svg
      width="0"
      height="0"
      aria-hidden="true"
      focusable="false"
      style="position: absolute"
    >
      <filter
        id="md-lemon-alpha"
        x="-400%"
        y="-400%"
        width="900%"
        height="900%"
        color-interpolation-filters="sRGB"
      >
        <feGaussianBlur
          in="SourceAlpha"
          stdDeviation={lemonShadowSigma}
          result="blurred-alpha"></feGaussianBlur>
        <feFlood flood-color="var(--color-lemon-500)" result="lemon-color"
        ></feFlood>
        {
          lemonShadowLayers.map(({ x, y }, index) => (
            <>
              <feOffset
                in="blurred-alpha"
                dx={x}
                dy={y}
                result={`offset-alpha-${index}`}
              />
              <feComposite
                in="lemon-color"
                in2={`offset-alpha-${index}`}
                operator="in"
                result={`lemon-glow-${index}`}
              />
            </>
          ))
        }
        <feMerge>
          {
            lemonShadowLayers.map((_, index) => (
              <feMergeNode in={`lemon-glow-${index}`} />
            ))
          }
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </svg>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../lib/cursor-trail';
    </script>
  </body>
</html>
