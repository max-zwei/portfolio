---
import { getCollection } from 'astro:content';
import readmeSource from '../../README.md?raw';
import designSource from '../../DESIGN.md?raw';
import Icon from '../components/Icon.astro';
import NavBar from '../components/NavBar.astro';
import ReleaseNote from '../components/ReleaseNote.astro';
import { PORTFOLIO_SOURCE, withBase } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { renderRepositoryDocument } from '../lib/repository-documents';
import { renderFrontmatterMarkdown } from '../lib/markdown';

const [readmeHtml, designHtml] = await Promise.all([
  renderRepositoryDocument(readmeSource, 'readme', PORTFOLIO_SOURCE.repository),
  renderRepositoryDocument(designSource, 'design', PORTFOLIO_SOURCE.repository),
]);

const releases = (await getCollection('releaseNotes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const releaseBlocks = await Promise.all(
  releases.map(async (entry) => ({
    entry,
    userExperience: entry.data.userExperience
      ? await renderFrontmatterMarkdown(entry.data.userExperience, 2)
      : undefined,
    userInterface: entry.data.userInterface
      ? await renderFrontmatterMarkdown(entry.data.userInterface, 2)
      : undefined,
    tech: entry.data.tech
      ? await renderFrontmatterMarkdown(entry.data.tech, 2)
      : undefined,
  })),
);

const readmeUrl = `${PORTFOLIO_SOURCE.repository}/blob/main/README.md`;
const designUrl = `${PORTFOLIO_SOURCE.repository}/blob/main/DESIGN.md`;
const figmaEmbedUrl = new URL(
  PORTFOLIO_SOURCE.figma.replace('www.figma.com', 'embed.figma.com'),
);
figmaEmbedUrl.searchParams.set('node-id', '114-15');
figmaEmbedUrl.searchParams.set('embed-host', 'max-pinkert-portfolio');
---

<BaseLayout title="How I built this">
  <main id="main" class="container bts">
    <header class="bts__hero">
      <h1 class="bts__title">How I <br />built this</h1>
      <p>
        Welcome to the meta case study of how I built this website. For this
        project I can actually just share the raw data. Browse through my Figma
        file and GitHub repo, I tried to include explanations and information,
      </p>
    </header>

    <div class="bts__cards">
      <section class="bts-card bts-card--design" aria-labelledby="h-design">
        <div class="bts-card__intro">
          <header class="bts-card__header">
            <h2 id="h-design">Design</h2>
            <a
              class="bts-card__source bts-card__source--figma"
              href={PORTFOLIO_SOURCE.figma}
              aria-label="Figma file"
            >
              <Icon icon="figma" color="black" alt="" />
            </a>
          </header>
          <p>
            My one and only Figma. Since starting my rookie journey as a
            about-to-be designer, Figma has always been my place to play around,
            no matter which use case. Affinity also started playing a role a
            bit, especially when it comes to print design. But Figma is my home
            turf and I enjoy working in it. Here the file where all the website
            came to life. I tried to keep a bit more artifacts than usually,
            take a look:
          </p>
        </div>
        <iframe
          class="bts-card__embed"
          src={figmaEmbedUrl.href}
          title="Portfolio Figma file — Organisms"
          loading="lazy"
          allowfullscreen
          tabindex="0"></iframe>
      </section>

      <section class="bts-card bts-card--code" aria-labelledby="h-code">
        <div class="bts-card__intro">
          <header class="bts-card__header">
            <h2 id="h-code">code</h2>
            <a
              class="bts-card__source bts-card__source--github"
              href={PORTFOLIO_SOURCE.repository}
              aria-label="GitHub repository"
            >
              <Icon icon="github" color="black" alt="" />
            </a>
          </header>
          <p>
            This isn’t the first try at coding a website, my journey started
            with a blog in Jimdo, evolved to Webflow where we build the website
            for 2zero and ultimately went back to pure HTML/CSS. I still have to
            rely on coding agents to do the heavy lifting but I at least can
            understand the generated code and structure which helps to question
            the output of LLMs and also to do changes on my own. Take a look:
          </p>
        </div>

        <div class="bts-doc">
          <section
            class="bts-doc__body"
            aria-labelledby="bts-readme-label"
            tabindex="0"
            set:html={readmeHtml}
          />
          <p class="bts-doc__label" id="bts-readme-label">
            <a href={readmeUrl}>/README.md</a>
          </p>
        </div>

        <div class="bts-doc">
          <section
            class="bts-doc__body"
            aria-labelledby="bts-design-label"
            tabindex="0"
            set:html={designHtml}
          />
          <p class="bts-doc__label" id="bts-design-label">
            <a href={designUrl}>/DESIGN.md</a>
          </p>
        </div>
      </section>
    </div>

    <section class="bts__credits" aria-labelledby="h-credits">
      <h2 class="bts__title" id="h-credits">Credits</h2>
      <div class="bts-credits__body">
        <p>
          I enjoy trying out different tools and playing around with them. And
          also as part of this portfolio website I took to several helpers and
          here is a small way to say thank you and at least credit your work so
          hopefully people read this and try them out themselves:
        </p>
        <ul class="bts-credits__list">
          <li>
            <span
              ><a href="https://www.fontshare.com/fonts/erode">Erode</a>,
              Typeface by Indian Type Foundry, via Fontshare</span
            >
          </li>
          <li>
            <span
              ><a href="https://www.fontshare.com/fonts/satoshi">Satoshi</a>,
              Typeface by Indian Type Foundry, via Fontshare</span
            >
          </li>
          <li>
            <span
              ><a href="https://oklch.com">OKLCH</a>, Color picker by Evil
              Martians</span
            >
          </li>
          <li><span>Bauhaus, Figma Weave</span></li>
          <li>
            <span
              ><a
                href="https://www.figma.com/community/plugin/733590967040604714"
                >Brandfetch</a
              >, Figma Plugin</span
            >
          </li>
          <li>
            <span
              ><a
                href="https://www.figma.com/community/plugin/1181873200384736932"
                >WebP Exporter</a
              >, Figma Plugin</span
            >
          </li>
          <li>
            <span
              >Rename Layers, Figma, I love structure, but renaming layers just
              takes too much time.</span
            >
          </li>
          <li>
            <span
              >And yes, I did use LLMs, Coding Agents, AI, however you want to
              call it. <a href={withBase('/ai')}>Find out more!</a></span
            >
          </li>
        </ul>
      </div>
    </section>

    <section class="bts__releases" aria-labelledby="h-releases">
      <header class="bts-releases__header">
        <h2 class="bts__title" id="h-releases">Re<br />lease Notes</h2>
        <p>
          I have tried multiple approaches for my portfolio. To give you some
          idea of my iterations, I created this collection of release notes,
          clustered to user experience, user interface and tools.
        </p>
      </header>

      {
        releaseBlocks.length > 0 && (
          <ol class="bts-releases__list">
            {releaseBlocks.map((block) => (
              <li>
                <ReleaseNote
                  date={block.entry.data.date}
                  description={block.entry.data.description}
                  fileHref={
                    block.entry.data.file &&
                    (/^https?:\/\//.test(block.entry.data.file)
                      ? block.entry.data.file
                      : withBase(block.entry.data.file))
                  }
                  level={3}
                >
                  {block.userExperience && (
                    <Fragment
                      slot="userExperience"
                      set:html={block.userExperience}
                    />
                  )}
                  {block.userInterface && (
                    <Fragment
                      slot="userInterface"
                      set:html={block.userInterface}
                    />
                  )}
                  {block.tech && (
                    <Fragment slot="tools" set:html={block.tech} />
                  )}
                </ReleaseNote>
              </li>
            ))}
          </ol>
        )
      }
    </section>
  </main>

  <NavBar label="Site" />
</BaseLayout>

<style>
  .bts {
    display: grid;
    gap: var(--space-3xl);
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .bts p,
  .bts-credits__list {
    color: var(--color-neutral-800);
  }

  /* Figma 103:1117: 310 / 643 columns and an unbound 135 gap. */
  .bts__hero,
  .bts-releases__header {
    display: grid;
    grid-template-columns: minmax(0, 310fr) minmax(0, 643fr);
    align-items: start;
    gap: 135px;
  }

  .bts__hero > p {
    max-inline-size: calc(4 * var(--grid-column) + 3 * var(--grid-gutter));
  }

  /* Typography/Title has no size or line-height variable in Figma. */
  .bts__title {
    font-size: 6.75rem;
    line-height: 1.2;
    letter-spacing: var(--letter-spacing-normal);
    text-transform: uppercase;
    text-wrap: wrap;
    overflow-wrap: anywhere;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  .bts__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .bts-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: start;
    gap: var(--space-md);
    padding: var(--space-lg) var(--space-md);
  }

  .bts-card--design {
    background-color: var(--color-tomato-100);
  }

  .bts-card--code {
    background-color: var(--color-herbs-100);
  }

  .bts-card__intro {
    display: grid;
    align-content: start;
    gap: var(--space-md);
    min-block-size: 278px;
    inline-size: 100%;
  }

  .bts-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .bts-card__header h2 {
    font-size: var(--font-size-xl);
    line-height: 1.2;
    letter-spacing: var(--letter-spacing-normal);
  }

  .bts-card--code h2 {
    font-family: var(--font-mono);
  }

  .bts-card--code .bts-card__intro > p,
  .bts-doc__label {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-loose);
    letter-spacing: var(--letter-spacing-extra-wide);
  }

  .bts-card__source {
    display: block;
    flex-shrink: 0;
  }

  .bts-card__source :global(.icon) {
    inline-size: 100%;
    block-size: var(--space-md);
  }

  /* Intrinsic marks at the frame's 24-high icon size. */
  .bts-card__source--figma {
    inline-size: var(--space-md);
  }

  .bts-card__source--github {
    inline-size: 24.665308px;
  }

  .bts-card__embed {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 484 / 317;
    border: 0;
  }

  .bts-doc {
    display: grid;
    width: 100%;
    gap: var(--space-2xs);
  }

  .bts-doc__body {
    width: 100%;
    min-height: 0;
    aspect-ratio: 484 / 317;
    padding: var(--space-sm);
    overflow: auto;
    background-color: var(--color-neutral-100);
    scrollbar-color: var(--color-lemon-100) transparent;
    scrollbar-width: thin;
  }

  .bts-doc__body::-webkit-scrollbar {
    width: var(--space-3xs);
  }

  .bts-doc__body::-webkit-scrollbar-track {
    margin-block: var(--space-sm);
  }

  .bts-doc__body::-webkit-scrollbar-thumb {
    min-height: var(--space-lg);
    background-color: var(--color-lemon-100);
  }

  .bts-doc__body :global(h3) {
    margin-top: 0;
  }

  .bts-doc__body :global(h4) {
    margin-top: var(--space-xl);
  }

  .bts-doc__body :global(h5) {
    margin-top: var(--space-lg);
  }

  .bts-doc__body :global(p),
  .bts-doc__body :global(ul),
  .bts-doc__body :global(ol) {
    margin-top: var(--space-sm);
  }

  .bts-doc__body :global(ul),
  .bts-doc__body :global(ol) {
    padding-left: var(--space-md);
  }

  .bts-doc__body :global(li + li) {
    margin-top: var(--space-2xs);
  }

  .bts-doc__body :global(strong) {
    font-weight: var(--font-weight-semibold);
  }

  .bts-doc__body :global(a) {
    text-decoration-color: var(--color-neutral-300);
  }

  .bts-doc__label a:hover,
  .bts-doc__body :global(a:hover),
  .bts-credits__list a:hover {
    font-weight: var(--font-weight-bold);
  }

  .bts-doc__body :global(.table-wrap) {
    margin-top: var(--space-lg);
    overflow-x: auto;
  }

  .bts-doc__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  .bts-doc__body :global(th),
  .bts-doc__body :global(td) {
    padding: var(--space-2xs) var(--space-sm);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-neutral-200);
  }

  .bts-doc__body :global(th) {
    color: var(--color-neutral-700);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .bts-doc__body :global(code),
  .bts-doc__body :global(pre) {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-loose);
    letter-spacing: var(--letter-spacing-extra-wide);
  }

  .bts-doc__body :global(pre) {
    margin-top: var(--space-sm);
    overflow-x: auto;
  }

  .bts__credits {
    display: grid;
    grid-template-columns: minmax(0, 643fr) minmax(0, 310fr);
    align-items: start;
    gap: 135px;
  }

  .bts__credits > h2 {
    grid-column: 2;
    grid-row: 1;
  }

  .bts-credits__body {
    display: grid;
    grid-column: 1;
    grid-row: 1;
    gap: var(--space-md);
  }

  .bts__releases {
    display: grid;
    gap: var(--space-2xl);
  }

  .bts-releases__list {
    display: grid;
    gap: var(--space-xl);
    padding: 0;
    list-style: none;
  }

  .bts-credits__list {
    display: grid;
    gap: var(--space-sm);
    padding: 0;
    list-style: none;
  }

  .bts-credits__list li {
    display: grid;
    grid-template-columns: var(--space-sm) minmax(0, 1fr);
    gap: var(--space-sm);
  }

  .bts-credits__list li::before {
    width: var(--space-sm);
    height: var(--space-sm);
    margin-block-start: calc((1lh - var(--space-sm)) / 2);
    content: '';
    background-color: var(--color-pickled-500);
    border-radius: var(--radius-full);
  }

  @media (max-width: 48rem) {
    .bts__hero,
    .bts__cards,
    .bts__credits,
    .bts-releases__header {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-md);
    }

    .bts__credits > h2,
    .bts-credits__body {
      grid-column: auto;
      grid-row: auto;
    }

    .bts-card__intro {
      min-block-size: 0;
    }
  }
</style>

<script>
  /*
   * Handoff (given in chat, 22 Sep 2026): the release note the visitor is
   * currently on renders active, every other one inactive. Exactly one note is
   * active, so the band is a 2px line at the middle of the viewport and the
   * last note to cross it stays active while the gap between two notes passes.
   * Nothing is dimmed without the script — the page ships every note active.
   */
  const notes = Array.from(
    document.querySelectorAll<HTMLElement>('[data-release-note]'),
  );

  if (notes.length > 0 && 'IntersectionObserver' in window) {
    let active: HTMLElement | undefined;

    const apply = () => {
      if (!active) return;
      for (const note of notes) {
        note.classList.toggle('release-note--active', note === active);
        note.classList.toggle('release-note--inactive', note !== active);
      }
    };

    // Percentage rootMargin resolves against root *width* (Intersection
    // Observer spec), not height, so the band is computed in pixels and
    // rebuilt whenever the viewport height changes — as /resume does.
    let observer: IntersectionObserver | undefined;
    const observeNotes = () => {
      observer?.disconnect();
      const inset = document.documentElement.clientHeight / 2 - 1;
      observer = new IntersectionObserver(
        (records) => {
          for (const record of records) {
            if (record.isIntersecting) active = record.target as HTMLElement;
          }
          apply();
        },
        { rootMargin: `-${inset}px 0px -${inset}px 0px` },
      );
      for (const note of notes) observer.observe(note);
    };

    observeNotes();
    window.addEventListener('resize', observeNotes);
  }
</script>
