---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import CvSection from '../../components/CvSection.astro';
import Icon from '../../components/Icon.astro';
import Logo from '../../components/Logo.astro';
import ToolBox from '../../components/ToolBox.astro';
import {
  SITE,
  CV_STUDY,
  CV_INTRO,
  CV_CONTACT,
  CV_PROFILES,
  CV_TOOLS,
  SOCIALS,
  withBase,
} from '../../config/site';
import portrait from '../../assets/max-pinkert-portrait.png';

// This page is the CV. Both PDFs are printed by scripts/render-pdf.mjs, run
// automatically after every `astro build` — so anything added here has to
// survive A4 as well as a browser window. See docs/resume.md.

/** Written by scripts/render-pdf.mjs. Kept in one place so page and script agree. */
const CV_PDF = withBase('/cv/max-pinkert-cv.pdf');

const entries = await getCollection('resume');
const byNewest = (a: (typeof entries)[number], b: (typeof entries)[number]) =>
  b.data.start.localeCompare(a.data.start);
const work = entries
  .filter((entry) => entry.data.kind === 'work')
  .sort(byNewest);
const education = entries
  .filter((entry) => entry.data.kind === 'education')
  .sort(byNewest);

const profiles = CV_PROFILES.map((label) => {
  const social = SOCIALS.find((entry) => entry.label === label);
  if (!social)
    throw new Error(`CV_PROFILES names no SOCIALS entry "${label}".`);
  return social;
});
---

<BaseLayout
  title="Curriculum vitae"
  description={`Curriculum vitae of ${SITE.name} — ${SITE.role}. Positions and education, with a PDF to download.`}
>
  <main id="main" class="cv cv-document">
    <p class="cv__back no-print">
      <a href={withBase('/')}>&larr; Portfolio</a>
    </p>

    <header class="cv__opening">
      <div class="cv__header">
        <div class="cv__identity">
          <Image
            class="cv__portrait"
            src={portrait}
            alt={SITE.name}
            width={80}
            height={80}
          />
          <div class="cv__naming">
            <h1 class="cv__name">{SITE.name}</h1>
            <p class="cv__study">
              <strong>{CV_STUDY.field}</strong><br />{CV_STUDY.institution}
            </p>
          </div>
        </div>

        <div class="cv__contact">
          <ul class="cv__reach">
            <li>
              <Icon icon="mail" alt="" class="cv__mark" />
              <a href={`mailto:${CV_CONTACT.email}`}>{CV_CONTACT.email}</a>
            </li>
            <li>
              <Icon icon="phone" alt="" class="cv__mark" />
              <a href={CV_CONTACT.phoneHref}>{CV_CONTACT.phone}</a>
            </li>
            <li>
              <Logo type="chat" variant="monochrome" class="cv__mark" />
              <a href={CV_CONTACT.website}>{CV_CONTACT.website}</a>
            </li>
          </ul>

          <ul class="cv__profiles">
            {
              profiles.map((social) => (
                <li>
                  <img
                    src={withBase(social.icon)}
                    alt=""
                    width={social.width}
                    height={social.height}
                    class="cv__mark"
                  />
                  <a href={social.href}>{social.href}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <p class="cv__intro">{CV_INTRO}</p>
    </header>

    <p class="cv__download no-print">
      <Button type="secondary" href={CV_PDF} download>Download as PDF</Button>
    </p>

    <section class="cv__section" aria-labelledby="h-experience">
      <h2 id="h-experience" class="cv__section-title">Experience</h2>
      <ol class="cv__list">
        {
          work.map((entry, index) => (
            <li class="cv__row" style={`--cv-mark-index: ${index}`}>
              <CvSection
                state="pdf"
                role={entry.data.role}
                company={entry.data.company}
                start={entry.data.start}
                end={entry.data.end}
              >
                <Icon
                  slot="logo"
                  icon="triangle"
                  color="herbs"
                  alt=""
                  class="cv-section__mark"
                />
                {entry.data.summary && <p>{entry.data.summary}</p>}
              </CvSection>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="cv__section cv__section--education"
      aria-labelledby="h-education"
    >
      <h2 id="h-education" class="cv__section-title">Education</h2>
      <ol class="cv__list">
        {
          education.map((entry, index) => (
            <li class="cv__row" style={`--cv-mark-index: ${index}`}>
              <CvSection
                state="pdf"
                role={entry.data.role}
                company={entry.data.company}
                start={entry.data.start}
                end={entry.data.end}
              >
                <Icon
                  slot="logo"
                  icon="triangle"
                  color="tomato"
                  alt=""
                  class="cv-section__mark"
                />
                {entry.data.summary && <p>{entry.data.summary}</p>}
              </CvSection>
            </li>
          ))
        }
      </ol>
    </section>

    <ToolBox usage="pdf" tools={CV_TOOLS} class="cv__tools" />
  </main>
</BaseLayout>

<style>
  :global(body:has(.cv-document)) {
    background-color: #ffffff;
  }

  .cv-document :global(.toolbox--pdf .toolbox__tool) {
    background-color: #ffffff;
  }

  /* Figma 267:4053: a 64 margin on every side, its blocks 40 apart. */
  .cv {
    display: grid;
    row-gap: var(--space-lg);
    max-width: var(--grid-frame);
    margin-inline: auto;
    padding: var(--space-xl);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  /* The site has no nav, and a CV is a page people arrive at from outside. */
  .cv__back {
    font-size: var(--font-size-sm);
    color: var(--color-neutral-700);
  }

  /* Figma 492:2539: the header row and the paragraph 24 apart. */
  .cv__opening {
    display: grid;
    row-gap: var(--space-md);
  }

  /* Figma 477:1911: the profile at one end, the two contact columns at the other. */
  .cv__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  /* Figma 477:1912: an 80 portrait, 12 from the naming lines. */
  .cv__identity {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .cv__portrait {
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  /* Figma 477:1915: the two naming lines 8 apart. */
  .cv__naming {
    display: grid;
    row-gap: var(--space-2xs);
    padding-block: var(--space-xs);
  }

  /* Typography/H4 on the h1: only the size differs from global.css. */
  .cv__name {
    font-size: var(--font-size-lg);
  }

  /* Figma text style: Typography/Body - Small. */
  .cv__study {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  .cv__study strong {
    font-weight: var(--font-weight-bold);
  }

  /* Figma 492:2529: the two contact columns 40 apart. */
  .cv__contact {
    display: flex;
    gap: var(--space-lg);
  }

  /* Figma 492:2528 and 477:1918: rows 8 apart, mark and text 8 apart,
     Typography/Body - Small in neutral-800. */
  .cv__reach,
  .cv__profiles {
    display: grid;
    row-gap: var(--space-2xs);
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-neutral-800);
  }

  .cv__profiles {
    padding-block-end: var(--space-3xs);
  }

  .cv__contact a[href^='mailto:'],
  .cv__contact a[href^='tel:'] {
    text-decoration: none;
  }

  .cv__reach li,
  .cv__profiles li {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  /* 18 is the size the header draws every mark at (Figma 477:2404, 477:2385) —
     a drawn size with no token, recorded in design/components.json unbound. */
  :global(.cv__mark) {
    flex-shrink: 0;
    inline-size: 18px;
    block-size: auto;
  }

  /* Figma 477:2483 draws the paragraph across the whole content column. */
  .cv__intro {
    max-width: none;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-neutral-800);
  }

  /* Figma 477:1947: the title and the list 24 apart. */
  .cv__section {
    display: grid;
    row-gap: var(--space-md);
  }

  /* Typography/H3 on the h2. */
  .cv__section-title {
    font-size: var(--font-size-xl);
  }

  /* Figma 477:1949: entries 24 apart. */
  .cv__list {
    display: grid;
    row-gap: var(--space-md);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  /* Figma 477:1955: Education is drawn 866 wide inside the 1152 column. A4 is a
     narrower sheet, so the ratio transfers and the pixels do not. */
  .cv__section--education {
    inline-size: 75.2%;
  }

  /* Figma 477:1961: Tech & Tools is drawn 422 wide in the 1152 column — the same
     four-of-ten columns /resume gives it. Ratio again, not pixels. */
  :global(.cv__tools) {
    inline-size: 36.6%;
  }

  /* Handoff §12: each entry's mark carries on turning, restarting at the top of
     each section. Figma −16 is clockwise on screen, so CSS continues it with a
     positive rotate. */
  .cv__row :global(.cv-section__mark) {
    rotate: calc(16deg * var(--cv-mark-index, 0));
  }

  /* @page cannot read custom properties. 10.5mm is the proportional inset:
     210mm × 64 / 1280 from Figma frame 267:4053. */
  @page {
    size: A4;
    margin: 10.5mm;
  }

  @media print {
    :global(body:has(.cv-document)) {
      min-height: 0;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .cv {
      display: block;
      padding: 0;
      max-width: none;
    }

    .cv__section,
    .cv__list {
      display: block;
    }

    .cv__section {
      margin-block-start: var(--space-lg);
    }

    :global(.cv__tools) {
      margin-block-start: var(--space-lg);
    }

    .cv__list {
      margin-block-start: var(--space-md);
    }

    .cv__row + .cv__row {
      margin-block-start: var(--space-md);
    }

    .cv__name {
      font-size: calc(var(--font-size-base) * 1.5);
    }

    .cv__section-title,
    :global(.cv__tools .toolbox__title) {
      font-size: calc(var(--font-size-base) * 2);
    }

    .no-print {
      display: none;
    }

    /* Handoff §12: normal entries stay intact, while an entry longer than a
       sheet can still fragment rather than clip. */
    .cv__opening,
    .cv__row {
      break-inside: avoid;
    }

    :global(.cv__tools) {
      break-inside: avoid;
    }

    .cv__section-title {
      break-after: avoid;
    }

    .cv__list > .cv__row:first-child {
      break-before: avoid;
    }
  }
</style>
