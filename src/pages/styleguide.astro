---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  colorScales,
  grounds,
  contrastMatrix,
  bodySafeOnLight,
  fontSizes,
  spacing,
  radii,
} from '../lib/tokens';
import Avatar from '../components/Avatar.astro';
import BlankSection from '../components/BlankSection.astro';
import Button from '../components/Button.astro';
import ChatBubble from '../components/ChatBubble.astro';
import CuriosityRow from '../components/CuriosityRow.astro';
import CvSection from '../components/CvSection.astro';
import FlipCard from '../components/FlipCard.astro';
import FocusAreas from '../components/FocusAreas.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import NavBar from '../components/NavBar.astro';
import PostIt from '../components/PostIt.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import ProjectSection from '../components/ProjectSection.astro';
import ReleaseNote from '../components/ReleaseNote.astro';
import ToolBox from '../components/ToolBox.astro';

// Everything here is computed at build time from design/tokens.json.
// No client JS, and no hand-maintained copy of the palette that could go stale.

const shadows = ['sm', 'md', 'lg'];

const textStyles = [
  {
    name: 'Typography/H1',
    family: '--font-serif',
    size: '--font-size-3xl',
    weight: '--font-weight-semibold',
    lineHeight: '--line-height-none',
    letterSpacing: '--letter-spacing-normal',
    derived: false,
  },
  {
    name: 'Typography/H2',
    family: '--font-serif',
    size: '--font-size-2xl',
    weight: '--font-weight-semibold',
    lineHeight: '--line-height-none',
    letterSpacing: '--letter-spacing-normal',
    derived: false,
  },
  {
    name: 'Typography/H3',
    family: '--font-serif',
    size: '--font-size-xl',
    weight: '--font-weight-semibold',
    lineHeight: '--line-height-none',
    letterSpacing: '--letter-spacing-normal',
    derived: false,
  },
  {
    name: 'Typography/H4',
    family: '--font-serif',
    size: '--font-size-lg',
    weight: '--font-weight-semibold',
    lineHeight: '--line-height-none',
    letterSpacing: '--letter-spacing-normal',
    derived: false,
  },
  {
    name: 'Typography/H5',
    family: '--font-serif',
    size: '--font-size-base',
    weight: '--font-weight-semibold',
    lineHeight: '--line-height-none',
    letterSpacing: '--letter-spacing-normal',
    derived: false,
  },
  {
    name: 'Typography/Body',
    family: '--font-sans',
    size: '--font-size-base',
    weight: '--font-weight-regular',
    lineHeight: '--line-height-normal',
    letterSpacing: '--letter-spacing-normal',
    derived: true,
  },
  {
    name: 'Typography/Body - Small',
    family: '--font-sans',
    size: '--font-size-sm',
    weight: '--font-weight-regular',
    lineHeight: '--line-height-relaxed',
    letterSpacing: '--letter-spacing-normal',
    derived: false,
  },
  {
    name: 'Typography/Body - Large',
    family: '--font-sans',
    size: '--font-size-lg',
    weight: '--font-weight-regular',
    lineHeight: '--line-height-normal',
    letterSpacing: '--letter-spacing-normal',
    derived: true,
  },
  {
    name: 'Typography/Body - Bold',
    family: '--font-sans',
    size: '--font-size-base',
    weight: '--font-weight-bold',
    lineHeight: '--line-height-normal',
    letterSpacing: '--letter-spacing-normal',
    derived: true,
  },
  {
    name: 'Typography/Mono',
    family: '--font-mono',
    size: '--font-size-base',
    weight: '--font-weight-regular',
    lineHeight: '--line-height-loose',
    letterSpacing: '--letter-spacing-extra-wide',
    derived: true,
  },
  {
    name: 'Typography/Mono - Small',
    family: '--font-mono',
    size: '--font-size-sm',
    weight: '--font-weight-regular',
    lineHeight: '--line-height-loose',
    letterSpacing: '--letter-spacing-extra-wide',
    derived: false,
  },
  {
    name: 'Typography/Captions',
    family: '--font-sans',
    size: '--font-size-xs',
    weight: '--font-weight-regular',
    lineHeight: '--line-height-relaxed',
    letterSpacing: '--letter-spacing-normal',
    derived: true,
  },
] as const;

const placeholderTools = Array.from({ length: 6 }, () => ({ name: '[tool]' }));
const releaseDate = new Date('2026-02-06');
---

<BaseLayout
  title="Styleguide"
  description="Every design token in the system, rendered, with contrast ratios computed from the token file."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <main id="main" class="container guide">
    <header class="guide__head">
      <p class="eyebrow">Design system</p>
      <h1>Styleguide</h1>
      <p class="lede">
        Every token in the system, rendered from
        <code>design/tokens.json</code> at build time. If a value changes there, this
        page changes with it — including the contrast maths, so the numbers below
        can&rsquo;t quietly go stale.
      </p>
    </header>

    <!-- ------------------------------------------------------------------ -->
    <section aria-labelledby="h-primitives">
      <h2 id="h-primitives">Colour</h2>
      <p class="note">
        One tier — these names are what components use directly, and they are
        the same names as the Figma variables. Check the contrast table below
        before putting any of them behind text.
      </p>

      {
        colorScales.map((scale) => (
          <div class="scale">
            <h3 class="scale__name">{scale.name}</h3>
            <ol class="swatches">
              {scale.steps.map((s) => (
                <li class="swatch">
                  <span class="swatch__chip" style={`background:${s.value}`} />
                  <span class="swatch__step">{s.step}</span>
                  <code class="swatch__hex">{s.value}</code>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </section>

    <!-- ------------------------------------------------------------------ -->
    <section aria-labelledby="h-contrast">
      <h2 id="h-contrast">Contrast</h2>
      <p class="note">
        Every colour against every background it actually sits on. One colour
        scheme means there is no dark-mode escape hatch for a weak pairing, and
        with a single token tier nothing enforces this for you — so this table
        is the check. Thresholds are WCAG 2.1: <strong>4.5</strong> for body text,
        <strong>3.0</strong> for large text and for non-text UI that carries meaning.
      </p>

      <p class="callout callout--note">
        <strong>{bodySafeOnLight.length}</strong> of the{' '}
        {contrastMatrix.reduce((n, s) => n + s.rows.length, 0)} colours can carry
        body text on at least one light background. The rest are fills, not ink.
      </p>

      <ul class="legend">
        <li><span class="key key--text"></span> ≥ 4.5 — body text</li>
        <li>
          <span class="key key--large"></span> ≥ 3.0 — large text, borders, icons
        </li>
        <li><span class="key key--deco"></span> below 3.0 — decoration only</li>
      </ul>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Colour</th>
              {
                grounds.map((g) => (
                  <th class="num" scope="col">
                    on {g.step}
                  </th>
                ))
              }
            </tr>
          </thead>
          {
            contrastMatrix.map((scale) => (
              <tbody>
                <tr class="row--group">
                  <th colspan={grounds.length + 1} scope="colgroup">
                    {scale.name}
                  </th>
                </tr>
                {scale.rows.map((row) => (
                  <tr>
                    <td>
                      <span
                        class="swatch__dot"
                        style={`background:${row.value}`}
                      />
                      <code>{row.name}</code>
                    </td>
                    {row.cells.map((cell) => (
                      <td
                        class:list={[
                          'num',
                          cell.ratio >= 4.5
                            ? 'cell--text'
                            : cell.ratio >= 3
                              ? 'cell--large'
                              : 'cell--deco',
                        ]}
                      >
                        <span class="visually-hidden">
                          {row.name} on {cell.ground}:{' '}
                        </span>
                        {cell.ratio.toFixed(2)}
                        <span class="visually-hidden"> — {cell.verdict}</span>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>

      <div class="callout callout--note">
        <p>
          <strong>On Lemon.</strong> No step of the Lemon scale reaches 3.0 on any
          light background — the darkest, <code>lemon/500</code>, gets to 1.14
          on
          <code>neutral/100</code>. That is a property of yellow, not a mistake
          in the values: darkening it far enough to pass turns it into olive.
        </p>
        <p>
          So Lemon earns its keep as a <em>large fill</em> — dark text on a Lemon
          block is 15.62:1, which is excellent. It does not work as a thin rule, a
          small icon, a focus ring, or small text.
        </p>
        <p>
          The accent doing the small-text work is <code>pickled/500</code>. It
          clears 4.5 on <code>neutral/white</code> (4.53) but not on
          <code>neutral/100</code> (4.00), so on the page background it is a large-text
          and non-text colour rather than body ink. That is a reading off the table
          above, not a recommendation — the ramp ends at 500 by design.
        </p>
      </div>
    </section>

    <!-- ------------------------------------------------------------------ -->
    <section aria-labelledby="h-type">
      <h2 id="h-type">Type scale</h2>
      <p class="note">
        Sizes are fluid — each is a <code>clamp()</code>, so what you see
        depends on the width of this window. Resize it. The value shown is the
        desktop maximum, which is also what the Figma variable carries.
      </p>
      {
        [...fontSizes].reverse().map((size) => (
          <div class="type-row">
            <p class="type-row__sample" style={`font-size:var(${size.cssVar})`}>
              I care about experiences.
            </p>
            <p class="type-row__meta">
              <code>{size.cssVar}</code> · max {size.value}
            </p>
          </div>
        ))
      }

      <h3>Text styles</h3>
      <p class="note">
        The design defines twelve named text styles, and the repo records none
        of them. This block is where drift becomes visible: seven rows are
        transcribed from the design; the five marked <strong>inferred</strong>
        are inferred from component usage and still need confirming against Figma.
      </p>
      <div class="table-wrap">
        <table class="text-styles">
          <thead>
            <tr>
              <th scope="col">Style</th>
              <th scope="col">Live specimen</th>
              <th scope="col">Tokens</th>
            </tr>
          </thead>
          <tbody>
            {
              textStyles.map((style) => (
                <tr>
                  <th scope="row">
                    <code>{style.name}</code>
                    {style.derived && (
                      <span class="text-styles__marker">inferred</span>
                    )}
                  </th>
                  <td>
                    <span
                      class="text-styles__sample"
                      style={`font-family:var(${style.family});font-size:var(${style.size});font-weight:var(${style.weight});line-height:var(${style.lineHeight});letter-spacing:var(${style.letterSpacing})`}
                    >
                      I care about experiences.
                    </span>
                  </td>
                  <td>
                    <span class="text-styles__tokens">
                      <code>{style.family}</code>
                      <code>{style.size}</code>
                      <code>{style.weight}</code>
                      <code>{style.lineHeight}</code>
                      <code>{style.letterSpacing}</code>
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h3>Families</h3>
      <p class="note">
        All three are variable fonts, self-hosted. The italic below is
        browser-synthesised &mdash; Fontshare ships italics as separate files
        and Erode&rsquo;s is not vendored yet, so that word is a sheared roman
        rather than the drawn italic.
      </p>
      <p class="sample-serif">
        Erode Variable &mdash; display and the slogan. <em
          >Italic for emphasis.</em
        >
      </p>
      <p class="sample-sans">
        Satoshi Variable &mdash; UI and body copy. The workhorse.
      </p>
      <p class="sample-mono">
        JetBrains Mono &mdash; code, labels and tabular figures. 0123456789
      </p>
      <p class="note credit">
        <strong>Satoshi</strong> (Deni Anggara) and <strong>Erode</strong>
        (Nikhil Ranganathan, Jeremie Hornus) are &copy; 2017&ndash;2021
        <a href="https://www.indiantypefoundry.com">Indian Type Foundry</a>,
        both ITF trademarks, via <a href="https://www.fontshare.com"
          >Fontshare</a
        >.
        <strong>JetBrains Mono</strong> is &copy; 2020 the JetBrains Mono Project
        Authors, SIL OFL 1.1. Terms and provenance:
        <code>public/fonts/LICENSE</code>.
      </p>
    </section>

    <!-- ------------------------------------------------------------------ -->
    <section aria-labelledby="h-space">
      <h2 id="h-space">Spacing</h2>
      <p class="note">4px base grid.</p>
      <ol class="bars">
        {
          spacing.map((s) => (
            <li class="bar">
              <span class="bar__fill" style={`inline-size:var(${s.cssVar})`} />
              <code>{s.cssVar}</code>
              <span class="bar__value">{s.value}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ------------------------------------------------------------------ -->
    <section aria-labelledby="h-radius">
      <h2 id="h-radius">Radius &amp; elevation</h2>
      <ol class="tiles">
        {
          radii.map((r) => (
            <li>
              <span class="tile" style={`border-radius:var(${r.cssVar})`} />
              <code>{r.cssVar}</code>
              <span class="bar__value">{r.value}</span>
            </li>
          ))
        }
      </ol>
      <ol class="tiles">
        {
          shadows.map((s) => (
            <li>
              <span
                class="tile tile--raised"
                style={`box-shadow:var(--shadow-${s})`}
              />
              <code>--shadow-{s}</code>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ------------------------------------------------------------------ -->
    <section aria-labelledby="h-focus">
      <h2 id="h-focus">Focus</h2>
      <p class="note">
        Tab into these. Every interactive element gets a visible ring — the
        global stylesheet handles it, so it applies to anything focusable
        without per-component work.
      </p>
      <p class="focus-demo">
        <a href="#main">A link</a>
        <button type="button">A button</button>
        <input type="text" aria-label="A text input" placeholder="An input" />
      </p>
    </section>

    <!-- ------------------------------------------------------------------ -->
    <section aria-labelledby="h-components">
      <h2 id="h-components">Components</h2>
      <p class="note">
        Every published Figma set has exactly one counterpart here.
        <code>design/components.json</code> records the mapping between the design
        and these implementations.
      </p>

      <h3>Buttons</h3>
      <p class="note">
        Figma set <code>Buttons</code>, node <code>109:1382</code>.
      </p>
      <div class="demo">
        <Button type="primary" variant="default" href="#h-components"
          >go back in time</Button
        >
        <Button type="secondary" variant="default" href="#h-components"
          >Mehr erfahren →</Button
        >
        <Button type="nav" variant="primary" href="#h-components"
          >#aboutme</Button
        >
        <Button type="nav" variant="secondary">#behindthescenes</Button>
        <Button type="inline" variant="primary" href="#h-components"
          >How might we rebrand our marketing materials?</Button
        >
      </div>

      <h3>Chat</h3>
      <p class="note">
        Figma set <code>Chat</code>, node <code>109:1389</code>.
      </p>
      <div class="demo">
        <ChatBubble type="message" variant="default">
          <p>Hi, my name is Max, nice to meet you!</p>
        </ChatBubble>
        <ChatBubble type="response" variant="text"
          >I think this is great</ChatBubble
        >
        <ChatBubble type="response" variant="selection">Selected 1</ChatBubble>
        <ChatBubble type="request" variant="text" href="#h-components"
          >...</ChatBubble
        >
        <ChatBubble type="request" variant="selection" href="#h-components"
          >Option 1</ChatBubble
        >
      </div>

      <h3>User</h3>
      <p class="note">
        Figma set <code>user</code>, node <code>117:1308</code>.
      </p>
      <div class="demo">
        <Avatar user="moritz" />
        <Avatar user="karina" />
        <Avatar user="paula" />
        <Avatar user="all" />
        <Avatar user="max" />
      </div>

      <h3>Logo</h3>
      <p class="note">
        Figma set <code>logo</code>, node <code>108:1372</code>.
      </p>
      <div class="demo">
        <Logo type="favicon" variant="default" alt="Max favicon mark" />
        <Logo type="chat" variant="tomato" alt="Max chat mark on tomato" />
        <Logo type="chat" variant="herbs" alt="Max chat mark on herbs" />
      </div>

      <h3>Icons</h3>
      <p class="note">
        Figma set <code>Icons</code>, node <code>109:1374</code>.
      </p>
      <div class="demo">
        <Icon icon="cursor" alt="Cursor icon" />
        <Icon icon="figma-make" alt="Figma Make icon" />
      </div>

      <h3>Post-it</h3>
      <p class="note">
        Figma set <code>post-it</code>, node <code>114:581</code>.
      </p>
      <div class="demo">
        <PostIt color="herbs">[a note]</PostIt>
        <PostIt color="tomato">[a note]</PostIt>
        <PostIt color="lemon">[a note]</PostIt>
        <PostIt color="pickled">[a note]</PostIt>
      </div>

      <h3>Flipcard</h3>
      <p class="note">
        Figma set <code>flipcard</code>, node <code>114:569</code>.
      </p>
      <div class="demo">
        <FlipCard id="styleguide-flip-front" state="front" title="[project]">
          <p>[project summary]</p>
        </FlipCard>
        <FlipCard
          id="styleguide-flip-back"
          state="back"
          title="[project]"
          githubUrl="#h-components"
          figmaUrl="#h-components"
          additionalUrl="#h-components"
        >
          <p>[project summary]</p>
        </FlipCard>
        <FlipCard id="styleguide-flip-small" state="small" title="[project]">
          <p>[project summary]</p>
        </FlipCard>
      </div>

      <h3>Curiosity</h3>
      <p class="note">
        Figma set <code>curiosity</code>, node <code>114:610</code>.
      </p>
      <div class="demo">
        <CuriosityRow user="max">
          <p>[a curiosity]</p>
        </CuriosityRow>
      </div>

      <h3>Blank section</h3>
      <p class="note">
        Figma set <code>blank section</code>, node <code>114:636</code>.
      </p>
      <div class="demo demo--stack">
        <BlankSection level={4}>
          <p>[section body]</p>
        </BlankSection>
      </div>

      <h3>CV section</h3>
      <p class="note">
        Figma set <code>CV section</code>, node <code>114:640</code>.
      </p>
      <div class="demo demo--stack">
        <CvSection
          role="[role]"
          company="[company]"
          start="2026-03"
          end="2026-10"
          level={4}
        >
          <p>[summary]</p>
        </CvSection>
      </div>

      <h3>Project preview</h3>
      <p class="note">
        Figma set <code>project preview</code>, node <code>114:646</code>.
      </p>
      <div class="demo">
        <ProjectPreview
          id="styleguide-preview-collapsed-small"
          state="collapsed"
          size="small"
          caption="[caption]"
          title="[project title]"
        />
        <ProjectPreview
          id="styleguide-preview-collapsed-default"
          state="collapsed"
          size="default"
          caption="[caption]"
          title="[project title]"
        />
        <ProjectPreview
          id="styleguide-preview-exploded-default"
          state="exploded"
          size="default"
          caption="[caption]"
          title="[project title]"
        />
      </div>

      <h3>Tool box</h3>
      <p class="note">
        Figma set <code>tool box</code>, node <code>114:685</code>.
      </p>
      <div class="demo demo--stack">
        <ToolBox tools={placeholderTools} level={4} />
        <ToolBox tools={[]} level={4} />
      </div>

      <h3>Focus areas</h3>
      <p class="note">
        Figma set <code>focus areas</code>, node <code>115:703</code>.
      </p>
      <div class="demo demo--stack">
        <FocusAreas
          areas={['[focus area]', '[focus area]', '[focus area]']}
          level={4}
        />
        <FocusAreas areas={[]} level={4} />
      </div>

      <h3>Release notes</h3>
      <p class="note">
        Figma set <code>release notes</code>, node <code>115:706</code>.
      </p>
      <div class="demo demo--stack">
        <ReleaseNote
          state="active"
          date={releaseDate}
          backHref="#h-components"
          level={4}
        >
          <p slot="userExperience">[user experience]</p>
          <p slot="userInterface">[user interface]</p>
          <p slot="tools">[tools]</p>
        </ReleaseNote>
        <ReleaseNote state="inactive" date={releaseDate} level={4}>
          <p slot="userExperience">[inactive release note]</p>
        </ReleaseNote>
      </div>

      <h3>Project sections</h3>
      <p class="note">
        Figma set <code>project sections</code>, node <code>115:755</code>.
      </p>
      <div class="demo demo--stack">
        <ProjectSection
          state="active"
          title="[case study section]"
          subtitle="[section subtitle]"
          keyPoints={['[key point]', '[key point]']}
          level={4}
        >
          <p>[section description]</p>
        </ProjectSection>
        <ProjectSection
          state="inactive"
          title="[case study section]"
          subtitle="[section subtitle]"
          keyPoints={['[key point]', '[key point]']}
          level={4}
        >
          <p>[section description]</p>
        </ProjectSection>
      </div>

      <h3>NavBar</h3>
      <p class="note">
        Figma set <code>NavBar</code>, node <code>210:1625</code>.
      </p>
      <div class="demo demo--stack">
        <NavBar mode="default" label="Footer, light" />
        <div class="demo__dark">
          <NavBar mode="dark" label="Footer, dark" />
        </div>
      </div>
    </section>

    <footer class="guide__foot">
      <p>
        Source: <code>design/tokens.json</code> ·
        <code>src/styles/tokens.css</code> · rendered by
        <code>src/pages/styleguide.astro</code>
      </p>
    </footer>
  </main>
</BaseLayout>

<style>
  .guide {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .guide section {
    padding-block-start: var(--space-xl);
    margin-block-start: var(--space-xl);
    border-block-start: 1px solid var(--color-neutral-200);
  }

  .eyebrow {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-neutral-700);
  }

  h1 {
    margin-block: var(--space-xs) var(--space-md);
    font-size: var(--font-size-2xl);
  }

  h2 {
    font-size: var(--font-size-xl);
    margin-block-end: var(--space-sm);
  }

  h3 {
    font-size: var(--font-size-lg);
    margin-block: var(--space-lg) var(--space-sm);
  }

  .lede {
    font-size: var(--font-size-lg);
    color: var(--color-neutral-700);
  }

  .note {
    color: var(--color-neutral-700);
