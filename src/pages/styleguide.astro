---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  colorScales,
  grounds,
  contrastMatrix,
  bodySafeOnLight,
  fontSizes,
  spacing,
  radii,
} from '../lib/tokens';

// Everything here is computed at build time from design/tokens.json.
// No client JS, and no hand-maintained copy of the palette that could go stale.

const shadows = ['sm', 'md', 'lg'];
---

<BaseLayout
  title="Styleguide"
  description="Every design token in the system, rendered, with contrast ratios computed from the token file."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <main id="main" class="container guide">
    <header class="guide__head">
      <p class="eyebrow">Design system</p>
      <h1>Styleguide</h1>
      <p class="lede">
        Every token in the system, rendered from
        <code>design/tokens.json</code> at build time. If a value changes there, this
        page changes with it — including the contrast maths, so the numbers below
        can&rsquo;t quietly go stale.
      </p>
    </header>

    <!-- ------------------------------------------------------------------ -->
    <section aria-labelledby="h-primitives">
      <h2 id="h-primitives">Colour</h2>
      <p class="note">
        One tier — these names are what components use directly, and they are
        the same names as the Figma variables. Check the contrast table below
        before putting any of them behind text.
      </p>

      {
        colorScales.map((scale) => (
          <div class="scale">
            <h3 class="scale__name">{scale.name}</h3>
            <ol class="swatches">
              {scale.steps.map((s) => (
                <li class="swatch">
                  <span class="swatch__chip" style={`background:${s.value}`} />
                  <span class="swatch__step">{s.step}</span>
                  <code class="swatch__hex">{s.value}</code>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </section>

    <!-- ------------------------------------------------------------------ -->
    <section aria-labelledby="h-contrast">
      <h2 id="h-contrast">Contrast</h2>
      <p class="note">
        Every colour against every background it actually sits on. One colour
        scheme means there is no dark-mode escape hatch for a weak pairing, and
        with a single token tier nothing enforces this for you — so this table
        is the check. Thresholds are WCAG 2.1: <strong>4.5</strong> for body text,
        <strong>3.0</strong> for large text and for non-text UI that carries meaning.
      </p>

      <p class="callout callout--note">
        <strong>{bodySafeOnLight.length}</strong> of the{' '}
        {contrastMatrix.reduce((n, s) => n + s.rows.length, 0)} colours can carry
        body text on at least one light background. The rest are fills, not ink.
      </p>

      <ul class="legend">
        <li><span class="key key--text"></span> ≥ 4.5 — body text</li>
        <li>
          <span class="key key--large"></span> ≥ 3.0 — large text, borders, icons
        </li>
        <li><span class="key key--deco"></span> below 3.0 — decoration only</li>
      </ul>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Colour</th>
              {
                grounds.map((g) => (
                  <th class="num" scope="col">
                    on {g.step}
                  </th>
                ))
              }
            </tr>
          </thead>
          {
            contrastMatrix.map((scale) => (
              <tbody>
                <tr class="row--group">
                  <th colspan={grounds.length + 1} scope="colgroup">
                    {scale.name}
                  </th>
                </tr>
                {scale.rows.map((row) => (
                  <tr>
                    <td>
                      <span
                        class="swatch__dot"
                        style={`background:${row.value}`}
                      />
                      <code>{row.name}</code>
                    </td>
                    {row.cells.map((cell) => (
                      <td
                        class:list={[
                          'num',
                          cell.ratio >= 4.5
                            ? 'cell--text'
                            : cell.ratio >= 3
                              ? 'cell--large'
                              : 'cell--deco',
                        ]}
                      >
                        <span class="visually-hidden">
                          {row.name} on {cell.ground}:{' '}
                        </span>
                        {cell.ratio.toFixed(2)}
                        <span class="visually-hidden"> — {cell.verdict}</span>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>

      <div class="callout callout--note">
        <p>
          <strong>On Lemon.</strong> No step of the Lemon scale reaches 3.0 on any
          light background — the darkest, <code>lemon/500</code>, gets to 1.14
          on
          <code>neutral/100</code>. That is a property of yellow, not a mistake
          in the values: darkening it far enough to pass turns it into olive.
        </p>
        <p>
          So Lemon earns its keep as a <em>large fill</em> — dark text on a Lemon
          block is 15.62:1, which is excellent. It does not work as a thin rule, a
          small icon, a focus ring, or small text. Where an accent needs to be legible
          at small size, use <code>pickled/600</code> (5.65:1) and let Lemon carry
          the area instead of the line.
        </p>
      </div>
    </section>

    <!-- ------------------------------------------------------------------ -->
    <section aria-labelledby="h-type">
      <h2 id="h-type">Type scale</h2>
      <p class="note">
        Sizes are fluid — each is a <code>clamp()</code>, so what you see
        depends on the width of this window. Resize it. The value shown is the
        desktop maximum, which is also what the Figma variable carries.
      </p>
      {
        [...fontSizes].reverse().map((size) => (
          <div class="type-row">
            <p class="type-row__sample" style={`font-size:var(${size.cssVar})`}>
              I care about experiences.
            </p>
            <p class="type-row__meta">
              <code>{size.cssVar}</code> · max {size.value}
            </p>
          </div>
        ))
      }

      <h3>Families</h3>
      <p class="note">
        All three are variable fonts, self-hosted. The italic below is
        browser-synthesised &mdash; Fontshare ships italics as separate files
        and Erode&rsquo;s is not vendored yet, so that word is a sheared roman
        rather than the drawn italic.
      </p>
      <p class="sample-serif">
        Erode Variable &mdash; display and the slogan. <em
          >Italic for emphasis.</em
        >
      </p>
      <p class="sample-sans">
        Satoshi Variable &mdash; UI and body copy. The workhorse.
      </p>
      <p class="sample-mono">
        JetBrains Mono &mdash; code, labels and tabular figures. 0123456789
      </p>
      <p class="note credit">
        <strong>Satoshi</strong> (Deni Anggara) and <strong>Erode</strong>
        (Nikhil Ranganathan, Jeremie Hornus) are &copy; 2017&ndash;2021
        <a href="https://www.indiantypefoundry.com">Indian Type Foundry</a>,
        both ITF trademarks, via <a href="https://www.fontshare.com"
          >Fontshare</a
        >.
        <strong>JetBrains Mono</strong> is &copy; 2020 the JetBrains Mono Project
        Authors, SIL OFL 1.1. Terms and provenance:
        <code>public/fonts/LICENSE</code>.
      </p>
    </section>

    <!-- ------------------------------------------------------------------ -->
    <section aria-labelledby="h-space">
      <h2 id="h-space">Spacing</h2>
      <p class="note">4px base grid.</p>
      <ol class="bars">
        {
          spacing.map((s) => (
            <li class="bar">
              <span class="bar__fill" style={`inline-size:var(${s.cssVar})`} />
              <code>{s.cssVar}</code>
              <span class="bar__value">{s.value}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ------------------------------------------------------------------ -->
    <section aria-labelledby="h-radius">
      <h2 id="h-radius">Radius &amp; elevation</h2>
      <ol class="tiles">
        {
          radii.map((r) => (
            <li>
              <span class="tile" style={`border-radius:var(${r.cssVar})`} />
              <code>{r.cssVar}</code>
              <span class="bar__value">{r.value}</span>
            </li>
          ))
        }
      </ol>
      <ol class="tiles">
        {
          shadows.map((s) => (
            <li>
              <span
                class="tile tile--raised"
                style={`box-shadow:var(--shadow-${s})`}
              />
              <code>--shadow-{s}</code>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ------------------------------------------------------------------ -->
    <section aria-labelledby="h-focus">
      <h2 id="h-focus">Focus</h2>
      <p class="note">
        Tab into these. Every interactive element gets a visible ring — the
        global stylesheet handles it, so it applies to anything focusable
        without per-component work.
      </p>
      <p class="focus-demo">
        <a href="#main">A link</a>
        <button type="button">A button</button>
        <input type="text" aria-label="A text input" placeholder="An input" />
      </p>
    </section>

    <footer class="guide__foot">
      <p>
        Source: <code>design/tokens.json</code> ·
        <code>src/styles/tokens.css</code> · rendered by
        <code>src/pages/styleguide.astro</code>
      </p>
    </footer>
  </main>
</BaseLayout>

<style>
  .guide {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .guide section {
    padding-block-start: var(--space-xl);
    margin-block-start: var(--space-xl);
    border-block-start: 1px solid var(--color-neutral-200);
  }

  .eyebrow {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-neutral-700);
  }

  h1 {
    margin-block: var(--space-xs) var(--space-md);
    font-size: var(--font-size-2xl);
  }

  h2 {
    font-size: var(--font-size-xl);
    margin-block-end: var(--space-sm);
  }

  h3 {
    font-size: var(--font-size-lg);
    margin-block: var(--space-lg) var(--space-sm);
  }

  .lede {
    font-size: var(--font-size-lg);
    color: var(--color-neutral-700);
  }

  .note {
    color: var(--color-neutral-700);
    font-size: var(--font-size-sm);
    margin-block-end: var(--space-md);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  /* Swatches ------------------------------------------------------------- */

  .scale {
    margin-block-end: var(--space-lg);
  }

  .scale__name {
    margin-block: 0 var(--space-2xs);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-sm);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .swatch {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    font-size: var(--font-size-sm);
  }

  .swatch__chip {
    display: block;
    block-size: var(--space-xl);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-md);
  }

  .swatch__step {
    font-weight: var(--font-weight-medium);
  }

  .swatch__hex {
    color: var(--color-neutral-700);
  }

  /* Tables --------------------------------------------------------------- */

  .table-wrap {
    overflow-x: auto;
  }

  table {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  th,
  td {
    padding: var(--space-2xs) var(--space-xs);
    text-align: start;
    border-block-end: 1px solid var(--color-neutral-200);
  }

  th {
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }

  .num {
    font-variant-numeric: tabular-nums;
  }

  .row--group th {
    padding-block-start: var(--space-md);
    font-size: var(--font-size-base);
    text-transform: lowercase;
  }

  /*
   * The tint is redundant with the number and the visually-hidden verdict —
   * colour never carries the meaning on its own here.
   */
  .cell--text {
    background: var(--color-herbs-100);
  }

  .cell--large {
    background: var(--color-lemon-100);
  }

  .cell--deco {
    color: var(--color-neutral-700);
  }

  .swatch__dot {
    display: inline-block;
    inline-size: var(--space-xs);
    block-size: var(--space-xs);
    margin-inline-end: var(--space-2xs);
    vertical-align: -1px;
    border: 1px solid var(--color-neutral-300);
    border-radius: var(--radius-sm);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    padding: 0;
    margin-block-end: var(--space-md);
    list-style: none;
    font-size: var(--font-size-sm);
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .key {
    display: block;
    inline-size: var(--space-md);
    block-size: var(--space-xs);
    border: 1px solid var(--color-neutral-300);
    border-radius: var(--radius-sm);
  }

  .key--text {
    background: var(--color-herbs-100);
  }

  .key--large {
    background: var(--color-lemon-100);
  }

  .key--deco {
    background: var(--color-neutral-white);
  }

  /* Callouts ------------------------------------------------------------- */

  .callout {
    padding: var(--space-sm) var(--space-md);
    margin-block-end: var(--space-md);
    border-inline-start: var(--space-3xs) solid var(--color-neutral-300);
    border-radius: var(--radius-md);
    background: var(--color-neutral-white);
  }

  .callout p + p {
    margin-block-start: var(--space-2xs);
  }

  .callout--note {
    border-inline-start-color: var(--color-pickled-500);
  }

  /* Type ----------------------------------------------------------------- */

  .type-row {
    padding-block: var(--space-xs);
    border-block-end: 1px solid var(--color-neutral-200);
  }

  .type-row__sample {
    max-width: none;
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
  }

  .type-row__meta {
    margin-block-start: var(--space-3xs);
    font-size: var(--font-size-sm);
    color: var(--color-neutral-700);
  }

  .sample-serif {
    font-family: var(--font-serif);
    font-size: var(--font-size-xl);
  }

  .sample-sans {
    font-family: var(--font-sans);
    font-size: var(--font-size-lg);
  }

  .sample-mono {
    font-family: var(--font-mono);
    font-size: var(--font-size-base);
    letter-spacing: var(--letter-spacing-extra-wide);
  }

  /* The ITF licence requires the faces and the foundry be credited. */
  .credit {
    margin-block-start: var(--space-md);
    max-width: var(--measure);
  }

  /* Spacing bars --------------------------------------------------------- */

  .bars,
  .tiles {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-block: var(--space-3xs);
    font-size: var(--font-size-sm);
  }

  .bar__fill {
    display: block;
    block-size: var(--space-sm);
    background: var(--color-lemon-500);
    border-radius: var(--radius-sm);
    flex: none;
  }

  .bar__value {
    color: var(--color-neutral-700);
    font-size: var(--font-size-sm);
  }

  .tiles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-block-start: var(--space-md);
  }

  .tiles li {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    font-size: var(--font-size-sm);
  }

  .tile {
    display: block;
    inline-size: var(--space-2xl);
    block-size: var(--space-2xl);
    background: var(--color-lemon-300);
  }

  .tile--raised {
    background: var(--color-neutral-white);
    border-radius: var(--radius-md);
  }

  /* Focus demo ----------------------------------------------------------- */

  .focus-demo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
  }

  .focus-demo button,
  .focus-demo input {
    padding: var(--space-2xs) var(--space-sm);
    background: var(--color-neutral-white);
    border: 1px solid var(--color-neutral-300);
    border-radius: var(--radius-md);
  }

  .guide__foot {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-neutral-200);
    font-size: var(--font-size-sm);
    color: var(--color-neutral-700);
  }
</style>
