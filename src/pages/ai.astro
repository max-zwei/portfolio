---
import BlankSection from '../components/BlankSection.astro';
import NavBar from '../components/NavBar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Let's be honest">
  <main id="main" class="container ai">
    <BlankSection level={1}>
      <p>
        I have a lot of great ideas for this section and explaining how I’ve
        used AI for this page and also my use of AI in general. But my daughter
        is requesting “naked pasta” and expecting them now.
      </p>
      <p>I’ll hopefully return to this section soon!</p>
    </BlankSection>
  </main>

  <NavBar mode="dark" label="Site" />
</BaseLayout>

<style>
  .ai {
    padding-block: var(--space-3xl);
  }
</style>
