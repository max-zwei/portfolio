---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CvSection from '../components/CvSection.astro';
import FocusAreas from '../components/FocusAreas.astro';
import Icon from '../components/Icon.astro';
import NavBar from '../components/NavBar.astro';
import PostIt from '../components/PostIt.astro';
import ToolBox from '../components/ToolBox.astro';
import Button from '../components/Button.astro';
import {
  SITE,
  CV_STUDY,
  CV_INTRO,
  CV_TOOLS,
  SOCIALS,
  withBase,
} from '../config/site';
import portrait from '../assets/max-pinkert-portrait.png';

/** Written by scripts/render-pdf.mjs. Kept in one place so page and script agree. */
const CV_PDF = withBase('/cv/max-pinkert-cv.pdf');
const SHARE_URL = new URL(withBase('/resume'), Astro.site).href;

const entries = await getCollection('resume');
const projectEntries = await getCollection('projects');
const projectsById = new Map(
  projectEntries.map((project) => [project.id.replace(/\.md$/, ''), project]),
);
const CASE_SECTION_KEYS = [
  'context',
  'hmw',
  'exploration',
  'definition',
  'development',
  'feedback',
  'learning',
  'behindTheScenes',
] as const;
const projectArtefacts = (project: (typeof projectEntries)[number]) =>
  CASE_SECTION_KEYS.flatMap((key) => project.data[key]?.artefacts ?? []).slice(
    0,
    6,
  );
const resolvedProjects = (entry: (typeof entries)[number]) =>
  (entry.data.projects ?? []).flatMap((reference) => {
    const project = projectsById.get(reference.id.replace(/\.md$/, ''));
    if (!project) return [];

    const slug = project.id.replace(/\.md$/, '');
    return [
      {
        href: withBase(`/projects/${slug}`),
        title: project.data.hmw?.description.trim() ?? project.data.title,
        caption: project.data.company,
        artefacts: projectArtefacts(project),
      },
    ];
  });
const byNewest = (a: (typeof entries)[number], b: (typeof entries)[number]) =>
  b.data.start.localeCompare(a.data.start);
const work = entries
  .filter((entry) => entry.data.kind === 'work')
  .sort(byNewest);
const education = entries
  .filter((entry) => entry.data.kind === 'education')
  .sort(byNewest);

const documentLabel = (url: string) =>
  url.startsWith('/letters/') ? 'Reference letter (PDF)' : 'Certificate (PDF)';

const FOCUS_AREAS = ['User Experience', 'Branding'];

const REPORT_PDF = withBase('/report/101225_LPP_Report_Pinkert_Max.pdf');
const NOTES = [
  {
    color: 'herbs',
    text: 'You demonstrate an unconventional approach to thinking and acting. Even when it comes to solving problems, you like to break new ground and explore alternative approaches.',
  },
  {
    color: 'tomato',
    text: 'You have no problem questioning the status quo or taking a critical look at existing norms and value systems. Nor do you spare hierarchies or leadership from your criticism.',
  },
  {
    color: 'lemon',
    text: 'You are characterised by a great openness to ideas, concepts and discussions. You take an interest in the latest findings and discuss abstract ideas with like-minded people.',
  },
  {
    color: 'pickled',
    text: 'Creativity and value-driven behaviour are your key motivation factors. Your aim is to realise your own creative potential and to work in a meaningful environment.',
  },
] as const;
---

<BaseLayout
  title="Résumé"
  description={`Curriculum vitae of ${SITE.name} — ${SITE.role}. Positions and education, with a PDF to download.`}
>
  <main id="main" class="container cv">
    <div class="cv__opening">
      <header class="cv__header">
        <div class="cv__profile">
          <Image
            class="cv__portrait"
            src={portrait}
            alt={SITE.name}
            width={198}
            height={198}
          />
          <div class="cv__identity">
            <div class="cv__naming">
              <h1 class="cv__name">{SITE.name}</h1>
              <p class="cv__study">
                {CV_STUDY.field}<br />{CV_STUDY.institution}
              </p>
            </div>

            <ul class="cv__socials">
              {
                SOCIALS.map((social) => (
                  <li>
                    <a href={social.href} aria-label={social.label}>
                      <Icon icon={social.icon} color="black" alt="" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="cv__actions">
          <Button icon="on" href={CV_PDF} download>
            <Icon slot="icon" icon="download" alt="" />
            Download
          </Button>
          <Button icon="on" href={SHARE_URL} class="cv__share" data-share>
            <Icon slot="icon" icon="share" alt="" />
            Share
          </Button>
        </div>

        <p class="visually-hidden" role="status" data-share-status></p>
      </header>

      <p class="cv__intro">{CV_INTRO}</p>
    </div>

    <div class="cv__body">
      <div class="cv__sections">
        <section class="cv__section" aria-labelledby="h-experience">
          <h2 id="h-experience" class="cv__section-title">Experience</h2>
          <ol class="cv__list">
            {
              work.map((entry, index) => (
                <li class="cv__row">
                  <CvSection
                    role={entry.data.role}
                    company={entry.data.company}
                    start={entry.data.start}
                    end={entry.data.end}
                    index={index}
                    state="default"
                    projects={resolvedProjects(entry)}
                    documentUrl={entry.data.documentUrl}
                    documentLabel={
                      entry.data.documentUrl &&
                      documentLabel(entry.data.documentUrl)
                    }
                  >
                    {entry.data.logo && entry.data.logoAlt && (
                      <Image
                        slot="logo"
                        src={entry.data.logo}
                        alt={entry.data.logoAlt}
                      />
                    )}
                    {entry.data.summary && <p>{entry.data.summary}</p>}
                  </CvSection>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="cv__section" aria-labelledby="h-education">
          <h2 id="h-education" class="cv__section-title">Education</h2>
          <ol class="cv__list">
            {
              education.map((entry, index) => (
                <li class="cv__row">
                  <CvSection
                    role={entry.data.role}
                    company={entry.data.company}
                    start={entry.data.start}
                    end={entry.data.end}
                    index={index}
                    state="default"
                    projects={resolvedProjects(entry)}
                    documentUrl={entry.data.documentUrl}
                    documentLabel={
                      entry.data.documentUrl &&
                      documentLabel(entry.data.documentUrl)
                    }
                  >
                    {entry.data.summary && <p>{entry.data.summary}</p>}
                  </CvSection>
                </li>
              ))
            }
          </ol>
        </section>
      </div>

      <ul class="cv__notes">
        {
          NOTES.map((note) => (
            <li>
              <PostIt color={note.color} href={REPORT_PDF}>
                {note.text}
              </PostIt>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="cv__strip">
      <div class="cv__toolbox"><ToolBox tools={CV_TOOLS} /></div>
      <div class="cv__focus"><FocusAreas areas={FOCUS_AREAS} /></div>
    </div>
  </main>

  <NavBar mode="dark" label="Site" />
</BaseLayout>

<style>
  /* Figma 377:2095: 144 between the header, both sections and the strip. */
  .cv {
    display: grid;
    row-gap: var(--space-3xl);
    padding-block: var(--space-3xl);
  }

  /* Figma 477:2484: the header and the paragraph 64 apart. */
  .cv__opening {
    display: grid;
    row-gap: var(--space-xl);
  }

  /* Figma 477:2483 draws the paragraph across the whole content column, wider
     than global.css's --measure default for a p. */
  .cv__intro {
    max-width: none;
  }

  /* Figma 251:2566: the profile and the two actions at opposite ends. */
  .cv__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .cv__profile {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* 198 is the asset's own size, not a token (skill §9). */
  .cv__portrait {
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  /* Figma 251:2564: the naming block and the marks at the ends of a column
     inset by 16 top and bottom. */
  .cv__identity {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .cv__naming {
    display: grid;
    row-gap: var(--space-xs);
  }

  /* Typography/H2 on the h1: only the size differs from global.css. */
  .cv__name {
    font-size: var(--font-size-2xl);
  }

  /* Figma 377:2096: five marks in a row, 12 apart, 4 of bottom padding. */
  .cv__socials {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0;
    padding-block-end: var(--space-3xs);
    list-style: none;
  }

  /* Figma 377:2104: the mark lifts on md-lemon geometry. */
  .cv__socials a {
    display: inline-flex;
  }

  .cv__socials a:hover :global(.icon),
  .cv__socials a:focus-visible :global(.icon) {
    filter: url(#md-lemon-alpha);
  }

  /* Figma 251:2560: the two icon buttons stack 16 apart, right-aligned. */
  .cv__actions {
    display: flex;
    align-items: flex-end;
    gap: var(--space-sm);
  }

  /* Handoff §9: Share keeps lemon/200 in both states, deliberately. The class
     reaches Button's root, hence :global. */
  :global(.btn.cv__share),
  :global(.btn.cv__share:hover) {
    background-color: var(--color-lemon-200);
  }

  .cv__section {
    display: grid;
    row-gap: var(--space-lg);
  }

  /* Typography/H1 on the h2. */
  .cv__section-title {
    font-size: var(--font-size-3xl);
  }

  /* Figma 251:2615 and 377:1989: both lists are drawn at 64. */
  .cv__list {
    display: grid;
    row-gap: var(--space-xl);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .cv__row {
    display: grid;
    row-gap: var(--space-md);
  }

  /* Figma 377:2095: the two sections are 144 apart, like every other pair. */
  .cv__sections {
    display: grid;
    row-gap: var(--space-3xl);
  }

  /*
   * The rail is one column of notes for the whole timeline, spread over its
   * height. Below 48rem it has nowhere to sit beside the entries, and the
   * Mobile frame (`103:1124`) is unfinished, so it follows them instead.
   */
  .cv__notes {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: 0;
    margin-block-start: var(--space-xl);
    list-style: none;
  }

  .cv__strip {
    display: grid;
    row-gap: var(--space-2xl);
  }

  /*
   * Handoff §16 via IntersectionObserver: entries outside the middle 33% of
   * the viewport fade to neutral-300 (Handoff §14 — the contrast failure is
   * intended, the dimmed entry is not meant to be read), and the rail's line
   * fades neutral-200 → neutral-100 with them. CvSection colours its own
   * parts, so the dimmed state has to reach them. Nothing is dimmed without
   * the script.
   */
  .cv__row,
  .cv__row :global(*) {
    transition: color var(--duration-slow) var(--easing-standard);
  }

  .cv__row :global(.cv-section__rail)::after {
    transition: background-color var(--duration-slow) var(--easing-standard);
  }

  .cv__row--dimmed,
  .cv__row--dimmed :global(*) {
    color: var(--color-neutral-300);
  }

  .cv__row--dimmed {
    --cv-section-line-color: var(--color-neutral-100);
  }

  @media (min-width: 48rem) {
    .cv__header {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }

    .cv__profile {
      flex-direction: row;
      align-items: center;
    }

    .cv__identity {
      align-self: stretch;
      padding-block: var(--space-sm);
    }

    .cv__actions {
      flex-direction: column;
    }

    .cv__body,
    .cv__strip {
      display: grid;
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      column-gap: var(--grid-gutter);
    }

    /* Handoff §13: seven columns for the entries; the notes ride the two the
       page keeps free on the right (Figma 251:3244, right edge 1184). Column
       8 stays clear between the text and the note rail. */
    .cv__sections {
      grid-column: 1 / span 7;
    }

    .cv__notes {
      grid-column: 9 / -1;
      margin-block-start: 0;
      gap: 0;
    }

    .cv__toolbox {
      grid-column: 1 / span 4;
    }

    .cv__focus {
      grid-column: 7 / span 4;
    }
  }
</style>

<script>
  import { observeFocusBand } from '../lib/focus-dim';

  const rows = document.querySelectorAll<HTMLElement>('.cv__row');
  observeFocusBand(rows, (row, active) => {
    row.classList.toggle('cv__row--dimmed', !active);
  });

  // Handoff §6: Share copies this page's URL. Without the script the button is
  // still a link to that URL.
  const share = document.querySelector<HTMLAnchorElement>('[data-share]');
  const status = document.querySelector<HTMLElement>('[data-share-status]');
  share?.addEventListener('click', async (event) => {
    if (!navigator.clipboard) return;
    event.preventDefault();
    await navigator.clipboard.writeText(share.href);
    if (status) status.textContent = 'Link copied';
  });
</script>
