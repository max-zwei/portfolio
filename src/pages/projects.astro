---
import { getCollection } from 'astro:content';
import NavBar from '../components/NavBar.astro';
import ProjectBento, {
  type BentoImage,
  type ImageSlot,
} from '../components/ProjectBento.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../config/site';

const projects = await getCollection('projects');
const imageSlots = [
  '0.8h',
  '0.6h_l',
  '0.6h_s',
  '1_2_l',
  '1_2_s',
  '1_1',
  '1_2',
] as const;
const variants = ['1', '2', '3', '4', '5', '6'] as const;
const projectBentos = projects.map((entry, index) => {
  const slug = entry.id.replace(/\.md$/, '');
  const images: Partial<Record<ImageSlot, BentoImage>> = {};
  for (const slot of imageSlots) {
    const src = entry.data[`img_${slot}`];
    const alt = entry.data[`img_${slot}_alt`];
    if (src && alt) images[slot] = { src, alt };
  }
  return {
    variant: variants[index % variants.length],
    title: entry.data.title,
    hmw: entry.data.hmw,
    href: withBase(`/projects/${slug}`),
    images,
    colors: [
      entry.data.color1,
      entry.data.color2,
      entry.data.color3,
      entry.data.color4,
      entry.data.color5,
      entry.data.color6,
      entry.data.color7,
      entry.data.color8,
    ] as const,
  };
});
---

<BaseLayout title="Projects">
  <main id="main" class="projects">
    <h1 class="visually-hidden">Projects</h1>
    <section class="projects__grid" aria-label="Projects">
      {
        projectBentos.map((project) => (
          <div class="projects__item">
            <ProjectBento {...project} />
          </div>
        ))
      }
    </section>
  </main>
  <NavBar label="Site" />
</BaseLayout>

<style>
  :global(body:has(.projects)) {
    background-color: var(--color-neutral-white);
    transition: background-color var(--duration-slow) var(--easing-standard);
  }

  :global(body:has(.projects .project-bento:is(:hover, :focus-visible))) {
    background-color: var(--color-neutral-black);
  }

  .projects {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .projects__grid {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 26.3125rem));
    justify-content: center;
    align-items: start;
    gap: var(--space-2xl);
    max-inline-size: var(--grid-frame);
    margin-inline: auto;
  }

  .projects__item {
    --bento-expanded-width: 100cqw;
    --bento-offset: calc(
      min(26.3125rem, (100cqw - var(--space-2xl)) / 2) + var(--space-2xl) / 2 -
        50cqw
    );
    min-inline-size: 0;
    transition: opacity var(--duration-slow) var(--easing-standard);
  }

  .projects__item:nth-child(even) {
    --bento-offset: calc(-50cqw - var(--space-2xl) / 2);
  }

  /* Keep every grid position in place: the expanded descendant is the hit region,
     including its gaps and CTA. Moving outside it naturally ends :hover. */
  .projects
    :global(
      .projects__grid:has(.project-bento:is(:hover, :focus-visible))
        .projects__item:not(:has(.project-bento:is(:hover, :focus-visible)))
    ) {
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 48rem) {
    .projects {
      padding-inline: var(--space-md);
    }
    .projects__grid {
      grid-template-columns: minmax(0, 26.3125rem);
    }
    .projects__item,
    .projects__item:nth-child(even) {
      --bento-offset: calc((min(26.3125rem, 100cqw) - 100cqw) / 2);
    }
  }
</style>
