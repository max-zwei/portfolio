---
import { getCollection } from 'astro:content';
import Avatar from '../components/Avatar.astro';
import ChatBubble from '../components/ChatBubble.astro';
import FlipCard from '../components/FlipCard.astro';
import NavBar from '../components/NavBar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('playground');
---

<BaseLayout title="Playground">
  <script is:inline slot="head">
    document.documentElement.classList.add('js');
  </script>

  <main id="main" class="playground">
    <h1 class="visually-hidden">Playground</h1>
    <h2 id="playground-canvas-title" class="visually-hidden">
      Playground projects
    </h2>

    <!-- Without scripts this viewport is an ordinary scrollable grid. Every
         card shows both faces and every destination remains reachable. -->
    <section
      class="playground__viewport"
      data-canvas
      aria-labelledby="playground-canvas-title"
    >
      <div class="playground__chat" data-playground-chat>
        <div class="playground__chat-state">
          <Avatar user="max" class="playground__avatar" />
          <div class="playground__message-stack">
            <ChatBubble
              user="talking-head"
              state="default"
              class="playground__bubble playground__message--expanded"
            >
              <p>
                I’m always up for a challenge, if you have an upcoming project
                and are limited regarding your resources, check out my handshake
                agreement. I basically offer free-of-charge support with the
                prerequisite of using the work in my portfolio.
              </p>
            </ChatBubble>
            <ChatBubble
              user="talking-head"
              state="default"
              class="playground__bubble playground__message--collapsed"
            >
              <p>“Do one portrait, now do 200 more!”</p>
              <p>- Brian Chesky</p>
            </ChatBubble>
          </div>
        </div>
      </div>

      <div
        class="playground__world"
        data-world
        data-has-cards={entries.length > 0 ? '' : undefined}
      >
        <span class="playground__sentinel" data-canvas-sentinel></span>
        {
          entries.map((entry) => {
            const slug = entry.id.replace(/\.md$/, '');
            return (
              <div id={slug} class="playground__card" tabindex="-1">
                <FlipCard
                  id={`playground-${slug}`}
                  state="front"
                  title={entry.data.title}
                  teaser={entry.data.teaser}
                  teaserAlt={entry.data.teaserAlt}
                  githubUrl={entry.data.githubUrl}
                  figmaUrl={entry.data.figmaUrl}
                  additionalUrl={entry.data.additionalUrl}
                >
                  <p>{entry.data.summary}</p>
                </FlipCard>
              </div>
            );
          })
        }
      </div>
    </section>
  </main>

  <NavBar label="Site" />
</BaseLayout>

<style>
  :global(body:has(.playground)) {
    background-color: var(--color-neutral-white);
  }

  .playground__viewport {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    padding: var(--space-md);
    overflow: auto;
  }

  .playground__world {
    display: grid;
    grid-template-columns: max-content;
    gap: var(--space-2xl);
    align-content: start;
    align-items: start;
    justify-content: start;
  }

  .playground__card {
    inline-size: max-content;
    justify-self: start;
  }

  .playground__sentinel {
    display: none;
  }

  .playground__chat {
    position: relative;
    z-index: 2;
  }

  .playground__chat-state {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .playground__message-stack {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    min-inline-size: 0;
  }

  .playground__message-stack :global(.playground__message--collapsed) {
    display: none;
  }

  .playground__chat :global(.playground__bubble) {
    max-width: calc(5 * var(--grid-column) + 4 * var(--grid-gutter));
  }

  .playground__chat :global(.playground__bubble) p {
    max-width: none;
  }

  :global(html.js) .playground__viewport {
    position: relative;
    display: block;
    block-size: calc(
      100svh - var(--space-3xl) - var(--space-xl) - var(--space-xs)
    );
    padding: 0;
    overflow: hidden;
    background-color: var(--color-neutral-white);
  }

  :global(html.js) .playground__world {
    position: absolute;
    inset: 0;
    grid-template-columns: repeat(3, max-content);
    padding-block-start: calc(var(--space-lg) + var(--space-2xs));
    padding-inline-start: var(--grid-margin);
    inline-size: 100%;
    block-size: 100%;
    transform-origin: left top;
    will-change: transform;
  }

  :global(html.js) .playground__world[data-has-cards]::before {
    content: '';
    grid-column: 1 / span 2;
    grid-row: 1;
    min-inline-size: var(--chat-inline-size, 0);
    block-size: var(--chat-block-size, 0);
    pointer-events: none;
  }

  :global(html.js) .playground__sentinel {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
    opacity: 0;
  }

  :global(html.js) .playground__card:nth-child(1 of .playground__card) {
    grid-column: 3;
    grid-row: 1;
  }

  :global(html.js) .playground__card:nth-child(3n of .playground__card) {
    margin-block-start: var(--space-xl);
  }

  :global(html.js) .playground__card:nth-child(3n + 4 of .playground__card) {
    margin-block-start: calc(2 * var(--space-xl));
  }

  :global(html.js) .playground__chat {
    position: absolute;
    inset-block-start: calc(var(--space-lg) + var(--space-2xs));
    inset-inline-start: var(--grid-margin);
    max-inline-size: calc(100% - 2 * var(--grid-margin));
  }

  .playground__chat[data-collapsed] :global(.playground__avatar),
  .playground__chat[data-collapsed] :global(.playground__message--expanded) {
    display: none;
  }

  .playground__chat[data-collapsed] .playground__message-stack {
    inline-size: max-content;
    max-inline-size: min(
      100%,
      calc(5 * var(--grid-column) + 4 * var(--grid-gutter))
    );
  }

  .playground__chat[data-collapsed] :global(.playground__message--collapsed) {
    display: block;
    inline-size: auto;
    justify-self: stretch;
  }

  @media (max-width: 48rem) {
    :global(html.js) .playground__viewport {
      display: grid;
      block-size: auto;
      gap: var(--space-xl);
      padding: var(--space-md);
      overflow-x: auto;
    }

    :global(html.js) .playground__world {
      position: static;
      display: grid;
      grid-template-columns: max-content;
      block-size: auto;
      padding: 0;
      transform: none !important;
    }

    :global(html.js) .playground__world[data-has-cards]::before {
      display: none;
    }

    :global(html.js) .playground__world .playground__card {
      grid-column: auto;
      grid-row: auto;
      margin-block-start: 0;
    }

    :global(html.js) .playground__card,
    :global(html.js) .playground__chat {
      position: static;
    }

    :global(html.js) .playground__chat {
      max-inline-size: 100%;
      min-inline-size: 0;
    }

    :global(html.js) .playground__sentinel {
      display: none;
    }
  }
</style>

<script>
  const viewport = document.querySelector<HTMLElement>('[data-canvas]');
  const world = document.querySelector<HTMLElement>('[data-world]');
  const chat = document.querySelector<HTMLElement>('[data-playground-chat]');
  const sentinel = document.querySelector<HTMLElement>(
    '[data-canvas-sentinel]',
  );

  if (viewport && world) {
    const smallViewport = matchMedia('(max-width: 48rem)');
    let x = 0;
    let y = 0;
    const measure = document.createElement('span');
    measure.style.cssText =
      'position:absolute;inline-size:var(--space-lg);visibility:hidden';
    viewport.append(measure);
    const panStep = measure.getBoundingClientRect().width;
    measure.remove();

    const render = () => {
      world.style.transform = `translate3d(${x}px, ${y}px, 0)`;
    };

    const bringCardIntoView = (card: HTMLElement): void => {
      const canvasBounds = viewport.getBoundingClientRect();
      const cardBounds = card.getBoundingClientRect();
      if (cardBounds.left < canvasBounds.left)
        x += canvasBounds.left - cardBounds.left;
      if (cardBounds.right > canvasBounds.right)
        x -= cardBounds.right - canvasBounds.right;
      if (cardBounds.top < canvasBounds.top)
        y += canvasBounds.top - cardBounds.top;
      if (cardBounds.bottom > canvasBounds.bottom)
        y -= cardBounds.bottom - canvasBounds.bottom;
      render();
    };

    let focusedCard: HTMLElement | null = null;
    let focusedLeft = 0;
    let focusedTop = 0;
    let focusedWidth = 0;
    let focusedHeight = 0;
    const rememberFocusedCard = (card: HTMLElement): void => {
      focusedCard = card;
      focusedLeft = card.offsetLeft;
      focusedTop = card.offsetTop;
      focusedWidth = card.offsetWidth;
      focusedHeight = card.offsetHeight;
    };

    const revealCard = (card: HTMLElement): void => {
      if (smallViewport.matches) {
        card.scrollIntoView({
          block: 'nearest',
          inline: 'nearest',
          behavior: 'instant' as ScrollBehavior,
        });
      } else {
        bringCardIntoView(card);
      }
      rememberFocusedCard(card);
    };

    let chatWidth = 0;
    let chatHeight = 0;
    const reserveChat = (): void => {
      if (
        !chat ||
        smallViewport.matches ||
        !world.hasAttribute('data-has-cards') ||
        chat.hasAttribute('data-collapsed')
      )
        return;

      // The grid padding and chat insets share an origin. Retain the expanded
      // rectangle after collapse, including on resize, rather than measuring
      // hidden content or letting a pan change the grid's tracks.
      const bounds = chat.getBoundingClientRect();
      if (bounds.width !== chatWidth) {
        chatWidth = bounds.width;
        world.style.setProperty('--chat-inline-size', `${chatWidth}px`);
      }
      if (bounds.height !== chatHeight) {
        chatHeight = bounds.height;
        world.style.setProperty('--chat-block-size', `${chatHeight}px`);
      }
    };

    let resizeFrame = 0;
    const scheduleLayout = (): void => {
      if (resizeFrame) return;
      resizeFrame = requestAnimationFrame(() => {
        resizeFrame = 0;
        reserveChat();
        const card = focusedCard;
        if (!card || !card.contains(document.activeElement)) return;

        // Offset geometry excludes canvas transforms and native scrolling.
        // Only a real relayout may maintain focus visibility; the URL is not
        // a persistent anchor and observer delivery alone must not undo a pan.
        if (
          card.offsetLeft !== focusedLeft ||
          card.offsetTop !== focusedTop ||
          card.offsetWidth !== focusedWidth ||
          card.offsetHeight !== focusedHeight
        )
          revealCard(card);
      });
    };

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(scheduleLayout);
      if (chat) resizeObserver.observe(chat);
      world
        .querySelectorAll<HTMLElement>('.playground__card')
        .forEach((card) => {
          resizeObserver.observe(card);
        });
    }
    window.addEventListener('resize', scheduleLayout);
    document.fonts.ready.then(scheduleLayout);

    const revealHashTarget = (): void => {
      if (!location.hash) return;

      let id: string;
      try {
        id = decodeURIComponent(location.hash.slice(1));
      } catch {
        return;
      }

      const target = document.getElementById(id);
      if (
        !(target instanceof HTMLElement) ||
        !target.classList.contains('playground__card') ||
        !world.contains(target)
      )
        return;

      revealCard(target);
      target.focus({ preventScroll: true });
    };

    viewport.addEventListener(
      'wheel',
      (event) => {
        if (smallViewport.matches) return;
        event.preventDefault();
        x -= event.deltaX;
        y -= event.deltaY;
        render();
      },
      { passive: false },
    );

    viewport.addEventListener('keydown', (event) => {
      if (smallViewport.matches || event.target !== viewport) return;
      const movement: Record<string, [number, number]> = {
        ArrowLeft: [panStep, 0],
        ArrowRight: [-panStep, 0],
        ArrowUp: [0, panStep],
        ArrowDown: [0, -panStep],
      };
      const delta = movement[event.key];
      if (!delta) return;
      event.preventDefault();
      x += delta[0];
      y += delta[1];
      render();
    });

    viewport.addEventListener('focusin', (event) => {
      const card = (event.target as Element).closest<HTMLElement>(
        '.playground__card',
      );
      if (!card) return;
      revealCard(card);
    });

    const syncMode = () => {
      if (smallViewport.matches) {
        viewport.removeAttribute('tabindex');
        viewport.setAttribute('aria-label', 'Playground projects');
        world.style.removeProperty('transform');
      } else {
        viewport.tabIndex = 0;
        viewport.setAttribute(
          'aria-label',
          'Explorable playground canvas. Use a trackpad, mouse wheel, or arrow keys to pan.',
        );
        render();
      }
    };
    window.addEventListener('hashchange', revealHashTarget);
    smallViewport.addEventListener('change', () => {
      syncMode();
      reserveChat();
      requestAnimationFrame(() => requestAnimationFrame(revealHashTarget));
    });
    syncMode();
    reserveChat();
    revealHashTarget();
  }

  if (chat && sentinel && viewport && 'IntersectionObserver' in window) {
    let seen = false;
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.intersectionRatio === 1) {
          seen = true;
        } else if (seen) {
          chat.setAttribute('data-collapsed', '');
          observer.disconnect();
        }
      },
      { root: viewport, threshold: 1 },
    );
    observer.observe(sentinel);
  }
</script>
