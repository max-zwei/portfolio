---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar, { type AvatarUser } from '../components/Avatar.astro';
import ChatBubble from '../components/ChatBubble.astro';
import { SITE, withBase } from '../config/site';
import { AXES, AXIS_IDS, type AxisId } from '../config/match';
import type { Entry, Run } from '../lib/match';

// The /home frames in Figma: a branching chat, seven states. `skip` is the
// fallback for a visitor who would rather just browse.
//
// The copy is the design's, transcribed verbatim — typos and all. Where two
// frames disagree (`Sounds promising` vs `Sounds promisin`), the chip's own
// label wins, because one string drives both the chip and its echo.

type Message = {
  paragraphs: Run[][];
  /**
   * Present when the message has a face beside it. Just the name: `Avatar`
   * owns the asset path and the alt text, because both are properties of the
   * artwork rather than of this conversation.
   */
  speaker?: AvatarUser;
  /** The tomato panel that carries the prototype's answer, in `result`. */
  panel?: boolean;
};

type Choice = { label: string; href: string; value?: string };

type Step = {
  id: string;
  /** Visually hidden — the section needs a real heading to point at. */
  heading: string;
  /** Chips echoed back at the top: what the visitor said to get here. */
  answers?: string[];
  messages: Message[];
  /** The axis this step's chips answer. */
  axis?: AxisId;
  choices?: Choice[];
};

/** An axis's chips: every taggable option, then the escape hatch. */
const chips = (axis: AxisId, next: string): Choice[] => [
  ...AXES[axis].tags.map((t) => ({
    label: t.label,
    value: t.id,
    href: step(next),
  })),
  { label: AXES[axis].other, href: step(next) },
];

/** A question's options are ordinary reply chips leading to the next one. */
const asks = (
  prompt: string,
  axis: AxisId,
  next: string,
): Pick<Step, 'messages' | 'axis' | 'choices'> => ({
  messages: [{ paragraphs: [[prompt]] }],
  axis,
  choices: chips(axis, next),
});

const step = (id: string) => `#step-${id}`;

const MAX: AvatarUser = 'max';

const STEPS: Step[] = [
  {
    id: 'start',
    heading: 'Max says hello',
    messages: [
      {
        speaker: MAX,
        paragraphs: [['Hi, my name is Max, nice to meet you!'], ['...']],
      },
      {
        paragraphs: [
          ['Recently I stumbled upon a HMW, you might also question yourself:'],
          ['How might we come to a decision to hire or not hire Max?'],
        ],
      },
    ],
    choices: [
      { label: 'Where do I find the “Skip” button?', href: step('skip') },
      { label: 'Tell me more', href: step('team') },
    ],
  },

  {
    id: 'skip',
    heading: 'Explore on your own',
    answers: ['Let’s skip this'],
    messages: [
      {
        paragraphs: [
          [
            'Happy to do that, feel free to explore my portfolio in your own pace and style!',
          ],
          ['Here a few links to get your started:'],
        ],
      },
    ],
    choices: [
      { label: 'Resume', href: withBase('/resume') },
      { label: 'My inspiration', href: withBase('/inspiration') },
      { label: 'Projects', href: withBase('/projects') },
      { label: 'Playground', href: withBase('/playground') },
      { label: 'Behind the scenes', href: withBase('/behind-the-scenes') },
      { label: 'My curiosities', href: withBase('/curiosities') },
    ],
  },

  {
    id: 'team',
    heading: 'The team behind the question',
    answers: ['Tell me more'],
    messages: [
      {
        paragraphs: [
          ['Let me introduce the team who tackled this How-might-we question:'],
        ],
      },
      {
        speaker: 'moritz',
        paragraphs: [
          [
            'Hi there, I’m Moritz, a fellow designer, looking for connection or inspiration.',
          ],
        ],
      },
      {
        speaker: 'karina',
        paragraphs: [
          [
            'Hello dear, my name is Karina, a recruiter, browsing profiles and checking if Max’ profile suits what we are looking for.',
          ],
        ],
      },
      {
        speaker: 'paula',
        paragraphs: [
          [
            'Nice to meet you, I’m Paula, Max’ future boss, I want to understand the skillset and preferably see his work and projects, Karina already introduced me to his CV.',
          ],
        ],
      },
      { paragraphs: [['Want to find out how they tackled the question?']] },
    ],
    choices: [
      {
        label: 'You said something about a “Skip” button?',
        href: step('skip'),
      },
      { label: 'YES!', href: step('questions') },
    ],
  },

  {
    id: 'questions',
    heading: 'What the team asked first',
    answers: ['YES!'],
    messages: [
      {
        speaker: 'all',
        paragraphs: [
          [
            'The first question that popped to our mind was, how can we understand who Max is? Which material or research would we need?',
          ],
        ],
      },
      {
        paragraphs: [
          [
            'Is it a simple ',
            { text: 'Resume', href: withBase('/resume') },
            ' ?',
          ],
        ],
      },
      {
        paragraphs: [
          ['Do we browse through his projects, for example'],
          [
            {
              text: 'How might we rebrand our marketing material?',
              href: withBase('/projects'),
            },
          ],
        ],
      },
      {
        paragraphs: [
          [
            'Should we read through ',
            { text: 'reference letters', href: withBase('/letters') },
            ' of previous employees?',
          ],
        ],
      },
      {
        paragraphs: [
          [
            'Or do we get a better picture of him by looking at his ',
            { text: 'inspiration', href: withBase('/inspiration') },
            ' ?',
          ],
        ],
      },
      {
        paragraphs: [
          [
            'How about creating a tool that evaluates Max’ fit to a given role or project?',
          ],
        ],
      },
    ],
    choices: [
      { label: 'Skiiiip', href: step('skip') },
      { label: 'Sounds promising, tell me more!', href: step('prototype') },
    ],
  },

  {
    id: 'prototype',
    heading: 'The idea',
    answers: ['Sounds promising, tell me more!'],
    messages: [
      {
        paragraphs: [
          [
            'The idea is to create a kind of questionnaire regarding the desired role and matching the expectations to the skillset and experience.',
          ],
        ],
      },
      {
        paragraphs: [
          ['Resulting in a statement like such:'],
          [
            'Max ticks all the boxes except ... You can find prove looking at project x.',
          ],
          ['Are you willing to trade off ... against ... ?'],
        ],
      },
      { paragraphs: [['Let’s build a first prototype!']] },
      { paragraphs: [['Done, you want to give it a try?']] },
    ],
    choices: [
      { label: 'Nope', href: step('skip') },
      { label: 'Sure, what the hell!', href: step('questionnaire') },
    ],
  },

  {
    id: 'questionnaire',
    heading: 'A few questions',
    answers: ['Sure, what the hell!'],
    messages: [
      {
        paragraphs: [
          [
            'We have a couple of questions for you regarding the role or support you’re seeking.',
          ],
        ],
      },
      { paragraphs: [['What best describes your team?']] },
    ],
    axis: 'team',
    choices: chips('team', 'field'),
  },

  {
    id: 'field',
    heading: 'The field',
    // The frame's own sample pick, until the script puts the real one here.
    answers: ['Startup'],
    ...asks('What is the field you need support with?', 'field', 'role'),
  },

  {
    id: 'role',
    heading: 'Max’ role',
    answers: ['Web Design'],
    ...asks('What should be Max’ role?', 'role', 'stack'),
  },

  {
    id: 'stack',
    heading: 'Tool setup',
    answers: ['Freelancer'],
    ...asks(
      'Any specific tool setup or tech stack your project requires?',
      'tech',
      'result',
    ),
  },

  {
    id: 'result',
    heading: 'What the prototype says',
    // The frame's own sample picks. The script overwrites them with the real
    // answers; without it these stand, which is what the design shows.
    answers: [
      'Startup',
      'Web Design',
      'Freelancer',
      'Framer / Webflow / Wix ...',
    ],
    messages: [
      { paragraphs: [['Let’s run the prototype and see what we get!']] },
      {
        panel: true,
        paragraphs: [
          ['It depends, are you willing to trade off … to gain … ?'],
          ['Skill-wise he ticks the boxes for your tool setup of … .'],
          [
            'And maybe project x can provide you a clearer understanding of a similar set of deliverables to what you are aiming for.',
          ],
        ],
      },
      {
        paragraphs: [
          [
            'We hope this helped you in your decision. If you have any feedback regarding our tool, send it our way → ',
            {
              text: 'feedback@zwei.berlin',
              href: 'mailto:feedback@zwei.berlin',
            },
          ],
        ],
      },
      {
        paragraphs: [
          [
            'We’ll leave you here and invite you to explore the other sections of this website. See you!',
          ],
        ],
      },
    ],
    choices: [
      { label: 'Resume', href: withBase('/resume') },
      { label: 'Inspiration', href: withBase('/inspiration') },
      { label: 'Projects', href: withBase('/projects') },
      { label: 'Playground', href: withBase('/playground') },
      { label: 'Behind the scenes', href: withBase('/behind-the-scenes') },
      { label: 'Curiosities', href: withBase('/curiosities') },
    ],
  },
];

/** The four tag arrays, keyed the way the matcher reads them. */
const tags = (m: {
  teams: readonly string[];
  fields: readonly string[];
  roles: readonly string[];
  tech: readonly string[];
}) => ({ team: m.teams, field: m.fields, role: m.roles, tech: m.tech });

/*
 * Everything the questionnaire can point at, flattened for the client — the
 * answers only exist in the browser, so the matching has to happen there.
 *
 * `href` is what resolves *today*: the section pages for projects,
 * playground, inspiration and curiosities do not exist yet, so an entry
 * without an external link is named without being linked rather than pointed
 * at a 404. When those routes land, this is the one place to change.
 */
const EVIDENCE: Entry[] = [
  ...(await getCollection('projects')).map((e) => ({
    collection: 'projects' as const,
    label: e.data.title,
    href: e.data.figmaUrl ?? e.data.repoUrl ?? null,
    tags: tags(e.data.match),
  })),
  ...(await getCollection('playground')).map((e) => ({
    collection: 'playground' as const,
    label: e.data.title,
    href: e.data.additionalUrl ?? e.data.githubUrl ?? e.data.figmaUrl ?? null,
    tags: tags(e.data.match),
  })),
  ...(await getCollection('inspiration')).map((e) => ({
    collection: 'inspiration' as const,
    label: e.data.title,
    href: e.data.url,
    tags: tags(e.data.match),
  })),
  ...(await getCollection('curiosity')).map((e) => ({
    collection: 'curiosity' as const,
    label: e.data.thought,
    href: null,
    tags: tags(e.data.match),
  })),
  ...(await getCollection('resume')).map((e) => ({
    collection: 'resume' as const,
    label: `${e.data.role}, ${e.data.company}`,
    href: e.data.projectUrls[0] ?? withBase('/resume'),
    tags: tags(e.data.match),
  })),
].filter((e) => AXIS_IDS.some((axis) => e.tags[axis].length));
---

<BaseLayout>
  <main id="main" class="chat">
    {/* The design draws no page heading; the document still needs one. */}
    <h1 class="visually-hidden">{SITE.name} — {SITE.role}</h1>

    <div class="chat__transcript" data-transcript>
      {
        STEPS.map((s) => (
          <section
            id={`step-${s.id}`}
            class:list={['chat__step', s.id === 'start' && 'chat__step--first']}
            aria-labelledby={`h-${s.id}`}
            tabindex="-1"
            data-axis={s.axis}
          >
            <h2 id={`h-${s.id}`} class="visually-hidden">
              {s.heading}
            </h2>

            {s.answers && (
              <ul class="chat__said" data-said>
                {s.answers.map((a) => (
                  <ChatBubble
                    as="li"
                    type="response"
                    variant="selection"
                    class="chat__answer"
                  >
                    {a}
                  </ChatBubble>
                ))}
              </ul>
            )}

            <ol class="chat__thread">
              {s.messages.map((m, i) => (
                <li class="chat__row" style={`--i: ${i}`}>
                  {m.speaker && (
                    <Avatar user={m.speaker} class="chat__avatar" />
                  )}
                  <ChatBubble
                    type="message"
                    class:list={[
                      'chat__bubble',
                      m.panel && 'chat__bubble--panel',
                    ]}
                    data-panel={m.panel}
                  >
                    {m.paragraphs.map((p) => (
                      <p class="chat__text" data-type>
                        {p.map((run) =>
                          typeof run === 'string' ? (
                            run
                          ) : (
                            <a href={run.href}>{run.text}</a>
                          ),
                        )}
                      </p>
                    ))}
                  </ChatBubble>
                </li>
              ))}
            </ol>

            {s.choices && (
              <ul class="chat__choices">
                {s.choices.map((c) => (
                  <li>
                    <ChatBubble
                      type="request"
                      variant="selection"
                      class="chat__choice"
                      href={c.href}
                      data-value={c.value}
                    >
                      {c.label}
                    </ChatBubble>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>

    {
      /* The entries the panel can cite. `is:inline` because this is data, not
        a module, and Astro would otherwise try to bundle it. */
    }
    <script
      is:inline
      type="application/json"
      data-match
      set:html={JSON.stringify(EVIDENCE).replace(/</g, '\\u003c')}
    />
  </main>
</BaseLayout>

<style>
  /*
   * One exchange is on screen at a time, which is what the frames show — the
   * conversation does not accumulate. `:target` carries that with no script;
   * the `:has()` rule is what keeps the opening step up before any chip is
   * clicked, and drops it once one is.
   */
  .chat {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    padding-block: var(--space-2xl) var(--space-3xl);
    background-color: var(--color-neutral-white);
  }

  /*
   * Auto margins rather than `justify-content`, so a transcript taller than
   * the viewport scrolls to its top instead of overflowing out of reach. While
   * it is short — the opening exchange — this centres it, since the rest of
   * the page is empty.
   */
  .chat__transcript {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    width: 100%;
    max-width: var(--size-chat-column);
    margin-block: auto;
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  .chat__step {
    display: none;
  }

  .chat__step:target,
  .chat:not(:has(.chat__step:target)) .chat__step--first {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .chat__step:focus {
    outline: none;
  }

  /*
   * With the script running the conversation accumulates instead of swapping:
   * the script moves each visited step into the transcript, in the order it
   * was actually visited, and every one of them stays visible to scroll back
   * through. `:target` still drives it without the script.
   */
  .chat--live .chat__step {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Messages fade as they leave the top, rather than being cut off. */
  .chat--live::before {
    content: '';
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    height: var(--space-xl);
    background-image: linear-gradient(
      to bottom,
      var(--color-neutral-white),
      transparent
    );
    pointer-events: none;
  }

  /* --- the conversation ------------------------------------------------ */

  .chat__thread,
  .chat__said,
  .chat__choices {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* `display` below beats the UA's `[hidden] { display: none }`, so the
     withdrawn options need saying explicitly or they stay on screen. */
  .chat__choices[hidden] {
    display: none;
  }

  .chat__thread {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .chat__row {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    animation: chat-arrive var(--duration-base) var(--easing-entrance) both;
    animation-delay: calc(var(--i) * var(--stagger, var(--duration-fast)));
  }

  /*
   * With the script running, a row arrives when its own first character does,
   * not on a fixed index stagger — otherwise every bubble and avatar is on
   * screen inside 600ms while the text is still typing into them. The index
   * stagger above stays as the no-JS default; nothing there can sequence it.
   *
   * The chips are a direct child only: `.chat__choices` also names the option
   * rows inside the questionnaire, and those are not part of the sequence.
   */
  .chat__step--typed > .chat__choices {
    animation: chat-arrive var(--duration-base) var(--easing-entrance) both;
  }

  /* Order matters: the `animation` shorthand above resets the delay, so this
     has to come after it. */
  .chat__step--typed .chat__row,
  .chat__step--typed > .chat__choices {
    animation-delay: var(--row-start, 0ms);
  }

  @keyframes chat-arrive {
    from {
      opacity: 0;
      transform: translateY(var(--space-md));
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /*
   * ---------------------------------------------------------------------
   * Reaching into the components this page composes.
   *
   * Astro passes a `class` down to a child component but NOT the parent's
   * `data-astro-cid-*`, so a page rule naming a class that lands on a
   * component's ROOT element compiles to a selector that matches nothing.
   * Slotted content is the opposite case — it keeps this page's scope, which
   * is why `.chat__text` below needs no escape.
   *
   * Every rule that targets a component root is therefore written as
   * `.chat__transcript :global(…)`: anchored on a page-scoped ancestor so it
   * stays confined to this page's chat, rather than a bare `:global` that
   * would leak the class site-wide.
   * ---------------------------------------------------------------------
   */

  /* Sized by the asset's own 87px, on the element — the nearest space step is
     96, and substituting it would be drift dressed up as a token. */
  .chat__transcript :global(.chat__avatar) {
    flex-shrink: 0;
  }

  /*
   * The bubble's box and type now come from `ChatBubble` (Figma `Chat`,
   * `109:1389`). What stays here is only what this page owns: the panel
   * variant, which the Figma set does not draw, and the link colour inside a
   * bubble.
   */
  .chat__text {
    max-width: none;
  }

  .chat__transcript :global(.chat__bubble) a {
    color: var(--color-tomato-500);
  }

  /*
   * Not in the Figma `Chat` set — a page-only variant, applied as a second
   * class on the `<ChatBubble>`. Both classes are named deliberately: it has
   * to beat `ChatBubble`'s own `.bubble--message { max-width }`, and one class
   * alone ties with it on specificity, leaving the winner to stylesheet order.
   */
  .chat__transcript :global(.chat__bubble.chat__bubble--panel) {
    max-width: none;
    margin-block: var(--space-xl);
    padding: var(--space-md);
    font-size: var(--font-size-base);
    background-color: var(--color-tomato-100);
    border-radius: var(--radius-lg);
  }

  .chat__transcript :global(.chat__bubble--panel) .chat__text + .chat__text {
    margin-block-start: var(--space-md);
    padding-inline-start: var(--space-lg);
  }

  /* --- what the visitor said, and what they can say next --------------- */

  .chat__said,
  .chat__choices {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-xs);
    padding-inline-start: var(--space-xl);
  }

  /*
   * The chips' box and type come from `ChatBubble` too — `.chat__answer` is
   * `response/selection` and `.chat__choice` is `request/selection`, including
   * the undesigned hover this page introduced. Only the row layout above and
   * the breakpoint override below belong to the page.
   */

  @media (min-width: 48rem) {
    .chat__transcript {
      padding-inline: var(--space-lg);
    }

    .chat__transcript :global(.chat__answer),
    .chat__transcript :global(.chat__choice) {
      max-width: 100%;
      white-space: nowrap;
    }
  }
</style>

<script>
  import { AXIS_IDS, type AxisId } from '../config/match';
  import { statement, verdict, type Answer, type Entry } from '../lib/match';

  const payload =
    document.querySelector<HTMLScriptElement>('script[data-match]');
  const entries: Entry[] = payload
    ? (JSON.parse(payload.textContent || '[]') as Entry[])
    : [];

  /*
   * Progressive enhancement, and nothing more. With this file blocked the page
   * is still the whole conversation: every chip is a real link, `:target`
   * moves between steps, and the CSS plays the arrival.
   *
   * What it adds is the part the Motion frame asks for and CSS cannot reach:
   * text arriving letter by letter, and the visitor's own words carried
   * forward instead of the frames' stand-ins.
   *
   * Note it never calls `preventDefault` on a chip. The native jump is what
   * re-evaluates `:target`; `history.pushState` changes the URL without
   * re-evaluating it, which leaves every step hidden.
   */
  const steps = document.querySelectorAll<HTMLElement>('.chat__step');
  if (steps.length) {
    const still = matchMedia('(prefers-reduced-motion: reduce)');

    /** Typing pace, in ms. PER_CHAR is the one Max signed off on. */
    const PER_CHAR = 18;
    const BETWEEN = 240; // beat between two paragraphs in the same bubble
    const ENTRANCE = 240; // --duration-base: the bubble's own arrival

    /** Rebuild a paragraph as per-character spans, then reveal them in turn. */
    const type = (el: HTMLElement, startDelay: number) => {
      const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      const texts: Text[] = [];
      for (let n = walker.nextNode(); n; n = walker.nextNode()) {
        texts.push(n as Text);
      }

      let i = 0;
      for (const node of texts) {
        const frag = document.createDocumentFragment();
        // Array.from, not split(''), so an emoji or accent stays one unit.
        for (const ch of Array.from(node.data)) {
          const span = document.createElement('span');
          span.textContent = ch;
          span.className = 'chat__char';
          span.style.setProperty('--c', String(i++));
          frag.append(span);
        }
        node.replaceWith(frag);
      }
      el.style.setProperty('--start', `${startDelay}ms`);
      el.dataset.typed = 'true';
    };

    const play = (stepEl: HTMLElement) => {
      if (stepEl.dataset.played) return;
      stepEl.dataset.played = 'true';
      if (still.matches) {
        // The global reduced-motion blanket zeroes animation *duration*, not
        // *delay*, so the arrival would still play out staggered. Collapse it.
        stepEl.style.setProperty('--stagger', '0ms');
        return;
      }

      stepEl.classList.add('chat__step--typed');

      // Walk blocks, not paragraphs: a container appears when its own first
      // character is about to, so the conversation arrives one message at a
      // time rather than as a set of empty bubbles that fill in later.
      //
      // A questionnaire question is a fieldset rather than a row, and carries
      // its own options — without it here the whole of `home - 6` landed at
      // once, with no entrance at all.
      let delay = 0;
      const blocks = stepEl.querySelectorAll<HTMLElement>('.chat__row');
      for (const block of blocks) {
        block.style.setProperty('--row-start', `${delay}ms`);
        follow(delay + ENTRANCE);
        // Let the bubble settle before its first character lands.
        delay += ENTRANCE;
        for (const p of block.querySelectorAll<HTMLElement>('[data-type]')) {
          type(p, delay);
          delay += Array.from(p.textContent ?? '').length * PER_CHAR + BETWEEN;
        }
      }

      // The chips come last: offering "Tell me more" before Max has finished
      // saying anything reads as the page talking over itself.
      stepEl
        .querySelector<HTMLElement>(':scope > .chat__choices')
        ?.style.setProperty('--row-start', `${delay}ms`);
      follow(delay + ENTRANCE);
    };

    /** What the visitor last said, and every answer the questions collected. */
    let said: string[] = [];
    const picks = new Map<AxisId, Answer>();

    /*
     * The conversation is one transcript, the way a messenger thread is: every
     * visited step is moved into it and stays there to scroll back through.
     * Steps start detached and are appended in the order they are actually
     * visited, which is not the order they sit in the document.
     *
     * Moving them, rather than rebuilding, is what keeps Astro's scope
     * attribute — and with it every scoped style — attached to the markup.
     */
    const chat = document.querySelector<HTMLElement>('.chat');
    const transcript = document.querySelector<HTMLElement>('[data-transcript]');
    const waiting = new Map(
      [...steps].map((s) => [s.id, s] as [string, HTMLElement]),
    );
    chat?.classList.add('chat--live');
    for (const s of steps) s.remove();

    /** Distance from the bottom still counted as being at the bottom. */
    const SLACK = 240;
    const atBottom = () =>
      innerHeight + scrollY >= document.body.scrollHeight - SLACK;

    /*
     * Follow the newest message unless the visitor has scrolled away to read
     * back — yanking them out of the history they asked for would be worse
     * than not following at all.
     *
     * The flag tracks *their* scrolling, not the distance to the bottom: new
     * messages grow the page without firing a scroll event, so arriving
     * content never unpins. Our own smooth scroll does fire events on the way,
     * hence the window in which they are ignored.
     */
    let pinned = true;
    let ours = 0;
    addEventListener(
      'scroll',
      () => {
        if (performance.now() < ours) return;
        pinned = atBottom();
      },
      { passive: true },
    );

    const follow = (at: number) => {
      setTimeout(() => {
        if (!pinned) return;
        ours = performance.now() + 900; // long enough to cover the glide
        scrollTo({
          top: document.body.scrollHeight,
          behavior: still.matches ? 'auto' : 'smooth',
        });
      }, at);
    };

    /**
     * Swap the frame's placeholder statement for the one the answers earn.
     *
     * Paragraphs are cloned rather than created: scoped styles compile to
     * `.chat__text[data-astro-cid-…]` and only Astro's own markup carries that
     * attribute. Links have no node to clone, so they borrow the attribute
     * from the panel itself.
     */
    const fillResult = (stepEl: HTMLElement) => {
      const panel = stepEl.querySelector<HTMLElement>('[data-panel]');
      const template = panel?.querySelector<HTMLElement>('.chat__text');
      if (!panel || !template) return;

      const paragraphs = statement(verdict(entries, [...picks.values()]));
      // Nothing matched, or nothing was answered: the design's copy stands.
      if (!paragraphs.length) return;

      const scope = [...panel.attributes]
        .map((a) => a.name)
        .find((name) => name.startsWith('data-astro-cid-'));

      panel.replaceChildren(
        ...paragraphs.map((runs) => {
          const p = template.cloneNode(false) as HTMLElement;
          p.append(
            ...runs.map((run) => {
              if (typeof run === 'string') return run;
              const a = document.createElement('a');
              if (scope) a.setAttribute(scope, '');
              a.href = run.href;
              a.textContent = run.text;
              return a;
            }),
          );
          return p;
        }),
      );
    };

    const enter = (id: string, advanced = true) => {
      const stepEl = waiting.get(id);
      if (!stepEl) return;

      const revisiting = stepEl.parentElement === transcript;
      // Back navigation keeps the transcript where it happened, but unlocks a
      // question so its answer can be replaced. The result is the exception:
      // refresh it in place from the newly replaced answer.
      if (revisiting && id !== 'step-result') {
        stepEl
          .querySelector<HTMLElement>(':scope > .chat__choices')
          ?.removeAttribute('hidden');
        if (advanced) stepEl.focus({ preventScroll: true });
        return;
      }

      // Once answered, the options that were not taken go away, as a
      // messenger's quick replies do. The choice itself survives as the
      // echoed chip on the step being appended.
      transcript
        ?.querySelector<HTMLElement>('.chat__step:last-child > .chat__choices')
        ?.setAttribute('hidden', '');

      const echo = stepEl.querySelector('[data-said]');
      // Clone the chip Astro rendered rather than building one. Scoped styles
      // compile to `.chat__answer[data-astro-cid-…]`, and only Astro's own
      // markup carries that attribute — a `createElement` chip matches nothing
      // and renders as plain text. Cloning also keeps this correct if the
      // chip's markup changes.
      const chip = echo?.querySelector('.chat__answer');
      // The result reports every answer, not only the last one.
      const words =
        id === 'step-result' && picks.size
          ? AXIS_IDS.filter((a) => picks.has(a)).map((a) => picks.get(a)!.label)
          : said;
      if (echo && chip && words.length) {
        echo.replaceChildren(
          ...words.map((label) => {
            const li = chip.cloneNode(false) as HTMLElement;
            li.textContent = label;
            return li;
          }),
        );
      }
      said = [];
      if (id === 'step-result') fillResult(stepEl);

      if (!revisiting) {
        transcript?.append(stepEl);
        play(stepEl);
      }
      // Only when the visitor advanced. Taking focus on first load would put
      // them past the skip link before they have done anything.
      if (advanced) stepEl.focus({ preventScroll: true });
    };

    document.addEventListener('click', (event) => {
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>(
        '.chat__choice[href^="#step-"]',
      );
      if (!link) return;
      link.closest<HTMLElement>('.chat__choices')?.setAttribute('hidden', '');

      const label = link.textContent?.trim() ?? '';
      said = [label];
      const axis = link.closest<HTMLElement>('[data-axis]')?.dataset.axis as
        AxisId | undefined;
      if (axis) picks.set(axis, { axis, id: link.dataset.value, label });
    });

    addEventListener('hashchange', () =>
      enter(location.hash.slice(1) || 'step-start'),
    );

    enter(
      location.hash.startsWith('#step-')
        ? location.hash.slice(1)
        : 'step-start',
      false,
    );
  }
</script>

<style is:global>
  /*
   * Global only because the script creates these spans after the scoped
   * styles have been hashed — a scoped rule would never match them.
   */
  .chat__char {
    opacity: 0;
    animation: chat-key 1ms linear forwards;
    animation-delay: calc(var(--start, 0ms) + var(--c) * 18ms);
  }

  @keyframes chat-key {
    to {
      opacity: 1;
    }
  }
</style>
