---
/** Figma component set `Project Bentos` (`639:1884`), all twelve combinations. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export type BentoImage = { src: ImageMetadata | string; alt: string };
export type ImageSlot =
  '0.8h' | '0.6h_l' | '0.6h_s' | '1_2_l' | '1_2_s' | '1_1' | '1_2';
type ExpandedSlot = ImageSlot | 'palette' | 'copy';
type CompactColumn = 'feature' | 'wide' | 'stack';
type Variant = '1' | '2' | '3' | '4' | '5' | '6';

interface Props {
  variant?: Variant;
  state?: 'default' | 'hover';
  /** Accessible project name; the only visible project label is HMW. */
  title: string;
  hmw?: string;
  href: string;
  /** Keys are the literal Figma frame names, not interchangeable crops. */
  images?: Partial<Record<ImageSlot, BentoImage>>;
  /** Positions correspond to color1…color8; absent colors do not take space. */
  colors?: readonly [
    string?,
    string?,
    string?,
    string?,
    string?,
    string?,
    string?,
    string?,
  ];
  class?: string;
}

const {
  variant = '1',
  state = 'default',
  title,
  hmw,
  href,
  images = {},
  colors = [],
  class: className,
} = Astro.props;
const label = hmw?.trim();
const compactColors = colors
  .slice(0, 4)
  .filter((color): color is string => Boolean(color));
const expandedColors = colors.filter((color): color is string =>
  Boolean(color),
);
const compactColumns: Record<Variant, readonly CompactColumn[]> = {
  '1': ['feature', 'wide', 'stack'],
  '2': ['wide', 'feature', 'stack'],
  '3': ['wide', 'stack', 'feature'],
  '4': ['feature', 'stack', 'wide'],
  '5': ['wide', 'stack', 'feature'],
  '6': ['stack', 'wide', 'feature'],
};
const expandedRows: Record<Variant, readonly (readonly ExpandedSlot[])[]> = {
  '1': [
    ['0.8h', '0.6h_l', 'palette'],
    ['1_1', '1_2', '0.6h_s', 'copy'],
  ],
  '2': [
    ['0.8h', 'palette', '0.6h_l'],
    ['copy', '1_1', '1_2', '0.6h_s'],
  ],
  '3': [
    ['copy', '1_1', '0.6h_s', '1_2'],
    ['palette', '0.8h', '0.6h_l'],
  ],
  '4': [
    ['0.6h_s', '1_2', 'copy', '1_1'],
    ['0.6h_l', '0.8h', 'palette'],
  ],
  '5': [
    ['0.6h_s', '1_2', '1_1', 'copy'],
    ['palette', '0.8h', '0.6h_l'],
  ],
  '6': [
    ['0.6h_l', 'palette', '0.8h'],
    ['0.6h_s', 'copy', '1_2', '1_1'],
  ],
};
const titleFirst = ['2', '3', '6'].includes(variant);
const squareFirst = !['4', '5'].includes(variant);
const pair: readonly ('palette' | '1_2_s')[] = ['1', '4', '5'].includes(variant)
  ? ['palette', '1_2_s']
  : ['1_2_s', 'palette'];
const hasCompactArt = Boolean(
  images['0.8h'] ||
  images['1_2_l'] ||
  images['1_1'] ||
  images['1_2_s'] ||
  compactColors.length,
);
const hasPair = Boolean(images['1_2_s'] || compactColors.length);
const rows = expandedRows[variant]
  .map((row) => ({
    large: row.includes('0.8h'),
    slots: row.filter(
      (slot) =>
        slot === 'copy' ||
        (slot === 'palette' ? expandedColors.length : images[slot]),
    ),
  }))
  .filter((row) => row.slots.length);
---

<a
  class:list={[
    'project-bento',
    !hasCompactArt && 'project-bento--text',
    className,
  ]}
  data-variant={variant}
  data-state={state}
  href={href}
  aria-label={`${title} — explore the project`}
>
  <div class="project-bento__compact">
    {
      compactColumns[variant].map((column) =>
        column === 'feature'
          ? (images['0.8h'] || label) && (
              <div
                class:list={[
                  'project-bento__feature',
                  titleFirst && 'project-bento__feature--title-first',
                ]}
              >
                {images['0.8h'] && (
                  <span class="project-bento__image" data-image-slot="0.8h">
                    {typeof images['0.8h'].src === 'string' ? (
                      <img src={images['0.8h'].src} alt={images['0.8h'].alt} />
                    ) : (
                      <Image
                        src={images['0.8h'].src}
                        alt={images['0.8h'].alt}
                      />
                    )}
                  </span>
                )}
                {label && <span class="project-bento__title">{label}</span>}
              </div>
            )
          : column === 'wide'
            ? images['1_2_l'] && (
                <span
                  class="project-bento__image project-bento__tall"
                  data-image-slot="1_2_l"
                >
                  {typeof images['1_2_l'].src === 'string' ? (
                    <img src={images['1_2_l'].src} alt={images['1_2_l'].alt} />
                  ) : (
                    <Image
                      src={images['1_2_l'].src}
                      alt={images['1_2_l'].alt}
                    />
                  )}
                </span>
              )
            : (images['1_1'] || hasPair) && (
                <div
                  class:list={[
                    'project-bento__stack',
                    !squareFirst && 'project-bento__stack--pair-first',
                  ]}
                >
                  {images['1_1'] && (
                    <span class="project-bento__image" data-image-slot="1_1">
                      {typeof images['1_1'].src === 'string' ? (
                        <img src={images['1_1'].src} alt={images['1_1'].alt} />
                      ) : (
                        <Image
                          src={images['1_1'].src}
                          alt={images['1_1'].alt}
                        />
                      )}
                    </span>
                  )}
                  {hasPair && (
                    <span class="project-bento__pair">
                      {pair.map((slot) =>
                        slot === 'palette'
                          ? compactColors.length > 0 && (
                              <span
                                class="project-bento__palette"
                                aria-hidden="true"
                              >
                                {compactColors.map((color) => (
                                  <span style={{ backgroundColor: color }} />
                                ))}
                              </span>
                            )
                          : images[slot] && (
                              <span
                                class="project-bento__image"
                                data-image-slot={slot}
                              >
                                {typeof images[slot].src === 'string' ? (
                                  <img
                                    src={images[slot].src}
                                    alt={images[slot].alt}
                                  />
                                ) : (
                                  <Image
                                    src={images[slot].src}
                                    alt={images[slot].alt}
                                  />
                                )}
                              </span>
                            ),
                      )}
                    </span>
                  )}
                </div>
              ),
      )
    }
    {
      !hasCompactArt && !label && (
        <span class="project-bento__fallback">explore the project</span>
      )
    }
  </div>
  <div class="project-bento__expanded">
    {
      rows.map(({ large, slots }) => (
        <div
          class:list={[
            'project-bento__row',
            large && 'project-bento__row--large',
            slots.length === 1 &&
              slots[0] === 'copy' &&
              'project-bento__row--copy-only',
          ]}
        >
          {slots.map((slot) =>
            slot === 'copy' ? (
              <span class="project-bento__copy">
                {label && <span class="project-bento__title">{label}</span>}
                <span class="project-bento__cta">explore the project</span>
              </span>
            ) : slot === 'palette' ? (
              <span class="project-bento__palette" aria-hidden="true">
                {expandedColors.map((color) => (
                  <span style={{ backgroundColor: color }} />
                ))}
              </span>
            ) : (
              images[slot] && (
                <span class="project-bento__image" data-image-slot={slot}>
                  {typeof images[slot].src === 'string' ? (
                    <img
                      src={images[slot].src as string}
                      alt={images[slot].alt}
                    />
                  ) : (
                    <Image
                      src={images[slot].src as ImageMetadata}
                      alt={images[slot].alt}
                    />
                  )}
                </span>
              )
            ),
          )}
        </div>
      ))
    }
  </div>
</a>

<style>
  /* Unbound geometry from 639:1878–1883 and 640:2022/643:2652–2656. */
  .project-bento {
    position: relative;
    display: block;
    inline-size: min(100%, 26.3125rem);
    color: var(--color-neutral-800);
    text-decoration: none;
  }

  .project-bento__compact {
    display: flex;
    gap: var(--space-xs);
    min-block-size: 13.125rem;
    overflow-x: clip;
    transition: opacity var(--duration-slow) var(--easing-standard);
  }

  .project-bento__expanded {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: var(--bento-offset, 0rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    inline-size: var(--bento-expanded-width, min(100vw, var(--grid-frame)));
    min-block-size: 13.125rem;
    padding-inline: var(--space-2xl);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--duration-slow) var(--easing-standard),
      visibility var(--duration-slow);
  }

  .project-bento:is([data-state='hover'], :hover, :focus-visible) {
    z-index: 1;
  }

  .project-bento:is([data-state='hover'], :hover, :focus-visible)
    .project-bento__compact {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .project-bento:is([data-state='hover'], :hover, :focus-visible)
    .project-bento__expanded {
    position: relative;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .project-bento:focus-visible .project-bento__expanded {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .project-bento__image,
  .project-bento__palette {
    position: relative;
    display: flex;
    flex: none;
    overflow: clip;
    border-radius: var(--radius-md);
  }

  .project-bento__image img {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .project-bento__feature,
  .project-bento__stack {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .project-bento__feature {
    inline-size: 47.2684%;
  }
  .project-bento__feature > * {
    inline-size: 100%;
  }
  .project-bento__feature .project-bento__image {
    flex: 1;
    min-block-size: var(--space-lg);
  }
  .project-bento__feature--title-first .project-bento__title,
  .project-bento__stack--pair-first .project-bento__pair {
    order: -1;
  }

  .project-bento__title {
    font-family: var(--font-serif);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
    letter-spacing: var(--letter-spacing-normal);
    overflow-wrap: anywhere;
  }

  .project-bento__tall {
    inline-size: 24.9406%;
    aspect-ratio: 1 / 2;
    align-self: flex-start;
  }
  .project-bento__stack {
    inline-size: 23.5154%;
  }
  .project-bento__stack > .project-bento__image {
    inline-size: 100%;
    aspect-ratio: 1;
  }
  .project-bento__pair {
    display: flex;
    gap: var(--space-xs);
    aspect-ratio: 1;
  }
  .project-bento__pair > * {
    inline-size: 44.4444%;
  }
  .project-bento__palette {
    flex-direction: column;
  }
  .project-bento__palette > span {
    flex: 1;
  }

  .project-bento__row {
    display: flex;
    gap: var(--space-md);
    min-block-size: 12.375rem;
  }
  .project-bento__row--large {
    min-block-size: 19.75rem;
  }
  .project-bento__expanded .project-bento__image,
  .project-bento__expanded .project-bento__palette {
    flex-shrink: 1;
    border-radius: var(--radius-lg);
  }
  .project-bento__expanded [data-image-slot='0.8h'] {
    inline-size: 38.6949%;
  }
  .project-bento__expanded [data-image-slot='0.6h_l'] {
    inline-size: 48.8971%;
  }
  .project-bento__expanded [data-image-slot='1_1'] {
    inline-size: 18.1985%;
  }
  .project-bento__expanded [data-image-slot='1_2'] {
    inline-size: 8.0882%;
  }
  .project-bento__expanded [data-image-slot='0.6h_s'] {
    inline-size: 28.4926%;
  }
  .project-bento__expanded .project-bento__palette {
    inline-size: 7.9963%;
  }

  .project-bento__copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    min-inline-size: 0;
    gap: var(--space-md);
    text-align: right;
  }
  .project-bento__copy .project-bento__title {
    color: var(--color-neutral-white);
    font-size: var(--font-size-xl);
  }
  .project-bento__row--copy-only {
    min-block-size: 0;
  }
  .project-bento__row--copy-only .project-bento__copy {
    max-inline-size: 26.3125rem;
    margin-inline-start: auto;
  }
  .project-bento--text .project-bento__compact {
    min-block-size: 0;
  }
  .project-bento--text .project-bento__expanded {
    min-block-size: 0;
  }
  .project-bento--text .project-bento__feature {
    inline-size: 100%;
  }
  .project-bento__fallback {
    text-decoration: underline;
  }

  /* One real anchor covers both the preview and its drawn primary CTA. */
  .project-bento__cta {
    padding: var(--space-xs) var(--space-lg);
    border-radius: var(--radius-lg);
    background: var(--color-lemon-500);
    box-shadow: var(--shadow-sm);
    color: var(--color-neutral-800);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-loose);
    letter-spacing: var(--letter-spacing-extra-wide);
  }

  @media (max-width: 48rem) {
    .project-bento__expanded {
      padding-inline: var(--space-md);
    }
    .project-bento__row {
      flex-wrap: wrap;
      min-block-size: 0;
    }
    .project-bento__expanded .project-bento__image {
      block-size: auto;
      align-self: flex-start;
    }
    .project-bento__expanded [data-image-slot='0.8h'] {
      inline-size: calc(50% - var(--space-xs));
      aspect-ratio: 421 / 316;
    }
    .project-bento__expanded [data-image-slot='0.6h_l'] {
      inline-size: calc(50% - var(--space-xs));
      aspect-ratio: 532 / 316;
    }
    .project-bento__expanded [data-image-slot='1_1'] {
      aspect-ratio: 1;
    }
    .project-bento__expanded [data-image-slot='1_2'] {
      aspect-ratio: 88 / 198;
    }
    .project-bento__expanded [data-image-slot='0.6h_s'] {
      aspect-ratio: 310 / 198;
    }
    .project-bento__expanded .project-bento__palette {
      min-block-size: var(--space-xl);
    }
    .project-bento__copy {
      flex-basis: 100%;
    }
  }
</style>
