---
/**
 * Figma component set `post-it` (`114:581`).
 *
 * The note is content supplied by its caller; this component owns only the
 * paper, pin colour, and Figma typography treatment.
 */
interface Props {
  /** Figma `Color`. */
  color?: 'herbs' | 'tomato' | 'lemon' | 'pickled';
  /** Optional destination; when present the whole note becomes a link. */
  href?: string;
  /** Additional class supplied by the composing page. */
  class?: string;
}

const { color = 'herbs', href, class: className } = Astro.props;
---

<article class:list={['post-it', `post-it--${color}`, className]}>
  {
    href ? (
      <a class="post-it__link" href={href}>
        <div class="post-it__paper">
          <div class="post-it__copy">
            <slot />
          </div>
        </div>
        <span class="post-it__dot" aria-hidden="true" />
      </a>
    ) : (
      <>
        <div class="post-it__paper">
          <div class="post-it__copy">
            <slot />
          </div>
        </div>
        <span class="post-it__dot" aria-hidden="true" />
      </>
    )
  }
</article>

<style>
  /*
   * Figma 114:577-114:580. Every length below is drawn geometry, not spacing:
   * the box is the rotated paper's bounding box plus the disc overhanging its
   * top edge, so each variant carries its own box, paper offset and disc
   * position. The paper itself is 181 × 181 in all four.
   */
  .post-it {
    position: relative;
    inline-size: var(--post-it-width);
    block-size: var(--post-it-height);
    /* Figma's rotation is counter-clockwise-positive, CSS's is clockwise, so
       the sign is inverted from the value the file shows. */
    rotate: var(--post-it-rotate);
    transition: rotate var(--duration-fast) var(--easing-standard);
  }

  .post-it:hover,
  .post-it:has(a:focus-visible) {
    rotate: calc(var(--post-it-rotate) + 8deg);
  }

  .post-it__link {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    color: inherit;
    text-decoration: none;
  }
  .post-it__paper {
    position: absolute;
    inset-block-start: var(--post-it-paper-y);
    inset-inline-start: var(--post-it-paper-x);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    inline-size: 181px;
    block-size: 181px;
    padding: var(--space-lg) var(--space-sm) var(--space-sm);
    overflow: clip;
    background-color: var(--color-neutral-white);
    box-shadow: var(--shadow-md);
    color: var(--color-neutral-800);
  }

  /* Figma 114:175 and its three siblings: a 40 disc, placed per variant. */
  .post-it__dot {
    position: absolute;
    inset-block-start: var(--post-it-dot-y);
    inset-inline-start: var(--post-it-dot-x);
    inline-size: 40px;
    block-size: 40px;
    border-radius: var(--radius-full);
  }

  .post-it--herbs {
    --post-it-width: 197px;
    --post-it-height: 211px;
    --post-it-paper-x: 8.14px;
    --post-it-paper-y: 22.42px;
    --post-it-rotate: -5deg;
    --post-it-dot-x: 104px;
    --post-it-dot-y: 0;
  }

  .post-it--tomato {
    --post-it-width: 192px;
    --post-it-height: 211px;
    --post-it-paper-x: 5.51px;
    --post-it-paper-y: 24.51px;
    --post-it-rotate: 3deg;
    --post-it-dot-x: 41px;
    --post-it-dot-y: 0;
  }

  .post-it--lemon {
    --post-it-width: 188px;
    --post-it-height: 222px;
    --post-it-paper-x: 3.67px;
    --post-it-paper-y: 37.33px;
    --post-it-rotate: -2deg;
    --post-it-dot-x: 32px;
    --post-it-dot-y: 18.5px;
  }

  .post-it--pickled {
    --post-it-width: 200px;
    --post-it-height: 227px;
    --post-it-paper-x: 9.04px;
    --post-it-paper-y: 36.06px;
    --post-it-rotate: 6deg;
    --post-it-dot-x: 43px;
    --post-it-dot-y: 11px;
  }

  .post-it--herbs .post-it__dot {
    background-color: var(--color-herbs-500);
  }

  .post-it--tomato .post-it__dot {
    background-color: var(--color-tomato-500);
  }

  .post-it--lemon .post-it__dot {
    background-color: var(--color-lemon-500);
  }

  .post-it--pickled .post-it__dot {
    background-color: var(--color-pickled-500);
  }

  /* Typography/Body - Small. */
  .post-it__copy {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-relaxed);
    letter-spacing: var(--letter-spacing-normal);
  }

  .post-it__copy :global(p) {
    max-width: none;
  }
</style>
