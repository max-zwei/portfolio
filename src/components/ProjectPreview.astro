    --scrap-height: var(--scrap-6-height);
    --scrap-rotation: var(--scrap-6-rotation);
  }

  @container project-previews (max-width: 665.135px) {
    .project-preview.project-preview--index {
      --preview-width: 220.522px;
      --preview-gap: var(--space-2xs);
