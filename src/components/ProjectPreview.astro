    --scrap-1-x: 64.674px;
    --scrap-1-y: 79.758px;
    --scrap-1-width: 150px;
    --scrap-1-height: 150px;
    --scrap-1-rotation: -8deg;
    --scrap-2-x: 15.679px;
    --scrap-2-y: 175.791px;
    --scrap-2-width: 150px;
    --scrap-2-height: 150px;
    --scrap-2-rotation: 6deg;
    --scrap-3-x: 368.828px;
    --scrap-3-y: 37.117px;
