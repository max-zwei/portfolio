      --scrap-5-width: 100px;
      --scrap-5-height: 56.25px;
      --scrap-5-rotation: 85deg;
      --scrap-6-x: 197.563px;
      --scrap-6-y: 28.463px;
      --scrap-6-width: 100px;
      --scrap-6-height: 56.25px;
      --scrap-6-rotation: 92deg;
    }
  }
</style>
