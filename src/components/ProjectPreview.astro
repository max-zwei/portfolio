  }

  .project-preview__text-envelope {
    padding-block: var(--text-envelope);
  }

  .project-preview__text {
    display: grid;
    overflow-wrap: anywhere;
    transform: rotate(var(--text-rotation));
    transition: transform var(--duration-slow) var(--easing-standard);
  }

  /* Figma Typography/Body; Captions for small. */
  .project-preview__caption {
    color: var(--color-neutral-600);
    font-family: var(--font-sans);
    font-size: var(--caption-size);
    font-weight: var(--font-weight-regular);
    line-height: var(--caption-line-height);
    letter-spacing: var(--letter-spacing-normal);
    text-transform: var(--caption-case);
  }

  /* Figma Typography/H4, H3 exploded, H5 small. */
  .project-preview__title {
    color: var(--color-neutral-800);
    font-family: var(--font-serif);
    font-size: var(--title-size);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-none);
    letter-spacing: var(--letter-spacing-normal);
  }

  .project-preview__scraps {
    position: relative;
    block-size: var(--collage-height);
  }

  .project-preview__scrap {
    --scrap-flip: 1;
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: var(--scrap-width);
    block-size: var(--scrap-height);
    overflow: hidden;
    transform-origin: top left;
    transform: translate(var(--scrap-x), var(--scrap-y))
      rotate(var(--scrap-rotation)) scaleY(var(--scrap-flip));
    transition: transform var(--duration-slow) var(--easing-standard);
  }

  .project-preview__scrap :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .project-preview__scrap--1 {
    --scrap-x: var(--scrap-1-x);
    --scrap-y: var(--scrap-1-y);
    --scrap-width: var(--scrap-1-width);
    --scrap-height: var(--scrap-1-height);
    --scrap-rotation: var(--scrap-1-rotation);
  }

  .project-preview__scrap--2 {
    --scrap-x: var(--scrap-2-x);
    --scrap-y: var(--scrap-2-y);
    --scrap-width: var(--scrap-2-width);
    --scrap-height: var(--scrap-2-height);
    --scrap-rotation: var(--scrap-2-rotation);
  }

  .project-preview__scrap--3 {
    --scrap-x: var(--scrap-3-x);
    --scrap-y: var(--scrap-3-y);
    --scrap-width: var(--scrap-3-width);
