---
/** Figma component set `project preview` (`114:646`); corrected small frame `562:5072`. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  id: string;
  state?: 'collapsed' | 'exploded';
  size?: 'default' | 'small';
  caption: string;
  title: string;
  /** Up to six artefacts, in source order; absent slots stay absent. */
  artefacts?: ReadonlyArray<{ src: ImageMetadata; alt: string }>;
  href?: string;
  class?: string;
}

const {
  id,
  state = 'collapsed',
  size = 'default',
  caption,
  title,
  artefacts = [],
  href,
  class: className,
} = Astro.props;
const visibleArtefacts = artefacts.slice(0, 6);
const ContentTag = href ? 'a' : 'div';
---

<article
  id={id}
  class:list={['project-preview', `project-preview--${size}`, className]}
  data-state={state}
>
  <ContentTag
    class="project-preview__content"
    href={href}
    aria-labelledby={href ? `${id}-caption ${id}-title` : undefined}
  >
    <div class="project-preview__text-envelope">
      <div class="project-preview__text">
        <span id={`${id}-caption`} class="project-preview__caption">
          {caption}
        </span>
        <span id={`${id}-title`} class="project-preview__title">
          {title}
        </span>
      </div>
    </div>
    {
      visibleArtefacts.length > 0 && (
        <div class="project-preview__scraps">
          {visibleArtefacts.map((artefact, index) => (
            <span
              class={`project-preview__scrap project-preview__scrap--${index + 1}`}
            >
              <Image src={artefact.src} alt={artefact.alt} />
            </span>
          ))}
        </div>
      )
    }
  </ContentTag>
</article>

<style>
  /* Unbound Figma collage geometry: 562:5259, 562:5297, 562:5072. */
  .project-preview {
    --preview-width: 426.759px;
    --preview-gap: var(--space-lg);
    --collage-height: 256.804px;
    --title-size: var(--font-size-lg);
    --caption-size: var(--font-size-base);
    --caption-line-height: var(--line-height-normal);
    --caption-case: none;
    --text-rotation: 0deg;
    --text-envelope: 0px;
    --scrap-1-x: 39px;
    --scrap-1-y: 43.776px;
    --scrap-1-width: 100px;
    --scrap-1-height: 100px;
    --scrap-1-rotation: -2deg;
    --scrap-2-x: 3.49px;
    --scrap-2-y: 117.286px;
    --scrap-2-width: 100px;
    --scrap-2-height: 100px;
    --scrap-2-rotation: 2deg;
    --scrap-3-x: 227.52px;
    --scrap-3-y: 57.001px;
    --scrap-3-width: 200px;
    --scrap-3-height: 112.5px;
    --scrap-3-rotation: 5deg;
    --scrap-4-x: 75.715px;
    --scrap-4-y: 129.952px;
    --scrap-4-width: 200px;
    --scrap-4-height: 112.5px;
    --scrap-4-rotation: -4deg;
    --scrap-5-x: 128.715px;
    --scrap-5-y: 9.805px;
    --scrap-5-width: 200px;
    --scrap-5-height: 112.5px;
    --scrap-5-rotation: 85deg;
    --scrap-6-x: 395.126px;
    --scrap-6-y: 56.926px;
    --scrap-6-width: 200px;
    --scrap-6-height: 112.5px;
    --scrap-6-rotation: 92deg;

    position: relative;
    inline-size: var(--preview-width);
    overflow: visible;
  }
  .project-preview__content {
    display: grid;
