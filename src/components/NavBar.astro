---
/**
 * Figma standalone `NavBar` (`210:1624`): the black site footer.
 */
import Button from './Button.astro';
import Icon from './Icon.astro';
import { EXPLORE_WITH, NAV, SOCIALS } from '../config/site';

interface Props {
  /**
   * Accessible name for the inner navigation landmark. `/styleguide` renders
   * two instances, and `unique-landmark: error` rejects two `<nav>` elements
   * that share an accessible name.
   */
  label?: string;
  /** Additional class names forwarded to the footer root. */
  class?: string;
}

const { label = 'Site', class: className } = Astro.props;
---

<footer class:list={['navbar', className]}>
  <nav class="navbar__row" aria-label={label}>
    <div class="navbar__legal">
      <Button
        type="nav"
        variant="secondary"
        href={NAV.impressum.href}
        class="navbar__link navbar__link--muted"
      >
        {NAV.impressum.label}
      </Button>

      <div class="navbar__explore">
        <p>explore with</p>
        <ul class="navbar__marks">
          {
            EXPLORE_WITH.map((mark) => (
              <li>
                <a
                  href={mark.href}
                  aria-label={`Explore with ${mark.label}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon icon={mark.icon} color="white" alt="" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="navbar__right">
      <ul class="navbar__list">
        {
          NAV.sections.map((link) => (
            <li>
              <Button
                type="nav"
                variant="primary"
                href={link.href}
                class="navbar__link"
              >
                {link.label}
              </Button>
            </li>
          ))
        }
      </ul>

      <div class="navbar__bottom">
        <ul class="navbar__list">
          {
            NAV.about.map((link) => (
              <li>
                <Button
                  type="nav"
                  variant={
                    link.label === 'behindthescenes' ? 'secondary' : 'primary'
                  }
                  href={link.href}
                  class:list={[
                    'navbar__link',
                    link.label === 'behindthescenes' && 'navbar__link--muted',
                  ]}
                >
                  {link.label}
                </Button>
              </li>
            ))
          }
        </ul>

        <ul class="navbar__socials">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  href={social.href}
                  aria-label={social.label}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon icon={social.icon} color="white" alt="" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>
</footer>

<style>
  /* The bar is the page frame's full width at every viewport; only its own
     64 / 40 padding holds the content in. */
  .navbar {
    width: 100%;
    padding: var(--space-lg) var(--space-xl);
    overflow: clip;
    background-color: var(--color-neutral-black);
    min-block-size: calc(var(--space-3xl) + var(--space-xl) + var(--space-xs));
  }

  /* Figma 114:189 `Left Section`: the legal column and the links section sit
     at the two ends of one row, both anchored to its top. */
  .navbar__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2xl);
    min-block-size: calc(var(--space-3xl) - var(--space-3xs));
  }

  /* Figma 114:190 `Impressum Container`: #impressum at the top, the explore
     credit at the bottom of the same column. */
  .navbar__legal {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-lg);
    align-self: stretch;
  }

  /* Figma 114:206 `Right Section`. */
  .navbar__right {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    gap: var(--space-2xl);
  }

  /* Figma 114:213 `Bottom Links Container`: the two about links at the top,
     the social marks at the bottom, level with the explore credit opposite. */
  .navbar__bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-lg);
    align-self: stretch;
  }

  .navbar__list,
  .navbar__marks,
  .navbar__socials {
    display: flex;
    padding: 0;
    list-style: none;
  }

  .navbar__list {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  /* The standalone black footer keeps legal/behind-the-scenes links muted. */
  .navbar :global(.btn.navbar__link) {
    color: var(--color-neutral-white);
  }

  .navbar :global(.btn.navbar__link--muted) {
    color: var(--color-neutral-600);
  }

  .navbar__explore {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-lemon-500);

    /* Typography/Mono - Small. */
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-loose);
    letter-spacing: var(--letter-spacing-extra-wide);
  }

  .navbar__marks {
    gap: var(--space-xs);
    align-items: flex-start;
  }

  .navbar__marks a,
  .navbar__socials a {
    display: inline-flex;
    border-radius: var(--radius-sm);
  }

  .navbar__marks a:hover :global(.icon),
  .navbar__marks a:focus-visible :global(.icon),
  .navbar__socials a:hover :global(.icon),
  .navbar__socials a:focus-visible :global(.icon) {
    filter: url(#md-lemon-alpha);
  }

  .navbar__socials {
    gap: var(--space-xs);
    align-items: center;
    padding-block-end: var(--space-3xs);
  }

  /* Figma's Mobile frame (`103:1103`) is empty. This is the one undesigned
     decision: a 1280px two-column row would otherwise overflow. */
  @media (max-width: 48rem) {
    .navbar__row,
    .navbar__right {
      flex-direction: column;
      gap: var(--space-lg);
    }
  }
</style>
