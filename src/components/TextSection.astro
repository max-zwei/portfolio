---
/** Figma standalone component `Text` (`114:636`). */
interface Props {
  /** Section heading. */
  title: string;
  /** Optional heading level to match the styleguide examples. */
  level?: 1 | 2 | 3 | 4;
  /** Additional class forwarded to the root section. */
  class?: string;
}

const { title, level = 2, class: className } = Astro.props;
const HeadingTag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4';
---

<section class:list={['text-section', className]} aria-label={title}>
  <!-- Figma text style: Typography/Title. -->
  <HeadingTag class="text-section__title">{title}</HeadingTag>
  <div class="text-section__body">
    <slot />
  </div>
</section>

<style>
  /* Figma 114:636: 310 / 532 columns, an unbound 135 gap and 64 padding. */
  .text-section {
    display: grid;
    grid-template-columns: minmax(0, 310px) minmax(0, 1fr);
    align-items: start;
    column-gap: 135px;
    row-gap: var(--space-md);
    container-type: inline-size;
    inline-size: 100%;
    max-inline-size: 1105px;
    min-inline-size: 0;
    padding: var(--space-xl);
    background-color: var(--color-neutral-100);
    border-radius: 0 var(--radius-xl) var(--radius-xl) var(--radius-xl);
    margin-inline-start: auto;
  }

  /* Typography/Title has no size or line-height variable in Figma. */
  .text-section__title {
    font-family: var(--font-serif);
    font-size: 108px;
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
    letter-spacing: var(--letter-spacing-normal);
    text-transform: uppercase;
    text-wrap: wrap;
    overflow-wrap: anywhere;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
    color: var(--color-neutral-black);
  }

  .text-section__body {
    min-inline-size: 0;
    overflow-wrap: anywhere;
    color: var(--color-neutral-800);
  }

  /* A desktop viewport can still place this panel inside a narrow parent. */
  @container (max-width: 48rem) {
    .text-section__title,
    .text-section__body {
      grid-column: 1 / -1;
    }
  }

  /* Reflow preserves all content when the drawn desktop columns cannot fit. */
  @media (max-width: 48rem) {
    .text-section {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-md);
      padding: var(--space-md);
    }
  }
</style>
