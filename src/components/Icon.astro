---
/** Figma component set `Icons` (`109:1374`). */
import { withBase } from '../config/site';
import square from './assets/icons/square.svg?url';
import perplexity from './assets/icons/perplexity.svg?url';
import anthropic from './assets/icons/anthropic.svg?url';
import openai from './assets/icons/openai.svg?url';
import figma from './assets/icons/figma.svg?url';
import github from './assets/icons/github.svg?url';
import dribbble from './assets/icons/dribbble.svg?url';
import behance from './assets/icons/behance.svg?url';
import linkedin from './assets/icons/linkedin.svg?url';

export type IconName =
  | 'cursor'
  | 'figma-make'
  | 'download'
  | 'share'
  | 'circle'
  | 'square'
  | 'triangle'
  | 'mail'
  | 'phone'
  | 'figma'
  | 'github'
  | 'dribbble'
  | 'behance'
  | 'linkedin'
  | 'anthropic'
  | 'openai'
  | 'perplexity';
type IconColor = 'black' | 'lemon' | 'herbs' | 'tomato' | 'white';

interface Props {
  /** Figma `Icon`. */
  icon: IconName;
  /** Figma `Color`. Defaults to the one colour the set draws for this icon. */
  color?: IconColor;
  /** Figma `State`. Only social and AI marks have hover variants. */
  state?: 'default' | 'hover';
  /** Required: an icon with no meaning is the caller's decision to make explicit. */
  alt: string;
  /** Additional classes applied to the image. */
  class?: string;
}

const ICONS = {
  // Figma `Icon=Cursor, Color=Lemon` (`109:1373`).
  cursor: { width: 40, height: 40, src: { lemon: '/cursor.svg' } },
  // Figma `Icon=Figma Make, Color=Black` (`140:1095`).
  'figma-make': {
    width: 56,
    height: 56,
    src: { black: '/icons/figma-make.svg' },
  },
  // Figma `Icon=download, Color=Black` (`377:2133`).
  download: { width: 28, height: 28, src: { black: '/icons/download.svg' } },
  // Figma `Icon=share, Color=Black` (`377:2143`).
  share: { width: 28, height: 28, src: { black: '/icons/share.svg' } },
  // Intrinsic dimensions follow the exported SVG canvases.
  circle: { width: 16, height: 16, src: { black: '/icons/circle.svg' } },
  square: { width: 19, height: 19, src: { tomato: square } },
  // Figma `Icon=triangle, Color=Herbs` (`476:1350`).
  triangle: {
    width: 30,
    height: 30,
    src: { herbs: '/icons/triangle.svg' },
  },
  // Figma `Icon=mail, Color=Black` (`484:2508`).
  mail: { width: 16, height: 16, src: { black: '/icons/mail.svg' } },
  // Figma `Icon=phone, Color=Black` (`492:2530`).
  phone: { width: 16, height: 16, src: { black: '/icons/phone.svg' } },
  // Figma social and AI marks, redrawn at a 16px height.
  figma: {
    width: 12,
    height: 16,
    src: { black: figma, white: '/icons/dark/figma.svg' },
  },
  github: {
    width: 17,
    height: 16,
    src: { black: github, white: '/icons/dark/github.svg' },
  },
  dribbble: {
    width: 16,
    height: 16,
    src: { black: dribbble, white: '/icons/dark/dribbble.svg' },
  },
  behance: {
    width: 19,
    height: 16,
    src: { black: behance, white: '/icons/dark/behance.svg' },
  },
  linkedin: {
    width: 17,
    height: 16,
    src: { black: linkedin, white: '/icons/dark/linkedin.svg' },
  },
  anthropic: {
    width: 16,
    height: 16,
    src: {
      black: anthropic,
      white: '/icons/dark/explore-claude.svg',
    },
  },
  openai: {
    width: 17,
    height: 16,
    src: {
      black: openai,
      white: '/icons/dark/explore-openai.svg',
    },
  },
  perplexity: {
    width: 16,
    height: 16,
    src: {
      black: perplexity,
      white: '/icons/dark/explore-3.svg',
    },
  },
} as const satisfies Record<
  IconName,
  { width: number; height: number; src: Partial<Record<IconColor, string>> }
>;

const { icon, color, state = 'default', alt, class: className } = Astro.props;
const asset = ICONS[icon];
const src_ = asset.src as Partial<Record<IconColor, string>>;
const names = Object.keys(src_) as IconColor[];
const resolved = color ?? names[0];
const src = src_[resolved];
const hasHover = [
  'figma',
  'github',
  'dribbble',
  'behance',
  'linkedin',
  'anthropic',
  'openai',
  'perplexity',
].includes(icon);

if (!src) {
  throw new Error(`Icons has no \`Icon=${icon}, Color=${resolved}\` variant.`);
}

if (state === 'hover' && !hasHover) {
  throw new Error(`Icons has no \`Icon=${icon}, State=Hover\` variant.`);
}
---

<img
  src={src.startsWith('/icons/') || src === '/cursor.svg' ? withBase(src) : src}
  alt={alt}
  width={asset.width}
  height={asset.height}
  class:list={['icon', state === 'hover' && 'icon--hover', className]}
/>

<style>
  .icon--hover {
    /* Each shared glow layer starts from SourceAlpha, rather than shadowing the
       previous layer as chained drop-shadow() filters would. */
    filter: url(#md-lemon-alpha);
  }
</style>
