---
/** Figma component set `Tech` (`477:2462`). */
import { withBase } from '../config/site';

interface Tool {
  /** Tool name: image alt text when an icon exists, visible text otherwise. */
  name: string;
  /** Optional public asset path; absent intentionally leaves the tile icon-free. */
  icon?: string;
}

interface Props {
  /** Section heading; defaults to the heading drawn in Figma. */
  title?: string;
  /** Tool tiles to render. An empty array intentionally renders no list. */
  tools: ReadonlyArray<Tool>;
  /** Figma `Usage`. */
  usage?: 'web' | 'pdf';
  /** Optional heading level to match the styleguide examples. */
  level?: 2 | 3 | 4;
  /** Additional class forwarded to the root section. */
  class?: string;
}

const {
  title = 'Tech & Tools',
  tools,
  usage = 'web',
  level = 2,
  class: className,
} = Astro.props;
const HeadingTag = `h${level}` as 'h2' | 'h3' | 'h4';

/* Intrinsic asset boxes from Web 533:3380 and PDF 533:3515, not square tiles. */
const iconBoxes: Record<string, readonly [number, number, number, number]> = {
  'lucid.svg': [38.186, 40.923, 26.594, 28.5],
  'figma.svg': [20, 30, 12.5, 18.75],
  'jira.svg': [30, 30, 18.75, 18.75],
  'userguiding.png': [38.186, 37.831, 26.594, 26.346],
  'miro.svg': [30.189, 30.189, 18.868, 18.868],
  'notion.svg': [30, 30, 18.75, 18.75],
  'atlassian.svg': [30, 30, 18.75, 18.75],
  'tool-08.png': [38.186, 38.186, 26.594, 26.594],
  'tool-09.svg': [30.189, 34.07, 18.868, 21.294],
  'tool-10.png': [38.186, 38.186, 26.594, 26.594],
  'asana.svg': [30.189, 27.444, 18.868, 17.153],
  'webflow.svg': [38.186, 23.546, 26.594, 16.398],
  'tool-13.svg': [30, 15.849, 18.75, 9.906],
  'wordpress.png': [38.186, 37.831, 26.594, 26.346],
  'visio.png': [38.186, 36.396, 26.594, 25.347],
  'marvel.png': [38.186, 37.831, 26.594, 26.346],
  'github-tool.svg': [38.186, 37.059, 26.594, 25.809],
  'excel.png': [38.186, 35.561, 26.594, 24.765],
  'tool-19.svg': [30.189, 30.189, 18.868, 18.868],
  'canva.png': [38.186, 37.831, 26.594, 26.346],
};
const boxOffset = usage === 'pdf' ? 2 : 0;
---

<section
  class:list={['toolbox', `toolbox--${usage}`, className]}
  aria-label={title}
>
  <HeadingTag class="toolbox__title">{title}</HeadingTag>
  <slot />
  {
    tools.length > 0 && (
      <ul class="toolbox__tools">
        {tools.map((tool) => {
          const box = tool.icon && iconBoxes[tool.icon.split('/').pop() ?? ''];
          return (
            <li class="toolbox__tool">
              {tool.icon ? (
                <img
                  src={withBase(tool.icon)}
                  alt={tool.name}
                  style={
                    box
                      ? {
                          inlineSize: `${box[boxOffset]}px`,
                          blockSize: `${box[boxOffset + 1]}px`,
                        }
                      : undefined
                  }
                />
              ) : (
                <span>{tool.name}</span>
              )}
            </li>
          );
        })}
      </ul>
    )
  }
</section>

<style>
  .toolbox {
    display: grid;
    /* Figma Web and PDF variants share a 24 gap. */
    gap: var(--space-md);
  }

  /* Figma Web 114:685: the intrinsic grid plus 40 padding on each side. */
  .toolbox--web {
    inline-size: calc(411.302307px + 2 * var(--space-lg));
    max-inline-size: 100%;
    min-inline-size: 0;
    padding: var(--space-lg);
    overflow-wrap: anywhere;
    background-color: var(--color-neutral-100);
    border-radius: 0 var(--radius-xl) var(--radius-xl) var(--radius-xl);
  }

  .toolbox--web .toolbox__tools {
    /* The widest intrinsic Web mark sets the track floor; never shrink assets. */
    grid-template-columns: repeat(auto-fill, minmax(38.186px, 1fr));
  }

  /* Typography/H2 uses an unbound 1.2 line height. */
  .toolbox__title {
    font-family: var(--font-serif);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
    letter-spacing: var(--letter-spacing-normal);
    color: var(--color-neutral-black);
  }

  .toolbox__tools {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--space-md);
    inline-size: 411.302307px;
    max-inline-size: 100%;
    padding: 0;
    list-style: none;
  }

  .toolbox__tool {
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 0;
    text-align: center;
  }

  .toolbox__tool img {
    object-fit: contain;
    max-inline-size: 100%;
  }

  /*
   * Preserve the seven-column web matrix, then reduce it to two columns at the
   * site's sole breakpoint so tiles stay useful on narrow screens. The source
   * design has no readable mobile frame. Scoped to web so the eleven-column
   * print grid is never collapsed by a print viewport under 48rem.
   */
  @media (max-width: 48rem) {
    .toolbox--web .toolbox__tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Figma 533:3515: eleven columns; native marks are scaled to 62.5%. */
  .toolbox--pdf .toolbox__title {
    font-size: var(--font-size-xl);
  }

  .toolbox--pdf .toolbox__tools {
    grid-template-columns: repeat(11, minmax(0, 1fr));
    gap: var(--space-xs);
    inline-size: 412.529053px;
  }
</style>
