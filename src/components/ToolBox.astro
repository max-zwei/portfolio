---
/** Figma component set `Tech&Tools` (`477:2462`). */
import { withBase } from '../config/site';

interface Tool {
  /** Tool name: image alt text when an icon exists, visible text otherwise. */
  name: string;
  /** Optional public asset path; absent intentionally leaves the tile icon-free. */
  icon?: string;
}

interface Props {
  /** Section heading; defaults to the heading drawn in Figma. */
  title?: string;
  /** Tool tiles to render. An empty array intentionally renders no list. */
  tools: ReadonlyArray<Tool>;
  /** Figma `Usage`. */
  usage?: 'web' | 'pdf';
  /** Optional heading level to match the styleguide examples. */
  level?: 2 | 3 | 4;
  /** Additional class forwarded to the root section. */
  class?: string;
}

const {
  title = 'Tech & Tools',
  tools,
  usage = 'web',
  level = 2,
  class: className,
} = Astro.props;
const HeadingTag = `h${level}` as 'h2' | 'h3' | 'h4';

/*
 * Source prose is markdown held in content-collection frontmatter. When prose
 * accompanies this organism, the page renders it through the default slot and
 * the component only lays it out; tool records remain the component's data.
 */
---

<section class:list={['toolbox', `toolbox--${usage}`, className]}>
  <HeadingTag class="toolbox__title">{title}</HeadingTag>
  <slot />
  {
    tools.length > 0 && (
      <ul class="toolbox__tools">
        {tools.map((tool) => (
          <li class="toolbox__tool">
            {tool.icon ? (
              <img src={withBase(tool.icon)} alt={tool.name} />
            ) : (
              <span>{tool.name}</span>
            )}
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .toolbox {
    display: grid;
    /* Token-chosen while Figma is unreachable; not a value read from the set. */
    gap: var(--space-md);
  }

  .toolbox__title {
    font-size: var(--font-size-3xl);
  }

  .toolbox__tools {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--space-md);
    padding: 0;
    list-style: none;
  }

  .toolbox__tool {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 38px;
    block-size: 38px;
    text-align: center;
  }

  .toolbox__tool img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  /*
   * Preserve the seven-column web matrix, then reduce it to two columns at the
   * site's sole breakpoint so tiles stay useful on narrow screens. The source
   * design has no readable mobile frame. Scoped to web so the eleven-column
   * print grid is never collapsed by a print viewport under 48rem.
   */
  @media (max-width: 48rem) {
    .toolbox--web .toolbox__tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Figma 533:3380 (Usage=PDF): eleven equal columns with 27px logo boxes. */
  .toolbox--pdf .toolbox__title {
    font-size: var(--font-size-xl);
  }

  .toolbox--pdf .toolbox__tools {
    grid-template-columns: repeat(11, minmax(0, 1fr));
    gap: var(--space-xs);
  }

  .toolbox--pdf .toolbox__tool {
    inline-size: 27px;
    block-size: 27px;
  }
</style>
