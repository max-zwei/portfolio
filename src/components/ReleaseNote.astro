---
/** Figma component set `Release Notes` (`115:706`). */
import Button from './Button.astro';

interface Props {
  state?: 'active' | 'inactive';
  date: Date;
  description?: string;
  level?: 2 | 3 | 4;
  /** Attachment reached by the closing button. */
  fileHref?: string;
  class?: string;
}

const {
  state = 'active',
  date,
  description,
  level = 2,
  fileHref,
  class: className,
} = Astro.props;
const HeadingTag = `h${level}` as 'h2' | 'h3' | 'h4';
const SubheadingTag = `h${level + 1}` as 'h3' | 'h4' | 'h5';
const formattedDate = date.toISOString().slice(0, 10);
const hasUserExperience = Astro.slots.has('userExperience');
const hasUserInterface = Astro.slots.has('userInterface');
const hasTools = Astro.slots.has('tools');
---

<article
  class:list={['release-note', `release-note--${state}`, className]}
  data-release-note
>
  <span class="release-note__rail" aria-hidden="true">
    <span class="release-note__dot"></span>
  </span>
  <div class="release-note__body">
    <div class="release-note__content">
      <header class="release-note__header">
        <HeadingTag class="release-note__date">
          <span aria-hidden="true">&lt; &gt; </span><time
            datetime={formattedDate}>{formattedDate}</time
          ><span aria-hidden="true"> &lt; / &gt;</span>
        </HeadingTag>
        {description && <p class="release-note__description">{description}</p>}
      </header>
      {
        hasUserExperience && (
          <section class="release-note__change" aria-label="user experience">
            <SubheadingTag class="release-note__label">
              user experience
            </SubheadingTag>
            <div class="release-note__copy">
              <slot name="userExperience" />
            </div>
          </section>
        )
      }
      {
        hasUserInterface && (
          <section class="release-note__change" aria-label="user interface">
            <SubheadingTag class="release-note__label">
              user interface
            </SubheadingTag>
            <div class="release-note__copy">
              <slot name="userInterface" />
            </div>
          </section>
        )
      }
      {
        hasTools && (
          <section class="release-note__change" aria-label="tools">
            <SubheadingTag class="release-note__label">tools</SubheadingTag>
            <div class="release-note__copy">
              <slot name="tools" />
            </div>
          </section>
        )
      }
    </div>
    {
      fileHref && (
        <div class="release-note__file">
          <Button type="primary" href={fileHref}>
            go back in time
          </Button>
        </div>
      )
    }
  </div>
</article>

<style>
  /* Figma 655:3769 / 115:704: the 95 gap is unbound. */
  .release-note {
    display: grid;
    grid-template-columns: var(--space-sm) minmax(0, 1fr);
    column-gap: 95px;
    color: var(--color-neutral-800);
  }

  .release-note__rail {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-md);
    justify-items: center;
    padding-block: var(--space-3xs) var(--space-md);
  }

  .release-note__dot {
    inline-size: var(--space-sm);
    block-size: var(--space-sm);
    border-radius: var(--radius-full);
    background-color: var(--color-neutral-black);
  }

  /* Figma 655:3772 is a one-unit black → neutral-300 gradient stroke. */
  .release-note__rail::after {
    content: '';
    inline-size: 1px;
    block-size: 100%;
    background: linear-gradient(
      var(--color-neutral-black),
      var(--color-neutral-300)
    );
  }

  .release-note__body {
    display: grid;
    min-inline-size: 0;
    gap: var(--space-lg);
    padding-block-end: var(--space-3xl);
  }

  .release-note__content {
    display: grid;
    gap: var(--space-md);
  }

  .release-note__header,
  .release-note__change {
    display: grid;
    gap: var(--space-3xs);
  }

  .release-note__date,
  .release-note__label {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-loose);
    letter-spacing: var(--letter-spacing-extra-wide);
  }

  .release-note__date {
    font-weight: var(--font-weight-bold);
    color: var(--color-neutral-black);
  }

  .release-note__label {
    font-weight: var(--font-weight-regular);
    color: inherit;
  }

  .release-note__description,
  .release-note__copy {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-normal);
    letter-spacing: var(--letter-spacing-normal);
  }

  .release-note__description,
  .release-note__copy :global(p) {
    max-inline-size: none;
  }

  .release-note__file {
    justify-self: start;
  }

  .release-note--inactive,
  .release-note--inactive .release-note__date {
    color: var(--color-neutral-600);
  }

  .release-note--inactive .release-note__dot {
    background-color: var(--color-neutral-300);
  }

  .release-note--inactive .release-note__rail::after {
    background: var(--color-neutral-200);
  }

  /* Inactive is a visual timeline state, not a disabled attachment link. */
  .release-note--inactive :global(.btn--primary) {
    background-color: var(--color-lemon-100);
    color: var(--color-neutral-600);
  }

  @media (max-width: 48rem) {
    .release-note {
      column-gap: var(--space-md);
    }
  }
</style>
