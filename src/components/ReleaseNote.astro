---
/**
 * Figma component set `release notes` (`115:706`).
 * Re-read from Figma on 2026-09-22.
 *
 * The design names its third content block `tools`, while the release-note
 * schema calls that field `tech`. This slot keeps the design's name at the
 * component boundary.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { withBase } from '../config/site';
import Button from './Button.astro';

interface Props {
  /** Figma `State`. */
  state?: 'active' | 'inactive';
  /** The release date shown in the frame's header chrome. */
  date: Date;
  /** One sentence under the date describing the release. */
  description?: string;
  /** Screenshots shown in the fixed-size slideshow. */
  screenshots?: ReadonlyArray<{ src: ImageMetadata; alt: string }>;
  /** Optional heading level to match the surrounding document outline. */
  level?: 2 | 3 | 4;
  /** Present → renders the closing button, linking to the release's attachment. */
  fileHref?: string;
  class?: string;
}

const {
  state = 'active',
  date,
  description,
  screenshots = [],
  level = 2,
  fileHref,
  class: className,
} = Astro.props;

const HeadingTag = `h${level}` as 'h2' | 'h3' | 'h4';

const formattedDate = date.toISOString().slice(0, 10);

const hasUserExperience = Astro.slots.has('userExperience');
const hasUserInterface = Astro.slots.has('userInterface');
const hasTools = Astro.slots.has('tools');
---

<article
  class:list={['release-note', `release-note--${state}`, className]}
  data-release-note
>
  <span class="release-note__rail" aria-hidden="true">
    <span
      class="release-note__dot"
      style={`--release-note-dot: url('${withBase('/icons/circle.svg')}')`}
    ></span>
  </span>

  <div class="release-note__body">
    <div class="release-note__content">
      <header class="release-note__header">
        <HeadingTag class="release-note__date">
          <span aria-hidden="true">&lt; &gt; </span><time
            datetime={formattedDate}>{formattedDate}</time
          ><span aria-hidden="true"> &lt; / &gt;</span>
        </HeadingTag>
        {description && <p class="release-note__description">{description}</p>}
      </header>

      {
        hasUserExperience && (
          <section class="release-note__change">
            <p class="release-note__label">user experience</p>
            <div class="release-note__copy">
              <slot name="userExperience" />
            </div>
          </section>
        )
      }

      {
        hasUserInterface && (
          <section class="release-note__change">
            <p class="release-note__label">user interface</p>
            <div class="release-note__copy">
              <slot name="userInterface" />
            </div>
          </section>
        )
      }

      {
        hasTools && (
          <section class="release-note__change">
            <p class="release-note__label">tools</p>
            <div class="release-note__copy">
              <slot name="tools" />
            </div>
          </section>
        )
      }
    </div>

    {
      screenshots.length > 0 && (
        <div
          class="release-note__screenshots"
          data-artefact-strip
          role="group"
          aria-label={`Screenshots from ${formattedDate}`}
          tabindex="0"
        >
          {screenshots.map((screenshot) => (
            <figure class="release-note__screenshot">
              <Image src={screenshot.src} alt={screenshot.alt} />
            </figure>
          ))}
        </div>
      )
    }

    {
      fileHref && (
        <div class="release-note__file">
          <Button type="primary" href={fileHref}>
            go back in time
          </Button>
        </div>
      )
    }
  </div>
</article>

<script>
  import '../lib/artefact-strip';
</script>

<style>
  .release-note {
    display: grid;
    grid-template-columns: var(--space-sm) minmax(0, 1fr);
    column-gap: var(--space-lg);
    color: var(--color-neutral-800);
    transition: color var(--duration-slow) var(--easing-standard);
  }

  .release-note__rail {
    display: grid;
    grid-template-rows: auto 1fr;
    row-gap: var(--space-xl);
    justify-items: center;
    padding-block-start: var(--space-3xs);
  }

  /*
   * The Icons set holds one circle, in black (`476:522`). Masking that single
   * export lets the inactive state take its own token colour without a second
   * file whose fill nobody drew.
   */
  .release-note__dot {
    width: var(--space-sm);
    height: var(--space-sm);
    background-color: var(--color-neutral-black);
    mask: var(--release-note-dot) center / contain no-repeat;
    transition: background-color var(--duration-slow) var(--easing-standard);
  }

  .release-note__rail::after {
    content: '';
    width: 1px;
    height: 100%;
    background-color: var(--color-neutral-200);
    transition: background-color var(--duration-slow) var(--easing-standard);
  }

  .release-note__body {
    display: grid;
    min-width: 0;
    gap: var(--space-lg);
  }

  /* Figma hugs the text at 859px; eight columns of the page grid is 865.6px. */
  .release-note__content {
    display: grid;
    gap: var(--space-md);
    max-width: calc(8 * var(--grid-column) + 7 * var(--grid-gutter));
  }

  .release-note__header,
  .release-note__change {
    display: grid;
    gap: var(--space-3xs);
  }

  /* Typography/Mono - Small, with the date node's Bold override (`114:337`). */
  .release-note__date {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-loose);
    letter-spacing: var(--letter-spacing-extra-wide);
  }

  /* Typography/Mono - Small. */
  .release-note__label {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-loose);
    letter-spacing: var(--letter-spacing-extra-wide);
  }

  /* Typography/Body. */
  .release-note__description,
  .release-note__copy {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-normal);
    letter-spacing: var(--letter-spacing-normal);
  }

  .release-note__copy :global(p) {
    max-width: none;
  }

  .release-note__screenshots {
    display: flex;
    gap: var(--space-sm);
    overflow-x: auto;
  }

  /* Slide box 320 × 180 (`I476:78;114:349`) — no size token holds it. */
  .release-note__screenshot {
    flex: 0 0 auto;
    inline-size: 320px;
    aspect-ratio: 320 / 180;
    margin: 0;
    background-color: var(--color-neutral-black);
    transition: background-color var(--duration-slow) var(--easing-standard);
  }

  .release-note__screenshot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .release-note__file {
    justify-self: start;
  }

  /*
   * Transcribed from the inactive variant (`476:111`), which the previous port
   * could not reach: text, dot and slide ground --color-neutral-600, rail line
   * --color-neutral-100, button ground --color-lemon-100. neutral-600 on the
   * neutral-white ground does not reach AA for text — that is the design's
   * decision (L1), and the same one /resume makes when it dims to neutral-300.
   */
  .release-note--inactive {
    color: var(--color-neutral-600);
  }

  .release-note--inactive .release-note__dot {
    background-color: var(--color-neutral-600);
  }

  .release-note--inactive .release-note__rail::after {
    background-color: var(--color-neutral-100);
  }

  .release-note--inactive .release-note__screenshot {
    background-color: var(--color-neutral-600);
  }

  .release-note--inactive :global(.btn--primary) {
    background-color: var(--color-lemon-100);
    color: var(--color-neutral-600);
  }

  /* Longhand replaces .btn--primary's own transition; its box-shadow leg is
     restated rather than lost. */
  .release-note :global(.btn--primary) {
    transition:
      color var(--duration-slow) var(--easing-standard),
      background-color var(--duration-slow) var(--easing-standard),
      box-shadow var(--duration-fast) var(--easing-standard);
  }
</style>
