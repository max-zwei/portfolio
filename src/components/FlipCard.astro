---
/** Figma component set `flipcard` (`114:569`). */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  /** Required identity used to connect both controls to the back face. */
  id: string;
  /** Figma `State`; also the face rendered when JavaScript is available. */
  state?: 'front' | 'back' | 'small';
  /** Playground-card title on both faces. */
  title: string;
  /** Front-face artwork, either an Astro image import or a URL. */
  teaser?: ImageMetadata | string;
  /**
   * Alternative text for the teaser when one is present. Pass an explicit
   * empty string only when the teaser is genuinely decorative.
   */
  teaserAlt?: string;
  /** Present → renders the GitHub mark as a link. */
  githubUrl?: string;
  /** Present → renders the Figma mark as a link. */
  figmaUrl?: string;
  /** Anything that is neither GitHub nor Figma; takes CTA precedence. */
  additionalUrl?: string;
  /** Additional class supplied by the composing page. */
  class?: string;
}

const {
  id,
  state = 'front',
  title,
  teaser,
  teaserAlt,
  githubUrl,
  figmaUrl,
  additionalUrl,
  class: className,
} = Astro.props;

if (teaser !== undefined && teaserAlt === undefined) {
  throw new Error(
    `FlipCard "${id}" has a teaser without alternative text; pass teaserAlt; pass an empty string only if the teaser is genuinely decorative.`,
  );
}

const frontId = `${id}-front`;
const backId = `${id}-back`;
const destination = additionalUrl ?? githubUrl ?? figmaUrl;
const initialFace = state === 'back' ? 'back' : 'front';
const size = state === 'small' ? 'small' : undefined;
const ratio =
  teaser && typeof teaser !== 'string' ? teaser.width / teaser.height : 2 / 3;
---

<article
  class:list={['flipcard', className]}
  data-flipcard
  data-state={initialFace}
  data-size={size}
  style={`--flipcard-ratio: ${ratio}`}
>
  <div class="flipcard__stage" data-flipcard-stage>
    <div id={frontId} class="flipcard__face flipcard__front">
      {
        teaser ? (
          typeof teaser === 'string' ? (
            <img
              class="flipcard__teaser"
              data-string-teaser
              src={teaser}
              alt={teaserAlt}
            />
          ) : (
            <Image
              class="flipcard__teaser"
              src={teaser}
              alt={teaserAlt ?? ''}
            />
          )
        ) : (
          <div class="flipcard__teaser flipcard__teaser--title">
            <span class="flipcard__title">{title}</span>
          </div>
        )
      }

      <button
        type="button"
        class="flipcard__flip flipcard__flip--front"
        aria-controls={backId}
      >
        <span class="visually-hidden">Show the back of {title}</span>
      </button>
    </div>

    <div id={backId} class="flipcard__face flipcard__back">
      <button
        type="button"
        class="flipcard__flip flipcard__flip--back"
        aria-controls={frontId}
      >
        <span class="visually-hidden">Show the front of {title}</span>
      </button>

      <div class="flipcard__back-content">
        <div class="flipcard__copy">
          <h3 class="flipcard__title">{title}</h3>
          <div class="flipcard__summary"><slot /></div>
        </div>

        {
          destination && (
            <footer
              class:list={[
                'flipcard__footer',
                !(figmaUrl || githubUrl) && 'flipcard__footer--link-only',
              ]}
            >
              {(figmaUrl || githubUrl) && (
                <ul class="flipcard__marks" aria-label="Project links">
                  {figmaUrl && (
                    <li>
                      <a
                        href={figmaUrl}
                        aria-label={`${title} on Figma`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <Icon icon="figma" color="black" alt="" />
                      </a>
                    </li>
                  )}
                  {githubUrl && (
                    <li>
                      <a
                        href={githubUrl}
                        aria-label={`${title} on GitHub`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <Icon icon="github" color="black" alt="" />
                      </a>
                    </li>
                  )}
                </ul>
              )}

              <Button
                type="secondary"
                href={destination}
                target="_blank"
                rel="noopener noreferrer"
              >
                Check it out →
              </Button>
            </footer>
          )
        }
      </div>
    </div>
  </div>
</article>

<script>
  document.documentElement.classList.add('js');

  document.querySelectorAll<HTMLElement>('[data-flipcard]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('.flipcard__flip');
    const front = root.querySelector<HTMLElement>('.flipcard__front');
    const back = root.querySelector<HTMLElement>('.flipcard__back');
    const backContent = back?.querySelector<HTMLElement>(
      '.flipcard__back-content',
    );

    const syncFaces = () => {
      const failed = root.hasAttribute('data-fit-failed');
      if (front) front.inert = !failed && root.dataset.state === 'back';
      if (back) back.inert = !failed && root.dataset.state !== 'back';
    };

    // The Figma base width grows uniformly at the teaser's natural aspect ratio.
    const fitBack = () => {
      if (!backContent || root.dataset.size === 'small') return;
      root.removeAttribute('data-fit-failed');
      const setScale = (scale: number) => {
        root.style.setProperty('--flipcard-inline-size', `${200 * scale}px`);
      };
      const overflows = () =>
        backContent.scrollHeight > backContent.clientHeight + 1 ||
        backContent.scrollWidth > backContent.clientWidth + 1;

      let low = 1;
      let high = 1;
      setScale(high);
      for (let attempt = 0; attempt < 16 && overflows(); attempt += 1) {
        low = high;
        high *= 1.25;
        setScale(high);
      }
      // Bisection requires a fitting upper bound, not two overflowing endpoints.
      if (overflows()) {
        root.setAttribute('data-fit-failed', '');
        root.style.removeProperty('--flipcard-inline-size');
        syncFaces();
        return;
      }
      for (let attempt = 0; attempt < 10 && high > low; attempt += 1) {
        const middle = (low + high) / 2;
        setScale(middle);
        if (overflows()) low = middle;
        else high = middle;
      }
      setScale(high);
      syncFaces();
    };

    let frame = 0;
    const scheduleFit = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        fitBack();
      });
    };
    const image = root.querySelector<HTMLImageElement>('[data-string-teaser]');
    const imageReady = () => {
      if (image && image.naturalWidth > 0 && image.naturalHeight > 0) {
        root.style.setProperty(
          '--flipcard-ratio',
          String(image.naturalWidth / image.naturalHeight),
        );
        scheduleFit();
      }
    };
    image?.addEventListener('load', imageReady);
    if (image?.complete) imageReady();
    window.addEventListener('resize', scheduleFit);

    const setState = (state: 'front' | 'back') => {
      root.dataset.state = state;
      syncFaces();
    };

    scheduleFit();
    document.fonts.ready.then(scheduleFit);
    setState(root.dataset.state === 'back' ? 'back' : 'front');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const next = root.dataset.state === 'back' ? 'front' : 'back';
        setState(next);
        // Commit the revealed face before focusing, including near-zero motion.
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            if (root.dataset.state !== next) return;
            (next === 'back' ? back : front)
              ?.querySelector<HTMLButtonElement>('.flipcard__flip')
              ?.focus();
          }),
        );
      });
    });
  });
</script>

<style>
  .flipcard {
    --flipcard-inline-size: 200px;
    --flipcard-block-size: calc(
      var(--flipcard-inline-size) / var(--flipcard-ratio)
    );
    --flipcard-radius: var(--radius-md);
    --flipcard-shadow: var(--shadow-lg);

    position: relative;
    display: grid;
    inline-size: var(--flipcard-inline-size);
    color: var(--color-neutral-black);
  }

  .flipcard__stage {
    display: grid;
    inline-size: 100%;
  }

  .flipcard__face {
    display: grid;
    min-block-size: var(--flipcard-block-size);
    overflow: hidden;
    border-radius: var(--flipcard-radius);
    box-shadow: var(--flipcard-shadow);
  }

  .flipcard__front {
    position: relative;
    block-size: var(--flipcard-block-size);
  }

  .flipcard__back {
    position: relative;
    display: flex;
    padding: var(--space-xs) var(--space-sm);
    background-color: var(--color-neutral-100);
  }

  :global(html.js) .flipcard:not([data-fit-failed]) {
    block-size: var(--flipcard-block-size);
    perspective: calc(8 * var(--space-3xl));
  }

  :global(html.js) .flipcard:not([data-fit-failed]) .flipcard__stage,
  :global(html.js) .flipcard:not([data-fit-failed]) .flipcard__face {
    block-size: 100%;
    min-block-size: 0;
  }

  :global(html.js) .flipcard:not([data-fit-failed]) .flipcard__face {
    grid-area: 1 / 1;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transform-origin: right bottom;
    transition: transform var(--duration-base) var(--easing-standard);
  }

  :global(html.js) .flipcard:not([data-fit-failed]) .flipcard__front {
    transform: rotateY(0);
  }

  :global(html.js) .flipcard:not([data-fit-failed]) .flipcard__back {
    transform: rotateY(180deg);
    visibility: hidden;
  }

  :global(html.js)
    .flipcard:not([data-fit-failed])[data-state='back']
    .flipcard__front {
    transform: rotateY(-180deg);
    visibility: hidden;
  }

  :global(html.js)
    .flipcard:not([data-fit-failed])[data-state='back']
    .flipcard__back {
    transform: rotateY(0);
    visibility: visible;
  }

  :global(html.js) .flipcard:not([data-fit-failed]) .flipcard__stage {
    border-radius: var(--flipcard-radius);
    box-shadow: var(--shadow-lg);
    overflow: visible;
    transform-style: preserve-3d;
    transform-origin: center;
    transform: scale(1);
    transition: transform var(--duration-base) var(--easing-standard);
  }

  :global(html.js) .flipcard:not([data-fit-failed]) .flipcard__face {
    box-shadow: none;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(html.js)
      .flipcard:not([data-fit-failed]):not(
        [data-size='small']
      )[data-state='front']:hover
      .flipcard__stage {
      transform: scale(1.16);
    }
  }

  /* Figma's small frame is exactly 87 × 130.5. */
  .flipcard[data-size='small'] {
    --flipcard-inline-size: 87px;
    --flipcard-block-size: 130.5px;
    --flipcard-radius: var(--radius-sm);

    transition: transform var(--duration-base) var(--easing-standard);
  }

  .flipcard[data-size='small'][data-state='front']:is(:hover, :focus-within) {
    z-index: 2;
    transform: scale(2.2989);
  }

  .flipcard[data-size='small'][data-state='front']:is(:hover, :focus-within)
    + .flipcard[data-size='small'][data-state='front'],
  .flipcard[data-size='small'][data-state='front']:has(
      + .flipcard[data-size='small'][data-state='front']:is(
          :hover,
          :focus-within
        )
    ) {
    z-index: 1;
    transform: scale(1.5162);
  }

  .flipcard__teaser {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .flipcard__teaser--title {
    display: grid;
    align-content: start;
    padding: var(--space-xs) var(--space-sm);
    background-color: var(--color-neutral-100);
  }

  :global(html.js) .flipcard[data-size='small'] .flipcard__front,
  :global(html.js) .flipcard[data-size='small'] .flipcard__teaser {
    min-block-size: 0;
    block-size: 100%;
  }

  .flipcard__back-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xs);
    min-block-size: 0;
    min-inline-size: 0;
    pointer-events: none;
  }

  .flipcard__back-content :global(a) {
    pointer-events: auto;
  }

  .flipcard__copy {
    display: grid;
    gap: var(--space-2xs);
  }

  .flipcard__flip {
    display: none;
  }

  :global(html.js) .flipcard:not([data-fit-failed]) .flipcard__flip {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    padding: 0;
    border: 0;
    background: transparent;
  }

  :global(html.js)
    .flipcard:not([data-fit-failed])
    .flipcard__flip:focus-visible {
    outline-offset: calc(-1 * var(--focus-ring-offset));
  }

  /* Typography/H5. */
  .flipcard__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-none);
    letter-spacing: var(--letter-spacing-normal);
  }

  /* Typography/Body - Small. */
  .flipcard__summary {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-relaxed);
    letter-spacing: var(--letter-spacing-normal);
  }

  .flipcard__summary :global(p) {
    max-width: none;
  }

  .flipcard__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    inline-size: 100%;
  }

  .flipcard__footer--link-only {
    justify-content: flex-end;
  }

  .flipcard__marks {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flipcard__marks a {
    display: inline-flex;
  }

  .flipcard__marks a:is(:hover, :focus-visible) :global(.icon) {
    filter: url(#md-lemon-alpha);
  }
</style>
