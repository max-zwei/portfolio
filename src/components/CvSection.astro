---
/**
 * Figma component set `CV section` (node `114:640`).
 *
 * The component mirrors one entry in the `resume` content collection. Its
 * summary remains slotted so markdown content stays owned by the calling page.
 */
import ProjectPreview from './ProjectPreview.astro';
import Icon from './Icon.astro';
import { formatRange } from '../lib/dates';
import { withBase } from '../config/site';

interface Props {
  /** Position or qualification title. */
  role: string;
  /** Employer, client, or institution. Omit to show no company line. */
  company?: string;
  /** Start date as `YYYY` or `YYYY-MM`. */
  start: string;
  /** End date as `YYYY` or `YYYY-MM`; absent means “present”. */
  end?: string;
  /** Public path of a certificate or reference letter; makes the role a link. */
  documentUrl?: string;
  /** What that document is, for assistive tech: e.g. `Reference letter (PDF)`. */
  documentLabel?: string;
  /** Optional heading level to match the styleguide examples. */
  level?: 2 | 3 | 4;
  /** Project destinations associated with this CV entry. */
  projectUrls?: ReadonlyArray<string>;
  /** Additional class names for the section wrapper. */
  class?: string;
}

const {
  role,
  company,
  start,
  end,
  documentUrl,
  documentLabel,
  level = 3,
  projectUrls = [],
  class: className,
} = Astro.props;

const HeadingTag = `h${level}` as 'h2' | 'h3' | 'h4';
/* Astro.slots.has() is true even when the page passes a falsy expression
   (e.g. `{entry.data.logo && <Image slot="logo" … />}`), so slots have to be
   rendered and checked for real content instead. */
const logoHtml = (await Astro.slots.render('logo')) ?? '';
const hasLogo = logoHtml.trim().length > 0;
const summaryHtml = (await Astro.slots.render('default')) ?? '';
const hasSummary = summaryHtml.trim().length > 0;

const slugify = (value: string) =>
  value
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const sectionId = `cv-${slugify(`${company ?? ''}-${role}-${start}`) || 'section'}`;

const titleFromUrl = (url: string, index: number) => {
  const path = url.split(/[?#]/)[0].replace(/\/+$/, '');
  const segment = path.split('/').filter(Boolean).at(-1);
  return segment ? segment.replace(/[-_]+/g, ' ') : `Project ${index + 1}`;
};
---

<section
  class:list={['cv-section', className]}
  aria-labelledby={`${sectionId}-role`}
>
  <div class="cv-section__rail">
    <div class="cv-section__logo">
      {
        hasLogo ? (
          <Fragment set:html={logoHtml} />
        ) : (
          <Icon icon="triangle" alt="" class="cv-section__mark" />
        )
      }
    </div>
  </div>

  <div class="cv-section__content">
    <div class="cv-section__header">
      <!-- Figma text style: Typography/Mono - Small. -->
      <p class="cv-section__dates">{formatRange(start, end)}</p>

      <div class="cv-section__position">
        <!-- Figma text style: Typography/Body - Bold. -->
        <HeadingTag id={`${sectionId}-role`} class="cv-section__role">
          {
            documentUrl ? (
              <a href={withBase(documentUrl)} class="cv-section__role-link">
                <span class="cv-section__role-ghost" aria-hidden="true">
                  {role}
                </span>
                <span class="cv-section__role-label">
                  {role}
                  {documentLabel && (
                    <span class="visually-hidden"> — {documentLabel}</span>
                  )}
                </span>
              </a>
            ) : (
              role
            )
          }
        </HeadingTag>
        <!-- Figma text style: Typography/Body. -->
        {company && <p class="cv-section__company">{company}</p>}
      </div>
    </div>

    {
      projectUrls.length > 0 && (
        <div class="cv-section__projects">
          {projectUrls.map((href, index) => (
            // The page decides the real project caption and title. This URL-only
            // interface supplies short, deterministic labels until it does.
            <ProjectPreview
              id={`${sectionId}-project-${index + 1}`}
              caption={`Project ${index + 1}`}
              title={titleFromUrl(href, index)}
              href={href}
            />
          ))}
        </div>
      )
    }

    {hasSummary && <div class="cv-section__summary" set:html={summaryHtml} />}
  </div>
</section>

<style>
  /* Figma 114:640: Logo slot 40 × 40, Content Container at x64. */
  .cv-section {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
  }

  /* Figma 377:1946: a 40 column, 8 of top padding, its items 16 apart and
     centred. It stretches to the entry's height so the line can fill it. */
  .cv-section__rail {
    display: flex;
    flex: 0 0 var(--space-lg);
    flex-direction: column;
    align-items: center;
    align-self: stretch;
    gap: var(--space-sm);
    padding-block-start: var(--space-2xs);
  }

  /* Figma 114:255: the slot is a 40 box that clips its content. */
  .cv-section__logo {
    display: grid;
    place-items: center;
    inline-size: 100%;
    block-size: var(--space-lg);
    overflow: clip;
  }

  .cv-section__logo :global(img) {
    inline-size: 100%;
    block-size: auto;
  }

  /* The default mark keeps its own drawn box inside the slot rather than
     filling it: Figma 476:1350 is 29.686, rounded to 30 as the NavBar marks
     are. Not a token — an asset's own size. */
  .cv-section__logo :global(.cv-section__mark) {
    inline-size: 30px;
    block-size: 30px;
  }

  /* Figma 476:513: a 1px line in neutral-200 filling the column under the
     logo, so it runs from 16 below the mark to the foot of the entry. No
     --border-width-* tier exists, so 1px is a literal, as it is in
     ProjectSection and ReleaseNote. */
  .cv-section__rail::after {
    content: '';
    flex: 1 1 auto;
    inline-size: 1px;
    min-block-size: 0;
    background-color: var(--cv-section-line-color, var(--color-neutral-200));
  }

  .cv-section__content {
    display: grid;
    /* Figma 114:640: 16 between Header, Media and Description. */
    row-gap: var(--space-sm);
    flex: 1 1 auto;
    min-inline-size: 0;
  }

  .cv-section__dates {
    /* Figma text style: Typography/Mono - Small. */
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-loose);
    letter-spacing: var(--letter-spacing-extra-wide);
    color: var(--color-neutral-600);
  }

  .cv-section__position {
    display: flex;
    /* Figma 114:260 draws one line; real entries run longer than the
       mockup's, so the row wraps rather than overflowing its container. */
    flex-wrap: wrap;
    align-items: center;
    /* Figma 114:260: Role x0, Company x201 across a 185 role — a 16 gap. */
    gap: var(--space-sm);
    color: var(--color-neutral-black);
  }

  /* Figma text style: Typography/Body - Bold. */
  .cv-section__role {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-normal);
    letter-spacing: var(--letter-spacing-normal);
  }

  /* Max's decision: the role links to its certificate or reference letter. The
     set has no link layer. Hover enlarges and bolds without moving anything —
     the ghost holds the box, the label is out of flow. */
  .cv-section__role-link {
    position: relative;
    display: inline-block;
    text-decoration: none;
  }

  .cv-section__role-ghost {
    visibility: hidden;
  }

  .cv-section__role-label {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center start;
    white-space: nowrap;
  }

  /*
   * The same call NavBar's wrapping row makes: below 48rem the column beside
   * the note rail does not exist, and a nowrap role ran off the right edge —
   * content lost rather than moved. Recorded in design/components.json.
   */
  @media (max-width: 48rem) {
    .cv-section__role-label {
      white-space: normal;
    }
  }

  .cv-section__role-link:hover .cv-section__role-label {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
  }

  /* Figma text style: Typography/Body. */
  .cv-section__company {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-normal);
    letter-spacing: var(--letter-spacing-normal);
  }

  .cv-section__summary {
    color: var(--color-neutral-800);
  }

  .cv-section__projects {
    display: flex;
    flex-wrap: wrap;
    /* Token-chosen while Figma is unreachable; not a value read from the set. */
    gap: var(--space-sm);
  }
  /*
   * Max's ask, not a Figma prototype: the default mark carries on turning in
   * the direction it is drawn — a further 16° as its entry crosses the
   * viewport. @keyframes on a view() timeline, so the motion ceiling holds.
   * Figma −16 is clockwise on screen, so CSS continues it with a positive
   * rotate.
   *
   * The reduced-motion guard is local, against the usual rule, because
   * global.css's blanket animation-duration override cannot stop a
   * progress-driven timeline — duration is not what advances it.
   */
  @keyframes cv-section-mark-turn {
    from {
      rotate: 0deg;
    }

    to {
      rotate: 16deg;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(.cv-section__mark) {
        animation: cv-section-mark-turn linear both;
        animation-timeline: view();
      }
    }
  }
</style>
