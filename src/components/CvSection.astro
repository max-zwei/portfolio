---
/**
 * Figma component set `CV` (node `477:2204`).
 *
 * The component mirrors one entry in the `resume` content collection. Its
 * summary remains slotted so markdown content stays owned by the calling page.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { formatRange } from '../lib/dates';
import { withBase } from '../config/site';

interface Props {
  /** Position or qualification title. */
  role: string;
  /** Employer, client, or institution. Omit to show no company line. */
  company?: string;
  /** Start date as `YYYY` or `YYYY-MM`. */
  start: string;
  /** End date as `YYYY` or `YYYY-MM`; absent means “present”. */
  end?: string;
  /** Public path of a certificate or reference letter; makes the role a link. */
  documentUrl?: string;
  /** What that document is, for assistive tech: e.g. `Reference letter (PDF)`. */
  documentLabel?: string;
  /** Figma `State`. */
  state?: 'default' | 'pdf';
  /** Zero-based position within the containing CV list. */
  index?: number;
  /** Optional heading level to match the styleguide examples. */
  level?: 2 | 3 | 4;
  /** Compact project compositions in the Default variant (`643:2846`). */
  projects?: ReadonlyArray<{
    href: string;
    title: string;
    image?: { src: ImageMetadata; alt: string };
    detailImage?: { src: ImageMetadata; alt: string };
    /** The four palette positions; an absent value leaves that slot unfilled. */
    colors?: readonly (string | undefined)[];
  }>;
  /** Additional class names for the section wrapper. */
  class?: string;
}

const {
  role,
  company,
  start,
  end,
  documentUrl,
  documentLabel,
  state = 'default',
  index = 0,
  level = 3,
  projects = [],
  class: className,
} = Astro.props;

const HeadingTag = `h${level}` as 'h2' | 'h3' | 'h4';
/* Astro.slots.has() is true even when the page passes a falsy expression
   (e.g. `{entry.data.logo && <Image slot="logo" … />}`), so slots have to be
   rendered and checked for real content instead. */
const logoHtml = (await Astro.slots.render('logo')) ?? '';
const hasLogo = logoHtml.trim().length > 0;
const summaryHtml = (await Astro.slots.render('default')) ?? '';
const hasSummary = summaryHtml.trim().length > 0;

const slugify = (value: string) =>
  value
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const sectionId = `cv-${slugify(`${company ?? ''}-${role}-${start}`) || 'section'}`;
---

<section
  class:list={['cv-section', `cv-section--${state}`, className]}
  aria-labelledby={`${sectionId}-role`}
  style={`--mark-turn: ${index * 16}deg`}
>
  <div class="cv-section__rail">
    <div class="cv-section__logo">
      {
        hasLogo ? (
          <Fragment set:html={logoHtml} />
        ) : (
          <Icon icon="triangle" color="herbs" alt="" class="cv-section__mark" />
        )
      }
    </div>
  </div>

  <div class="cv-section__content">
    <div class="cv-section__header">
      <!-- Figma text style: Typography/Mono - Small. -->
      <p class="cv-section__dates">{formatRange(start, end)}</p>

      <div class="cv-section__position">
        <!-- Figma text style: Typography/Body - Bold. -->
        <HeadingTag id={`${sectionId}-role`} class="cv-section__role">
          {
            documentUrl ? (
              <a href={withBase(documentUrl)} class="cv-section__role-link">
                <span class="cv-section__role-ghost" aria-hidden="true">
                  {role}
                </span>
                <span class="cv-section__role-label">
                  {role}
                  {documentLabel && (
                    <span class="visually-hidden"> — {documentLabel}</span>
                  )}
                </span>
              </a>
            ) : (
              role
            )
          }
        </HeadingTag>
        <!-- Figma text style: Typography/Body. -->
        {company && <p class="cv-section__company">{company}</p>}
      </div>
    </div>

    {
      state !== 'pdf' && projects.length > 0 && (
        <div class="cv-section__projects">
          {projects.map((project) => (
            <div class="cv-section__project">
              {(project.image ||
                project.detailImage ||
                project.colors?.some(Boolean)) && (
                <div class="cv-section__project-art">
                  {project.image && (
                    <Image
                      class="cv-section__project-image"
                      src={project.image.src}
                      alt={project.image.alt}
                    />
                  )}
                  {project.colors?.some(Boolean) && (
                    <div class="cv-section__project-colors" aria-hidden="true">
                      {project.colors.slice(0, 4).map((color, index) =>
                        color ? (
                          <span
                            style={{
                              backgroundColor: color,
                              gridRow: index + 1,
                            }}
                          />
                        ) : null,
                      )}
                    </div>
                  )}
                  {project.detailImage && (
                    <Image
                      class="cv-section__project-detail"
                      src={project.detailImage.src}
                      alt={project.detailImage.alt}
                    />
                  )}
                </div>
              )}
              <div class="cv-section__project-copy">
                <p class="cv-section__project-title">{project.title}</p>
                <Button type="secondary" href={project.href}>
                  Explore
                </Button>
              </div>
            </div>
          ))}
        </div>
      )
    }

    {hasSummary && <div class="cv-section__summary" set:html={summaryHtml} />}
  </div>
</section>

<style>
  /* Figma 114:640: Logo slot 40 × 40, Content Container at x64. */
  .cv-section {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
  }

  /* Figma 377:1946: a 40 column, 8 of top padding, its items 16 apart and
     centred. It stretches to the entry's height so the line can fill it. */
  .cv-section__rail {
    display: flex;
    flex: 0 0 var(--space-lg);
    flex-direction: column;
    align-items: center;
    align-self: stretch;
    gap: var(--space-sm);
    padding-block-start: var(--space-2xs);
    padding-block-end: var(--space-sm);
  }

  /* Figma 114:255: the slot is a 40 box that clips its content. */
  .cv-section__logo {
    display: grid;
    place-items: center;
    inline-size: 100%;
    block-size: var(--space-lg);
    overflow: clip;
  }

  .cv-section__logo :global(img) {
    inline-size: 100%;
    block-size: auto;
  }

  /* Figma 476:1350: the mark retains its unbound intrinsic geometry. */
  .cv-section__logo :global(.cv-section__mark) {
    inline-size: 29.686px;
    block-size: 29.686px;
    rotate: var(--mark-turn, 0deg);
  }

  /* Figma 476:513: a 1px line in neutral-200 filling the column under the
     logo, so it runs from 16 below the mark to the foot of the entry. No
     --border-width-* tier exists, so 1px is a literal, as in ReleaseNote. */
  .cv-section__rail::after {
    content: '';
    flex: 1 1 auto;
    inline-size: 1px;
    min-block-size: 0;
    background-color: var(--color-neutral-200);
  }

  .cv-section__content {
    display: grid;
    row-gap: var(--space-md);
    padding-block-end: var(--space-xl);
    flex: 1 1 auto;
    min-inline-size: 0;
    max-inline-size: 581px;
  }

  .cv-section__dates {
    /* Figma text style: Typography/Mono - Small. */
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-loose);
    letter-spacing: var(--letter-spacing-extra-wide);
    color: var(--color-neutral-600);
  }

  .cv-section__position {
    display: flex;
    /* Figma 114:260 draws one line; real entries run longer than the
       mockup's, so the row wraps rather than overflowing its container. */
    flex-wrap: wrap;
    align-items: center;
    /* Figma 114:260: Role x0, Company x201 across a 185 role — a 16 gap. */
    gap: var(--space-sm);
    color: var(--color-neutral-black);
  }

  /* Figma text style: Typography/Body - Bold. */
  .cv-section__role {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-normal);
    letter-spacing: var(--letter-spacing-normal);
  }

  /* Max's decision: the role links to its certificate or reference letter. The
     set has no link layer. Hover enlarges and bolds without moving anything —
     the ghost holds the box, the label is out of flow. */
  .cv-section__role-link {
    position: relative;
    display: inline-block;
    text-decoration: none;
  }

  .cv-section__role-ghost {
    visibility: hidden;
  }

  .cv-section__role-label {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center start;
    white-space: nowrap;
  }

  /*
   * The same call NavBar's wrapping row makes: below 48rem the column beside
   * the note rail does not exist, and a nowrap role ran off the right edge —
   * content lost rather than moved. Recorded in design/components.json.
   */

  .cv-section__role-link:hover .cv-section__role-label {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
  }

  /* Figma text style: Typography/Body. */
  .cv-section__company {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-normal);
    letter-spacing: var(--letter-spacing-normal);
  }

  .cv-section__summary {
    color: var(--color-neutral-800);
  }

  .cv-section__projects {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* Figma 643:2846: compact CV-only project composition. */
  .cv-section__project {
    display: flex;
    align-items: stretch;
    gap: var(--space-xs);
    max-inline-size: 100%;
  }

  .cv-section__project-art {
    display: flex;
    gap: var(--space-2xs);
    block-size: 99px;
    flex: 0 0 auto;
  }

  .cv-section__project-art :global(img) {
    flex: 0 0 auto;
    block-size: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .cv-section__project-art :global(.cv-section__project-image) {
    inline-size: 99px;
  }

  .cv-section__project-art :global(.cv-section__project-detail) {
    inline-size: 44px;
  }

  .cv-section__project-colors {
    display: grid;
    inline-size: 44px;
    flex: 0 0 auto;
    grid-template-rows: repeat(4, 1fr);
    overflow: clip;
    border-radius: var(--radius-md);
  }

  .cv-section__project-copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    inline-size: 132px;
    min-inline-size: 0;
  }

  .cv-section__project-title {
    font-family: var(--font-serif);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-relaxed);
    color: var(--color-neutral-800);
  }

  /* Figma 477:2203: compact rail and single-row PDF header. */
  .cv-section--pdf .cv-section__rail {
    gap: var(--space-xs);
    padding-block: 0;
  }

  /* Figma 477:2177: the PDF variant centres the exported 30px mark in a
     40 × 26 slot. The approved 26px literal is CV-only component geometry. */
  .cv-section--pdf .cv-section__logo {
    block-size: 26px;
  }

  .cv-section--pdf .cv-section__content {
    row-gap: var(--space-3xs);
    padding-block-end: 0;
    max-inline-size: none;
  }

  .cv-section--pdf .cv-section__header {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  /* Figma 477:2182 hugs (textAutoResize WIDTH_AND_HEIGHT); its 140 is the
     measured width of one date, not a column. */
  .cv-section--pdf .cv-section__dates {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .cv-section--pdf .cv-section__position {
    flex: 1 1 auto;
    min-inline-size: 0;
    gap: var(--space-2xs);
  }

  .cv-section--pdf .cv-section__role,
  .cv-section--pdf .cv-section__company {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  .cv-section--pdf .cv-section__role {
    font-weight: var(--font-weight-bold);
  }

  /* Figma text style: Typography/Body - Small. */
  .cv-section--pdf .cv-section__summary {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  @media (max-width: 48rem) {
    .cv-section__role-label {
      white-space: normal;
    }

    .cv-section__project {
      flex-wrap: wrap;
    }

    .cv-section--pdf .cv-section__header {
      display: grid;
      min-inline-size: 0;
      align-items: start;
      gap: var(--space-xs);
    }

    .cv-section--pdf .cv-section__position {
      overflow-wrap: anywhere;
    }
  }
  /* Figma 477:2191: PDF copy uses the full content column rather than the
     global paragraph measure. */
  .cv-section--pdf .cv-section__summary :global(p) {
    max-width: none;
  }
</style>
