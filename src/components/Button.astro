---
import type { HTMLAttributes } from 'astro/types';

/**
 * Figma component set `Buttons` (`109:1382`).
 *
 * The sparse Type × Variant × State × Icon × Orientation matrix is the contract.
 * Hover specimens can be rendered explicitly; interactive elements also apply
 * that state on hover and keyboard focus.
 * The default slot is Figma's shared Button Text content property. Secondary
 * arrows and nav hashes are decorative children, not part of that label.
 */
/*
 * Extends the anchor attributes so the `...rest` passthrough is typed rather
 * than merely tolerated: `download` on the two PDF links is the reason. `type`
 * is omitted from the base because the Figma axis owns that name — the
 * rendered `<button>` always gets `type="button"` from this file.
 */
interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  /** Figma `Type`. */
  type?: 'primary' | 'secondary' | 'nav' | 'inline';
  /** Figma `Variant`. Only `nav` uses it; the matrix is sparse, as in Figma. */
  variant?: 'default' | 'primary' | 'secondary';
  /** Figma `State`. */
  state?: 'default' | 'hover';
  /** Figma `Orientation`. Default preserves the secondary's right arrow. */
  orientation?: 'default' | 'right' | 'left';
  /**
   * Figma `Icon`. `on` draws the icon slot alone — the default slot stays the
   * accessible name and is rendered visually hidden. Only Type=Primary has the
   * variant in Figma.
   */
  icon?: 'off' | 'on';
  /** Present → renders `<a>`. Absent → renders `<button type="button">`. */
  href?: string;
  /** Additional classes applied to the root element. */
  class?: string;
}

const {
  type = 'primary',
  variant = 'default',
  state = 'default',
  icon = 'off',
  orientation = 'default',
  href,
  class: className,
  ...rest
} = Astro.props;

const variantClass = variant === 'default' ? undefined : `btn--v-${variant}`;
const iconClass = icon === 'on' ? 'btn--icon' : undefined;
const classes = [
  'btn',
  `btn--${type}`,
  variantClass,
  state === 'hover' && 'btn--hover',
  type === 'secondary' && orientation === 'left' && 'btn--left',
  iconClass,
  className,
];
const label = await Astro.slots.render('default');
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      {icon === 'on' ? (
        <>
          <span class="btn__icon">
            <slot name="icon" />
          </span>
          <span class="visually-hidden" set:html={label} />
        </>
      ) : (
        <>
          <span class="btn__ghost" aria-hidden="true">
            {type === 'nav' && <span>#</span>}
            <span set:html={label} />
            {type === 'secondary' && <span>→</span>}
          </span>
          <span class="btn__label">
            {type === 'nav' && <span aria-hidden="true">#</span>}
            <span set:html={label} />
            {type === 'secondary' && (
              <span class="btn__arrow" aria-hidden="true">
                →
              </span>
            )}
          </span>
        </>
      )}
    </a>
  ) : (
    <button type="button" class:list={classes} {...rest}>
      {icon === 'on' ? (
        <>
          <span class="btn__icon">
            <slot name="icon" />
          </span>
          <span class="visually-hidden" set:html={label} />
        </>
      ) : (
        <>
          <span class="btn__ghost" aria-hidden="true">
            {type === 'nav' && <span>#</span>}
            <span set:html={label} />
            {type === 'secondary' && <span>→</span>}
          </span>
          <span class="btn__label">
            {type === 'nav' && <span aria-hidden="true">#</span>}
            <span set:html={label} />
            {type === 'secondary' && (
              <span class="btn__arrow" aria-hidden="true">
                →
              </span>
            )}
          </span>
        </>
      )}
    </button>
  )
}

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    background: none;
    border: 0;
    padding: 0;
  }

  .btn__ghost,
  .btn__label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
  }

  /* Sizes the box at the rest state, so the hover enlargement below cannot
     reflow anything around the button. */
  .btn__ghost {
    visibility: hidden;
  }

  .btn__label {
    position: absolute;
    inset: 0;
  }

  .btn__label > span {
    flex-shrink: 0;
  }

  /* Figma text style: Typography/Mono - Small. Effect: Elevation / sm. */
  .btn--primary {
    padding: var(--space-xs) var(--space-lg);
    background-color: var(--color-lemon-500);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    color: var(--color-neutral-800);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-loose);
    letter-spacing: var(--letter-spacing-extra-wide);
  }

  /* Hover swaps to Elevation / lg. */
  .btn--primary:is(:hover, :focus-visible, .btn--hover) {
    box-shadow: var(--shadow-lg);
  }

  /*
   * Figma 377:2215 `Icon=ON`: 16 / 12 padding around a 28 icon, so 60 × 52.
   * The current hover variant keeps that geometry and changes only the shadow.
   */
  .btn--primary.btn--icon {
    padding: var(--space-xs) var(--space-sm);
    gap: var(--space-xs);
  }

  .btn__icon {
    display: grid;
    place-items: center;
    inline-size: 28px;
    block-size: 28px;
  }

  /* Figma text style: Typography/Body - Small. */
  .btn--secondary {
    color: var(--color-pickled-500);
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-relaxed);
    letter-spacing: var(--letter-spacing-normal);
  }

  .btn--secondary :is(.btn__ghost, .btn__label) {
    gap: var(--space-3xs);
  }

  .btn--secondary:is(:hover, :focus-visible, .btn--hover) .btn__label {
    gap: var(--space-2xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-wide);
  }

  /* Figma Left 676:5490 and 676:5493 both keep ← before the label. */
  .btn--secondary.btn--left .btn__arrow {
    order: -1;
    transform: scaleX(-1);
  }

  /* Figma 109:1378: unbound mono / 16 / regular / 1.6 / wide tracking. */
  .btn--nav {
    font-family: var(--font-mono);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-normal);
    letter-spacing: var(--letter-spacing-wide);
  }

  .btn--nav.btn--v-primary {
    color: var(--color-neutral-black);
  }

  .btn--nav.btn--v-secondary {
    color: var(--color-neutral-600);
  }

  .btn--nav:is(:hover, :focus-visible, .btn--hover) .btn__label {
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-extra-wide);
  }

  /* Figma 109:1379 and 251:2553: unbound Erode Semibold / 16 / 1.4. */
  .btn--inline {
    color: var(--color-tomato-500);
    font-family: var(--font-serif);
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    letter-spacing: var(--letter-spacing-normal);
    text-decoration: underline;
    text-decoration-style: solid;
    text-underline-position: from-font;
  }

  .btn--inline:is(:hover, :focus-visible, .btn--hover) {
    color: var(--color-tomato-600);
  }

  .btn--inline:is(:hover, :focus-visible, .btn--hover) .btn__label {
    letter-spacing: var(--letter-spacing-extra-wide);
  }
</style>
