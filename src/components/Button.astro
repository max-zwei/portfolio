---
import type { HTMLAttributes } from 'astro/types';

/**
 * Figma component set `Buttons` (`109:1382`).
 *
 * Figma: Primary/Default, Secondary/Default, Nav/Primary, Nav/Secondary and
 * Inline/Primary. Type classes select the style branch; the separately
 * namespaced Variant axis only sub-selects the two nav colours. Inline/Primary
 * therefore records `btn--v-primary` even though no rule consumes it: that is
 * fidelity to Figma's sparse matrix, not dead code. Figma's `State` axis is
 * CSS `:hover`, not a component prop.
 */
/*
 * Extends the anchor attributes so the `...rest` passthrough is typed rather
 * than merely tolerated: `download` on the two PDF links is the reason. `type`
 * is omitted from the base because the Figma axis owns that name — the
 * rendered `<button>` always gets `type="button"` from this file.
 */
interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  /** Figma `Type`. */
  type?: 'primary' | 'secondary' | 'nav' | 'inline';
  /** Figma `Variant`. Only `nav` uses it; the matrix is sparse, as in Figma. */
  variant?: 'default' | 'primary' | 'secondary';
  /**
   * Figma `Icon`. `on` draws the icon slot alone — the default slot stays the
   * accessible name and is rendered visually hidden. Only Type=Primary has the
   * variant in Figma.
   */
  icon?: 'off' | 'on';
  /** Present → renders `<a>`. Absent → renders `<button type="button">`. */
  href?: string;
  /** Additional classes applied to the root element. */
  class?: string;
}

const {
  type = 'primary',
  variant = 'default',
  icon = 'off',
  href,
  class: className,
  ...rest
} = Astro.props;

const variantClass = variant === 'default' ? undefined : `btn--v-${variant}`;
const iconClass = icon === 'on' ? 'btn--icon' : undefined;
const classes = ['btn', `btn--${type}`, variantClass, iconClass, className];
const label = await Astro.slots.render('default');
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      {icon === 'on' ? (
        <>
          <span class="btn__icon">
            <slot name="icon" />
          </span>
          <span class="visually-hidden" set:html={label} />
        </>
      ) : (
        <>
          <span class="btn__ghost" aria-hidden="true" set:html={label} />
          <span class="btn__label" set:html={label} />
        </>
      )}
    </a>
  ) : (
    <button type="button" class:list={classes} {...rest}>
      {icon === 'on' ? (
        <>
          <span class="btn__icon">
            <slot name="icon" />
          </span>
          <span class="visually-hidden" set:html={label} />
        </>
      ) : (
        <>
          <span class="btn__ghost" aria-hidden="true" set:html={label} />
          <span class="btn__label" set:html={label} />
        </>
      )}
    </button>
  )
}

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    background: none;
    border: 0;
    padding: 0;
  }

  /* Sizes the box at the rest state, so the hover enlargement below cannot
     reflow anything around the button. */
  .btn__ghost {
    visibility: hidden;
  }

  .btn__label {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    white-space: nowrap;
  }

  /* Figma text style: Typography/Mono - Small. Effect: Elevation / md. */
  .btn--primary {
    padding: var(--space-xs) var(--space-lg);
    background-color: var(--color-lemon-500);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    color: var(--color-neutral-800);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-loose);
    letter-spacing: var(--letter-spacing-extra-wide);
    transition: box-shadow var(--duration-fast) var(--easing-standard);
  }

  /* Hover swaps to Typography/Mono and Elevation / lg. */
  .btn--primary:hover {
    box-shadow: var(--shadow-lg);
  }

  /*
   * Figma 377:2215 `Icon=ON`: 16 / 12 padding around a 28 icon, so 60 × 52.
   * Hover draws 64 × 56 by growing the icon to 32; as with .btn__ghost the box
   * stays at its rest size and the icon scales instead, so hovering one button
   * in a stack cannot move the next.
   */
  .btn--primary.btn--icon {
    padding: var(--space-xs) var(--space-sm);
    gap: var(--space-xs);
  }

  .btn__icon {
    display: grid;
    place-items: center;
    inline-size: 28px;
    block-size: 28px;
    transition: transform var(--duration-fast) var(--easing-standard);
  }

  .btn--icon:hover .btn__icon {
    /* 32 / 28 — the icon size Figma draws for State=Hover. */
    transform: scale(1.1429);
  }

  .btn--primary:hover .btn__label {
    font-size: var(--font-size-base);
  }

  /* Figma text style: Typography/Body - Small. */
  .btn--secondary {
    color: var(--color-pickled-500);
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    letter-spacing: var(--letter-spacing-normal);
  }

  .btn--secondary:hover .btn__label {
    font-size: var(--font-size-base);
    line-height: var(--line-height-normal);
  }

  /* Figma 109:1378: unbound mono / 16 / regular / 1.6 / wide tracking. */
  .btn--nav {
    font-family: var(--font-mono);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-normal);
    letter-spacing: var(--letter-spacing-wide);
  }

  .btn--nav.btn--v-primary {
    color: var(--color-neutral-black);
  }

  .btn--nav.btn--v-secondary {
    color: var(--color-neutral-600);
  }

  .btn--nav:hover .btn__label {
    font-weight: var(--font-weight-bold);
  }

  /* The Step 3 plan specifies these serif/semibold Inline declarations
     without naming a Figma text style. */
  .btn--inline {
    color: var(--color-tomato-500);
    font-family: var(--font-serif);
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    letter-spacing: var(--letter-spacing-normal);
    text-decoration: underline;
    text-decoration-style: solid;
    text-underline-position: from-font;
    transition: color var(--duration-fast) var(--easing-standard);
  }

  .btn--inline:hover {
    color: var(--color-tomato-600);
  }
</style>
