---
/**
 * Named content composition around the library's Text section (`114:636`).
 *
 * The heading is retained editorial copy; TextSection owns the current
 * library layout and typography.
 */
import TextSection from './TextSection.astro';

interface Props {
  /** Section heading; defaults to the final heading drawn in Figma. */
  title?: string;
  /** Optional heading level to match the styleguide examples. */
  level?: 1 | 2 | 3 | 4;
  /** Additional class forwarded to the root section. */
  class?: string;
}

const { title = 'Let’s be honest', level = 2, class: className } = Astro.props;
---

<TextSection title={title} level={level} class={className}><slot /></TextSection
>
