---
/**
 * Figma component set `project sections` (`115:755`).
 *
 * One instance represents one movement of a case study, matching the shared
 * `caseSection` content schema rather than wrapping the whole case study.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** Figma `State`. */
  state?: 'active' | 'inactive';
  /** The case-study movement's heading. */
  title: string;
  /** Optional line beside the title, matching `caseSection.subtitle`. */
  subtitle?: string;
  /** Ordered visual artefacts for this movement. */
  artefacts?: ReadonlyArray<{ src: ImageMetadata; alt: string }>;
  /** Scannable takeaways from this movement. */
  keyPoints?: ReadonlyArray<string>;
  /** Optional heading level to match the styleguide examples. */
  level?: 2 | 3 | 4;
  class?: string;
}

const {
  state = 'active',
  title,
  subtitle,
  artefacts = [],
  keyPoints = [],
  level = 2,
  class: className,
} = Astro.props;

const HeadingTag = `h${level}` as 'h2' | 'h3' | 'h4';
---

<section
  class:list={['project-section', `project-section--${state}`, className]}
>
  <div class="project-section__rail" aria-hidden="true">
    <span class="project-section__marker"></span>
    <span class="project-section__line"></span>
  </div>

  <div class="project-section__main">
    <header class="project-section__header">
      <div class="project-section__heading">
        <HeadingTag class="project-section__title">{title}</HeadingTag>
        {subtitle && <p class="project-section__subtitle">{subtitle}</p>}
      </div>

      {
        keyPoints.length > 0 && (
          <ul class="project-section__key-points">
            {keyPoints.map((keyPoint) => (
              <li>{keyPoint}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="project-section__copy">
      <slot />
    </div>

    {
      artefacts.length > 0 && (
        <div
          class="project-section__artefacts"
          data-artefact-strip
          role="group"
          aria-label={`${title} — artefacts`}
          tabindex="0"
        >
          {artefacts.map((artefact) => (
            <figure class="project-section__artefact">
              <Image src={artefact.src} alt={artefact.alt} />
            </figure>
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  import '../lib/artefact-strip';
</script>

<style>
  .project-section {
    display: grid;
    grid-template-columns: var(--space-sm) minmax(0, 1fr);
    gap: var(--space-md);
    color: var(--color-neutral-800);
    transition: color var(--duration-slow) var(--easing-standard);
  }

  .project-section__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: stretch;
    gap: var(--space-lg);
    padding-block-start: var(--space-sm);
  }

  .project-section__marker {
    flex: 0 0 auto;
    inline-size: var(--space-sm);
    block-size: var(--space-sm);
    rotate: -12deg;
    background-color: var(--color-tomato-300);
    transition:
      rotate var(--duration-slow) var(--easing-standard),
      background-color var(--duration-slow) var(--easing-standard);
  }

  .project-section__line {
    flex: 1 0 var(--space-sm);
    inline-size: 1px;
    border-radius: var(--radius-full);
    background-color: var(--color-pickled-200);
    transition: background-color var(--duration-slow) var(--easing-standard);
  }

  .project-section__main {
    display: grid;
    inline-size: 100%;
    row-gap: var(--space-md);
    min-inline-size: 0;
  }

  .project-section__header {
    display: grid;
    grid-template-columns: minmax(0, 489fr) minmax(0, 421fr);
    gap: var(--space-md);
    align-items: start;
    inline-size: min(100%, 934px);
  }

  .project-section__heading {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }

  /* Typography/H1 on an h2. Only the size differs from global.css. */
  .project-section__title {
    color: var(--color-neutral-black);
    letter-spacing: var(--letter-spacing-normal);
    font-size: var(--font-size-3xl);
    transition: color var(--duration-slow) var(--easing-standard);
  }

  /* Typography/Body - Large. */
  .project-section__subtitle {
    font-family: var(--font-sans);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-normal);
    letter-spacing: var(--letter-spacing-normal);
  }

  /* Typography/Body — description markdown arrives through the default slot. */
  .project-section__copy,
  .project-section__key-points {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-normal);
    letter-spacing: var(--letter-spacing-normal);
  }

  .project-section__copy {
    inline-size: min(100%, 934px);
  }

  .project-section__copy :global(p) {
    max-width: none;
  }

  .project-section__artefacts {
    display: flex;
    gap: var(--space-sm);
    min-inline-size: 0;
    margin-block-start: var(--space-lg);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .project-section__artefacts::-webkit-scrollbar {
    display: none;
  }

  .project-section__artefact {
    /* Fixed slide geometry transcribed from both Figma states. */
    flex: 0 0 320px;
    inline-size: 320px;
    block-size: 180px;
    margin: 0;
    overflow: hidden;
    background-color: var(--color-neutral-800);
    transition: background-color var(--duration-slow) var(--easing-standard);
  }

  .project-section__artefact :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  .project-section__key-points {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    margin: 0;
    padding: var(--space-xs) 0 0;
    list-style: none;
  }

  .project-section__key-points li {
    display: grid;
    grid-template-columns: var(--space-xs) minmax(0, 1fr);
    gap: var(--space-xs);
    align-items: start;
  }

  .project-section__key-points li::before {
    inline-size: var(--space-xs);
    block-size: var(--space-xs);
    margin-block-start: var(--space-2xs);
    border-radius: var(--radius-full);
    background-color: var(--color-tomato-500);
    content: '';
  }

  .project-section--inactive {
    color: var(--color-neutral-600);
  }
  .project-section--inactive .project-section__title {
    color: var(--color-neutral-600);
  }

  .project-section--inactive .project-section__marker {
    rotate: 12deg;
    background-color: var(--color-tomato-200);
  }

  .project-section--inactive .project-section__line {
    background-color: var(--color-pickled-100);
  }

  .project-section--inactive .project-section__artefact {
    background-color: var(--color-neutral-600);
  }

  .project-section--inactive .project-section__key-points {
    padding-block-start: 0;
  }
</style>
